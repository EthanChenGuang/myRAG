# Training image for the embedding fine-tune (06.1-12, D-16). Build from the repository root:
#   docker build -f eval/finetune/Dockerfile.train -t rag-finetune-train .
# Run on a GPU host with a kit (train and dev only) mounted read-only and an output directory:
#   docker run --rm --gpus all -v "$PWD/kit:/kit:ro" -v "$PWD/model:/out" rag-finetune-train train --kit /kit --out /out
# The image runs as uid 10001: the output directory must be writable by it (for example chown 10001 model/).
# The base model is downloaded from the Hugging Face hub at the revision pinned in the kit (mount a cache at /opt/hf to
# reuse it). Only eval/src, eval/config, rag-sidecar/src and rag-sidecar/config are copied: no bundle, kit or model
# ever enters the image.
# Base: NVIDIA CUDA 13.2 runtime (torch 2.15.0 from PyPI is the CUDA 13 build), pinned by tag and digest.
FROM nvidia/cuda:13.2.1-runtime-ubuntu24.04@sha256:4c17c2e7474ca1d470428b25e87e95756f51e7da3b663859894a03bc5a7ebdae

COPY --from=ghcr.io/astral-sh/uv:0.11.32 /uv /uvx /bin/

ENV DEBIAN_FRONTEND=noninteractive \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/rag-sidecar/src:/app/eval/src \
    PATH="/app/.venv/bin:$PATH" \
    HF_HOME=/opt/hf

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates python3.12 python3.12-venv \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY eval/finetune/requirements-train.lock /app/requirements-train.lock

RUN --mount=type=cache,target=/root/.cache/uv \
    uv venv --python /usr/bin/python3.12 /app/.venv \
    && uv pip install --python /app/.venv/bin/python --require-hashes --no-deps -r /app/requirements-train.lock

COPY rag-sidecar/pyproject.toml /app/rag-sidecar/pyproject.toml
COPY rag-sidecar/src /app/rag-sidecar/src
COPY rag-sidecar/config /app/rag-sidecar/config
COPY eval/pyproject.toml /app/eval/pyproject.toml
COPY eval/src /app/eval/src
COPY eval/config /app/eval/config

RUN python -c "import rag_eval.finetune.train as t; missing = t.check_signatures(); assert not missing, missing" \
    && useradd --system --uid 10001 --no-create-home --shell /usr/sbin/nologin trainer \
    && mkdir -p "$HF_HOME" \
    && chown -R trainer "$HF_HOME"

USER 10001

ENTRYPOINT ["python", "-m", "rag_eval.finetune"]
