+    chinese_invalid = [
+        "91000000MA0000000X",
+        "91000000MA0000001T",
+        "51000000MA1234567K",
+        "91000000IA0000000N",
+        "9100000069ABCDEFG1",
+    ]
+    european = ["IT99999999990", "DE100142542", "FR00000000093", "ATU10000005", "NL100000009B01", "BE0000000097"]
+    european_invalid = ["IT99999999991", "DE100142543", "FR00000000094", "ATU10000006", "NL100000008B01", "XX12345678"]
+    return [
