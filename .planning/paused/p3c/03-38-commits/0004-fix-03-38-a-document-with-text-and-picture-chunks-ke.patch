From fea61484734ac2c26974aebad968ee789ca013da Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 24 Nov 2026 09:32:53 +0000
Subject: [PATCH 4/6] fix(03-38): a document with text and picture chunks keeps
 the picture as its source image

- filterCandidates took image_url only from the first kept chunk of a document, so a PDF whose text chunk ranked first never streamed its figure as source_images
- the first picture chunk kept, in rank order, now gives the used document its image; documents without picture chunks are unchanged

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01X342shLsAZx6PYph2vA7hc
---
 src/lib/rag/context/assemble.ts | 10 +++++++---
 1 file changed, 7 insertions(+), 3 deletions(-)

diff --git a/src/lib/rag/context/assemble.ts b/src/lib/rag/context/assemble.ts
index 2c19da2..70caa7b 100644
--- a/src/lib/rag/context/assemble.ts
+++ b/src/lib/rag/context/assemble.ts
@@ -118,9 +118,13 @@ export function filterCandidates<C extends AssemblyCandidate>(input: AssembleInp
             external_url: docMetadata.metadata?.external_url,
           });
           docKeptBy.set(chunk.document_id, keptBy);
-        } else if (!existingDoc.similarity || chunk.similarity > existingDoc.similarity) {
-          existingDoc.similarity = chunk.similarity;
-          existingDoc.matched_chunk = chunk.content.substring(0, 150) + '...';
+        } else {
+          // A document with text and picture chunks (a PDF with figures) is one used document: the first picture chunk kept, in rank order, gives it the image.
+          if (!existingDoc.image_url && metadata?.image_url) existingDoc.image_url = metadata.image_url;
+          if (!existingDoc.similarity || chunk.similarity > existingDoc.similarity) {
+            existingDoc.similarity = chunk.similarity;
+            existingDoc.matched_chunk = chunk.content.substring(0, 150) + '...';
+          }
         }
       }
     }
