+
+function installParser(result: ParseResult, artifacts: ParseArtifact[]): void {
+  const docling: DocumentParser = {
+    name: 'docling',
+    unavailableReason: () => null,
+    async parse() {
+      return { kind: 'done', result, artifacts, warnings: [] };
