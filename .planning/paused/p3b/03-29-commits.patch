index ac53b50..fb04e1a 100644
--- a/rag-sidecar/tests/test_invoice_extract.py
+++ b/rag-sidecar/tests/test_invoice_extract.py
@@ -281,18 +281,16 @@ def test_merged_italian_lines_still_yield_every_field():
