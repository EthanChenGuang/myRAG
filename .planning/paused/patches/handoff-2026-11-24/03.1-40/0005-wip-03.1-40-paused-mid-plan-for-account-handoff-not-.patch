+def _capture(fn: Any, *args: Any) -> Any:
+    """Returns the exception instead of raising it: the pool wraps what a task raises, and the class decides the job outcome."""
+    try:
+        return ("ok", fn(*args))
+    except Exception as error:  # noqa: BLE001 - re-raised unchanged by _cpu
+        return ("err", error)
+
+
+async def _cpu(run: _Run, fn: Any, *args: Any, deadline_ms: int | None = None) -> Any:
+    pool = run.deps.pool
+    if pool is None:
+        kind, value = await asyncio.to_thread(_capture, fn, *args)
+    else:
+        seconds = (deadline_ms if deadline_ms is not None else run.cfg.timeouts.parse_slice_ms) / 1000
+        kind, value = await pool.submit(_capture, (fn, *args), priority=run.job.priority, deadline_s=seconds)
+    if kind == "err":
+        raise value
+    return value
+
+
+def _ms(run: _Run, since: float) -> int:
+    return max(0, int((run.deps.clock() - since) * 1000))
+
+
+async def _unavailable(run: _Run) -> _Stop:
+    return _Stop(await _fail(run.deps, run.job, "tiered_unavailable", retryable=False))
+
