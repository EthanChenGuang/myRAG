+async def _cached_document(run: _Run, parser: str, version: str, options: str) -> tuple[DoclingDocument, ParseCacheEntry] | None:
+    """The cached range document of this job's tenant and file, or None. A row outside the tenant prefix or without its object is a miss."""
+    entries = await run.deps.ledger.cache_lookup(run.job.id, parser, version, options)
+    for entry in entries:
+        if not _prefix_ok(run, entry.object_prefix):
+            logger.warning("[RAG Ingest] cache entry outside the tenant prefix ignored", extra={"job_id": run.job.id})
+            continue
+        try:
+            data = await run.deps.storage.get_bytes(run.bucket, f"{entry.object_prefix}{DOCLING_JSON}")
+        except StorageError:
+            continue
+        return await _cpu(run, _document_from_bytes, data), entry
+    return None
