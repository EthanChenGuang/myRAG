+def _shift_provenance(node: object, offset: int) -> None:
+    if isinstance(node, dict):
+        if "page_no" in node and "bbox" in node:
+            node["page_no"] = int(node["page_no"]) + offset
+        for value in node.values():
+            _shift_provenance(value, offset)
+    elif isinstance(node, list):
+        for value in node:
+            _shift_provenance(value, offset)
+
+
+def shift_pages(doc: DoclingDocument, offset: int) -> DoclingDocument:
+    """Returns a copy whose pages and item provenance are numbered ``offset`` higher; the structure and refs are unchanged."""
+    if offset == 0:
+        return doc
+    payload = doc.export_to_dict()
+    pages = payload.get("pages", {})
+    payload["pages"] = {
+        str(int(key) + offset): {**value, "page_no": int(value["page_no"]) + offset} for key, value in pages.items()
+    }
+    for key, value in payload.items():
+        if key != "pages":
+            _shift_provenance(value, offset)
+    return DoclingDocument.model_validate(payload)
+
