+async def _put_entry(
+    run: _Run,
+    parser: str,
+    version: str,
+    options: str,
+    objects: dict[str, bytes],
+    meta: dict[str, Any],
+) -> ParseCacheEntry:
+    """Writes the objects under the SQL-derived prefix of (job, parser, version, options), then the cache row."""
+    job, deps = run.job, run.deps
+    prefix = await deps.ledger.cache_prefix(job.id, parser, version, options)
+    if not prefix or not _prefix_ok(run, prefix):
+        raise _Stop(await _fail(deps, job, "ledger_error", retryable=True))
+    deps.storage.register_cache_prefix(prefix)
+    try:
+        for name, data in objects.items():
+            await deps.storage.put(run.bucket, prefix, name, data)
+    except (StorageError, StoragePathError) as error:
+        raise _Stop(await _fail(deps, job, "storage_error", retryable=True)) from error
+    return await deps.ledger.cache_put(
+        job.id,
+        parser,
+        version,
+        options,
+        prefix,
+        result=meta,
+        byte_size=sum(len(data) for data in objects.values()),
+    )
