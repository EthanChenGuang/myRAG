+
+
+async def _persist_preflight(run: _Run, result: PreflightResult) -> str:
+    """Stores the full probe result next to the parse cache; the job row keeps the object path."""
+    options = options_hash({"preset": "preflight", "input_format": run.job.mime_type or "application/pdf"})
+    payload = result.model_dump_json().encode("utf-8")
+    entry = await _put_entry(
+        run, "preflight", result.probe_version, options, {PREFLIGHT_JSON: payload}, {"page_count": result.page_count}
+    )
+    return f"{entry.object_prefix}{PREFLIGHT_JSON}"
+
+
+async def _preflight(run: _Run) -> tuple[PreflightResult, Reusable]:
+    loaded = await _load_preflight(run)
+    if loaded is not None:
+        return loaded, {}
+    path = await _original(run)
+    started = run.deps.clock()
+    preflight = run.deps.preflight_fn or _default_preflight
+    call = functools.partial(preflight, file_sha=run.job.file_sha256)
+    try:
+        output = await _cpu(
+            run, call, path, run.job.settings, run.cfg, run.deps.converter, deadline_ms=run.cfg.timeouts.preflight_ms
+        )
+    except Exception as error:  # noqa: BLE001
+        if type(error).__name__ == "EncryptedPdf":
+            raise _Stop(await _fail(run.deps, run.job, "encrypted_pdf", retryable=False)) from error
+        raise
+    result: PreflightResult = output.result
+    if result.page_count > run.deps.page_cap:
+        raise _Stop(await _fail(run.deps, run.job, "page_cap", retryable=False))
+    ref = await _persist_preflight(run, result)
+    await run.deps.ledger.advance(
+        run.job.id,
+        run.deps.worker_id,
+        stage="preflight",
+        status="preflight",
+        timing_ms=_ms(run, started),
+        fields={"preflight_ref": ref, "pages": result.page_count},
+    )
+    return result, dict(output.reusable_fast)
+
+
+# --- docling ranges -------------------------------------------------------------------------------------------------
+
+
+def _convert_slice(converter: Any, path: Path, sha: str, preset: str, start: int, end: int, priority: int) -> DoclingDocument:
+    document, _meta = converter.convert(path, sha, preset, start, end, priority)
+    return document
+
+
+def _segments(rng: PageRange, reusable: Reusable) -> list[Any]:
+    """Splits a fast range into L2 conversions that are already done and the gaps that still need converting (A-3)."""
+    if rng.preset != "fast":
+        return [("convert", rng.start, rng.end)]
+    inside = sorted(key for key in reusable if rng.start <= key[0] and key[1] <= rng.end)
+    segments: list[Any] = []
+    cursor = rng.start
+    for start, end in inside:
+        if start < cursor:
+            continue
+        if start > cursor:
+            segments.append(("convert", cursor, start - 1))
+        segments.append(("have", reusable[(start, end)][0]))
+        cursor = end + 1
+    if cursor <= rng.end:
+        segments.append(("convert", cursor, rng.end))
+    return segments
+
+
+async def _convert_range(run: _Run, rng: PageRange, reusable: Reusable) -> DoclingDocument:
+    path = await _original(run)
+    sha = run.job.file_sha256 or ""
+    parts: list[DoclingDocument] = []
+    for segment in _segments(rng, reusable):
+        if segment[0] == "have":
+            parts.append(segment[1])
+            continue
+        _kind, start, end = segment
+        for sub_start, sub_end in _slice_subranges(start, end, run.cfg.ranges.max_pages_per_conversion, run.job.priority):
+            if run.deps.clock() - run.started > run.deps.document_timeout_s:
+                raise _Stop(await _fail(run.deps, run.job, "document_timeout", retryable=True))
+            parts.append(
+                await _cpu(run, _convert_slice, run.deps.converter, path, sha, rng.preset, sub_start, sub_end, run.job.priority)
+            )
+    return parts[0] if len(parts) == 1 else await _cpu(run, join_page_parts, parts)
+
+
+def _check_range(run: _Run, document: DoclingDocument, rng: PageRange, preflight_pages: list[PageSignals]) -> QualityCheckResult:
+    by_page = {page.page: page for page in preflight_pages}
+    previous = by_page.get(rng.start - 1)
+    return quality.check(
+        document,
+        [page for page in preflight_pages if rng.start <= page.page <= rng.end],
+        list(run.job.settings.ocr_languages),
+        run.cfg,
+        boundary_prev_ends_in_table=bool(previous and previous.continues_to_next),
+        first_page=rng.start,
+    )
+
+
+async def _record_attempt(
+    run: _Run,
+    *,
+    tier: str,
+    preset: str,
+    parser: str,
+    version: str,
+    start: int,
+    end: int,
+    reason: str,
+    ms: int,
+    cost: float,
+    cache_hit: bool,
+    refused: bool,
+    check: QualityCheckResult | None,
+) -> int:
+    attempt: dict[str, Any] = {
+        "tier": tier,
+        "preset": preset,
+        "parser": parser,
+        "parser_version": version,
+        "pages": {"start": start, "end": end},
+        "reason": reason,
+        "ms": ms,
+        "est_cost_usd": cost,
+        "cache_hit": cache_hit,
+        "refused": refused,
+    }
+    if check is not None:
+        attempt["check"] = check.model_dump(mode="json")
+    number = await run.deps.ledger.record_attempt(run.job.id, run.deps.worker_id, attempt)
+    run.last_attempt_no = number
+    return number
+
+
+async def _docling_range(
+    run: _Run,
+    rng: PageRange,
+    result: PreflightResult,
+    reusable: Reusable,
+    *,
+    reason: str = "initial",
+) -> _RangeResult:
+    version = _docling_version()
+    options = _range_options(run, rng.preset, rng.start, rng.end)
+    pages = rng.end - rng.start + 1
+    started = run.deps.clock()
+    hit = await _cached_document(run, "docling", version, options)
+    if hit is not None:
+        document, entry = hit
+        cache_hit = True
+    else:
+        document = await _convert_range(run, rng, reusable)
+        entry = await _store_document(
+            run, "docling", version, options, document, {"preset": rng.preset, "start": rng.start, "end": rng.end}
+        )
+        cache_hit = False
+    parse_ms = _ms(run, started)
+    check_started = run.deps.clock()
+    check = _check_range(run, document, rng, result.pages)
+    run.check_ms += _ms(run, check_started)
+    run.parse_ms += parse_ms
+    await _record_attempt(
+        run,
+        tier=rng.tier,
+        preset=rng.preset,
+        parser="docling",
+        version=version,
+        start=rng.start,
+        end=rng.end,
+        reason=reason,
+        ms=parse_ms,
+        cost=0.0 if cache_hit else _cost(run, rng.tier, pages),
+        cache_hit=cache_hit,
+        refused=False,
+        check=check,
+    )
+    return _RangeResult(rng, document, "docling", version, options, entry, check)
+
+
+# --- premium ranges -------------------------------------------------------------------------------------------------
+
+
+def _page_sizes(path: Path, pages: list[int]) -> dict[int, Size]:
+    import pypdfium2 as pdfium
+
+    document = pdfium.PdfDocument(str(path))
+    try:
+        sizes: dict[int, Size] = {}
+        for page in pages:
+            width, height = document[page - 1].get_size()
+            sizes[page] = Size(width=float(width), height=float(height))
+        return sizes
+    finally:
+        document.close()
+
+
+def _premium_document(response: ParseExternalResponse, sizes: dict[int, Size]) -> DoclingDocument:
+    assert response.pages is not None
+    ordered = sorted(response.pages, key=lambda page: page.page)
+    return premium_part([(page.page, page.text) for page in ordered], sizes)
+
+
+async def _premium_range(run: _Run, rng: PageRange, result: PreflightResult) -> _RangeResult | None:
+    """Parses a premium range through parse-external with a sub-PDF holding only its pages (D-53). None when the guard refused it."""
+    job, deps = run.job, run.deps
+    pages = list(range(rng.start, rng.end + 1))
+    options = _premium_options(rng)
+    started = deps.clock()
+    attempt = {
+        "tier": "premium",
+        "preset": "premium",
+        "parser": PREMIUM_PARSER,
+        "version": PREMIUM_PARSER_VERSION,
+        "start": rng.start,
+        "end": rng.end,
+        "reason": "initial",
+    }
+    hit = await _cached_document(run, PREMIUM_PART_PARSER, PREMIUM_PART_VERSION, options)
+    if hit is not None:
+        document, entry = hit
+        parse_ms = _ms(run, started)
+        run.parse_ms += parse_ms
+        check = _check_range(run, document, rng, result.pages)
+        await _record_attempt(run, **attempt, ms=parse_ms, cost=0.0, cache_hit=True, refused=False, check=check)
+        return _RangeResult(rng, document, PREMIUM_PART_PARSER, PREMIUM_PART_VERSION, options, entry, check)
+
+    path = await _original(run)
+    sub_path = run.tmp / f"premium-{rng.start}-{rng.end}.pdf"
+    await _cpu(run, cut_subpdf, path, pages, sub_path)
+    prefix = await deps.ledger.cache_prefix(job.id, SUBPDF_PARSER, "1", options)
+    if not prefix or not _prefix_ok(run, prefix):
+        raise _Stop(await _fail(deps, job, "ledger_error", retryable=True))
+    deps.storage.register_cache_prefix(prefix)
+    name = f"subpdf-{rng.start}-{rng.end}.pdf"
+    try:
+        await deps.storage.put(run.bucket, prefix, name, sub_path.read_bytes())
+    except (StorageError, StoragePathError) as error:
+        raise _Stop(await _fail(deps, job, "storage_error", retryable=True)) from error
+
+    response = await parse_external_done(
+        deps,
+        job,
+        mode="premium",
+        options=options,
+        attempt_no=run.next_attempt_no,
+        pages=ParseAttemptPages(start=rng.start, end=rng.end),
+        subpdf_ref=f"{prefix}{name}",
+        cursor=json.dumps({"original_pages": pages, "reserve_pages": len(pages)}),
+        allow_refused=True,
+    )
+    parse_ms = _ms(run, started)
+    run.parse_ms += parse_ms
+    if response.status == "refused":
+        await _record_attempt(run, **attempt, ms=parse_ms, cost=0.0, cache_hit=False, refused=True, check=None)
+        return None
+    if response.pages is None:
+        raise _Stop(await _fail(deps, job, "premium_pages_missing", retryable=True))
+    sizes = await _cpu(run, _page_sizes, path, pages)
+    document = await _cpu(run, _premium_document, response, sizes)
+    entry = await _store_document(
+        run, PREMIUM_PART_PARSER, PREMIUM_PART_VERSION, options, document, {"preset": "premium", "start": rng.start, "end": rng.end}
+    )
+    check = _check_range(run, document, rng, result.pages)
+    await _record_attempt(
+        run, **attempt, ms=parse_ms, cost=_cost(run, "premium", len(pages)), cache_hit=False, refused=False, check=check
+    )
+    return _RangeResult(rng, document, PREMIUM_PART_PARSER, PREMIUM_PART_VERSION, options, entry, check)
+
+
+# --- merge and hand-off ---------------------------------------------------------------------------------------------
+
+
+@functools.lru_cache(maxsize=1)
+def _profiles() -> dict[str, ProcessingProfile]:
+    payload = ProcessingProfileSet.model_validate_json(_PROFILES_PATH.read_text(encoding="utf-8"))
+    return {profile.id: profile for profile in payload.profiles}
+
+
+def _content_type(name: str) -> str:
+    if name.endswith(".json"):
+        return "application/json"
+    if name.endswith(".png"):
+        return "image/png"
+    return "application/octet-stream"
+
+
+def _build_parse_result(
+    document: DoclingDocument,
+    request: ParseJobRequest,
+    parser: str,
+    version: str,
+    text_layer_share: float | None,
+) -> tuple[ParseResult, dict[str, bytes]]:
+    from rag_sidecar.parse import docling_adapter
+
+    with tempfile.TemporaryDirectory(prefix="rag-merged-") as directory:
+        out = Path(directory)
+        parsed = docling_adapter.to_parse_result(
+            document, request, out, parser=parser, parser_version_text=version, text_layer_page_share=text_layer_share
+        )
+        files = {name: (out / name).read_bytes() for name in parsed.artifacts}
+    return parsed, files
+
+
+def _merged_version(run: _Run) -> str:
+    return f"{MERGED_VERSION}:{run.job.settings.profile_id}"
+
+
+async def _find_merged(run: _Run, entries: list[tuple[str, str, str]]) -> tuple[str, ParseCacheEntry | None]:
+    options = merged_options_hash(entries)
+    for entry in await run.deps.ledger.cache_lookup(run.job.id, MERGED_PARSER, _merged_version(run), options):
+        if _prefix_ok(run, entry.object_prefix):
+            return options, entry
+    return options, None
+
+
+async def _merged_entry(run: _Run, results: list[_RangeResult], n_pages: int, text_layer_share: float | None) -> ParseCacheEntry:
+    options, existing = await _find_merged(run, [(item.parser, item.version, item.options) for item in results])
+    if existing is not None:
+        return existing
+    parts = [item.document for item in results]
+    document = parts[0] if len(parts) == 1 else await _cpu(run, merge, parts, n_pages)
+    profile = _profiles().get(run.job.settings.profile_id)
+    if profile is None:
+        raise _Stop(await _fail(run.deps, run.job, "profile_missing", retryable=False))
+    request = ParseJobRequest(
+        profile_id=profile.id,
+        profile_version=profile.version,
+        docling=profile.parser.docling,
+        ocr_languages=list(run.job.settings.ocr_languages),
+        max_tokens=profile.chunker.max_tokens,
+        repeat_table_header=profile.chunker.repeat_table_header,
+    )
+    parser = PREMIUM_PARSER if all(item.parser == PREMIUM_PART_PARSER for item in results) else "docling"
+    parsed, files = await _cpu(run, _build_parse_result, document, request, parser, _docling_version(), text_layer_share)
+    objects = {RESULT_JSON: parsed.model_dump_json().encode("utf-8"), **files}
+    meta = {
+        "parser": parsed.parser,
+        "parser_version": parsed.parser_version,
+        "page_count": parsed.page_count,
+        "artifacts": [{"name": name, "content_type": _content_type(name)} for name in parsed.artifacts],
+    }
+    return await _put_entry(run, MERGED_PARSER, _merged_version(run), options, objects, meta)
+
+
+def _ranges_payload(results: list[_RangeResult]) -> list[dict[str, Any]]:
+    payload: list[dict[str, Any]] = []
+    for item in results:
+        failed = item.check is not None and not item.check.passed
+        updated = item.rng.model_copy(
+            update={"status": "needs_review" if failed else "ok", "cache_id": item.entry.id if item.entry else None}
+        )
+        payload.append(updated.model_dump(mode="json"))
+    return payload
+
+
+def _top_tier(counts: dict[str, int]) -> str:
+    present = [tier for tier, count in counts.items() if count > 0]
+    return max(present, key=lambda tier: _TIER_RANK.get(tier, 0)) if present else "fast"
+
+
+async def _finish(
+    run: _Run,
+    results: list[_RangeResult],
+    n_pages: int,
+    text_layer_share: float | None,
+    *,
+    dry_run: bool,
+) -> JobOutcome:
+    """Records the check, then either ends a dry run or merges, caches the merged entry and drives advance to the end."""
+    job, deps = run.job, run.deps
+    await deps.ledger.advance(job.id, deps.worker_id, stage="parse", status="parsing", timing_ms=run.parse_ms)
+    ranges = _ranges_payload(results)
+    await deps.ledger.advance(
+        job.id, deps.worker_id, stage="check", status="checking", timing_ms=run.check_ms, fields={"page_ranges": ranges}
+    )
+    if dry_run:
+        await deps.ledger.advance(job.id, deps.worker_id, stage="ready", status="ready", fields={"page_ranges": ranges})
+        return JobOutcome(status="ready")
+    try:
+        entry = await _merged_entry(run, results, n_pages, text_layer_share)
+    except MergeInvariantError as error:
+        logger.warning("[RAG Ingest] merge invariant failed", extra={"job_id": job.id, "reason": str(error)})
+        raise _Stop(await _fail(deps, job, "merge_invariant", retryable=False)) from error
+    return await _advance_until_done(deps, job, entry.id, max(1, run.last_attempt_no))
+
+
+async def _already_merged(run: _Run, result: PreflightResult) -> ParseCacheEntry | None:
+    """The merged entry of this exact range plan when an earlier run finished it, so a resumed job parses and merges nothing."""
+    entries: list[tuple[str, str, str]] = []
+    version = _docling_version()
+    for rng in result.ranges:
+        if rng.preset == "premium":
+            entries.append((PREMIUM_PART_PARSER, PREMIUM_PART_VERSION, _premium_options(rng)))
+        else:
+            entries.append(("docling", version, _range_options(run, rng.preset, rng.start, rng.end)))
+    _options, entry = await _find_merged(run, entries)
+    return entry
+
+
+# --- the three flows ------------------------------------------------------------------------------------------------
+
+
+async def _run_pdf(run: _Run, *, dry_run: bool) -> JobOutcome:
+    job, deps = run.job, run.deps
+    result, reusable = await _preflight(run)
+    await deps.ledger.advance(
+        job.id,
+        deps.worker_id,
+        stage="parse",
+        status="parsing",
+        fields={
+            "doc_class": result.doc_class,
+            "tier": _top_tier(dict(result.tier_page_counts)),
+            "pages": result.page_count,
+            "tier_page_counts": dict(result.tier_page_counts),
+            "detect_counts": result.detect_counts.model_dump(mode="json"),
+            "page_ranges": [rng.model_dump(mode="json") for rng in result.ranges],
+        },
+    )
+    if not dry_run:
+        merged = await _already_merged(run, result)
+        if merged is not None:
+            return await _advance_until_done(deps, job, merged.id, max(1, len(job.attempts)))
+
+    version = _docling_version()
+    for (start, end), (document, _meta) in reusable.items():
+        options = _range_options(run, "fast", start, end)
+        if await _cached_document(run, "docling", version, options) is None:
+            await _store_document(run, "docling", version, options, document, {"preset": "fast", "start": start, "end": end})
+
+    for planned in result.ranges:
+        if deps.clock() - run.started > deps.document_timeout_s:
+            raise _Stop(await _fail(deps, job, "document_timeout", retryable=True))
+        rng = planned
+        if rng.preset == "premium":
+            premium = await _premium_range(run, rng, result)
+            if premium is not None:
+                run.results.append(premium)
+                continue
+            rng = rng.model_copy(update={"preset": "structured_full", "tier": "structured", "parser": "docling"})
+        run.results.append(await _docling_range(run, rng, result, reusable))
+    pages = result.pages
+    share = sum(1 for page in pages if page.text_layer) / len(pages) if pages else None
+    return await _finish(run, run.results, result.page_count, share, dry_run=dry_run)
+
+
+async def _run_native(run: _Run, kind: DocKind, *, dry_run: bool) -> JobOutcome:
+    """txt, md and csv through the app's plain-text parser, images through native captioning (D-10, D-12)."""
+    job, deps = run.job, run.deps
+    options = options_hash({"preset": "native", "input_format": job.mime_type or "application/octet-stream"})
+    started = deps.clock()
+    response = await parse_external_done(deps, job, mode="native", options=options, attempt_no=run.next_attempt_no)
+    parse_ms = _ms(run, started)
+    assert response.cache_id is not None
+    pages = response.pages or []
+    check_started = deps.clock()
+    check = quality.check_text_pages(
+        [quality.TextPage(page=page.page, text=page.text, has_table=page.has_table) for page in pages],
+        [],
+        list(job.settings.ocr_languages),
+        run.cfg,
+    )
+    check_ms = _ms(run, check_started)
+    end = max([page.page for page in pages], default=1)
+    number = await _record_attempt(
+        run,
+        tier="native",
+        preset="native",
+        parser=NATIVE_PARSER,
+        version=NATIVE_VERSION,
+        start=1,
+        end=end,
+        reason="native",
+        ms=parse_ms,
+        cost=_cost(run, "native", end),
+        cache_hit=False,
+        refused=False,
+        check=check,
+    )
+    rng = PageRange(
+        start=1,
+        end=end,
+        tier="native",
+        preset="native",
+        parser=NATIVE_PARSER,
+        layer="L1",
+        signals=[],
+        status="ok" if check.passed else "needs_review",
+        cache_id=response.cache_id,
+    )
+    payload = [rng.model_dump(mode="json")]
+    await deps.ledger.advance(
+        job.id,
+        deps.worker_id,
+        stage="parse",
+        status="parsing",
+        timing_ms=parse_ms,
+        fields={
+            "doc_class": "image" if kind.name == "image" else "native",
+            "tier": "native",
+            "pages": end,
+            "tier_page_counts": {"native": end, "fast": 0, "structured": 0, "premium": 0},
+            "page_ranges": payload,
+        },
+    )
+    await deps.ledger.advance(job.id, deps.worker_id, stage="check", status="checking", timing_ms=check_ms, fields={"page_ranges": payload})
+    if dry_run:
+        await deps.ledger.advance(job.id, deps.worker_id, stage="ready", status="ready", fields={"page_ranges": payload})
+        return JobOutcome(status="ready")
+    return await _advance_until_done(deps, job, response.cache_id, number)
+
+
+def _convert_whole(deps: WorkerDeps, path: Path, preset: str, languages: list[str]) -> DoclingDocument:
+    if deps.whole_converter is not None:
+        return deps.whole_converter(path, preset, languages)
+    from rag_sidecar.parse import docling_adapter
+
+    return docling_adapter.convert_whole(path, preset, languages)
+
+
+async def _run_office(run: _Run, kind: DocKind, *, dry_run: bool) -> JobOutcome:
+    """docx and html as one native range, pptx and xlsx as one structured range, all converted in the worker (D-10, D-12)."""
+    job, deps = run.job, run.deps
+    if deps.storage is None:
+        raise await _unavailable(run)
+    structured = run.cfg.office_formats.get(kind.office_format or "", "native") == "structured"
+    tier: ParseTier = "structured" if structured else "native"
+    converter_preset = "structured_layout" if structured else "fast"
+    preset = "structured_layout" if structured else "native"
+    version = _docling_version()
+    options = _range_options(run, converter_preset, None, None, input_format=job.mime_type or "application/octet-stream")
+    started = deps.clock()
+    hit = await _cached_document(run, "docling", version, options)
+    if hit is not None:
+        document, entry = hit
+        cache_hit = True
+    else:
