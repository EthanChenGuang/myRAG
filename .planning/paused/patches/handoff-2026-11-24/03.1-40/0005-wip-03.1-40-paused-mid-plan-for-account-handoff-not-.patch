+@dataclass(frozen=True)
+class DocKind:
+    """What a job's file is, as far as the tiered flow cares: pdf, text, image, office (with its format key) or unknown."""
+
+    name: str
+    office_format: str | None = None
+
+
+def detect_kind(job: IngestionJob) -> DocKind:
+    """Classifies the job's file from its media type, then its name. No bytes are read."""
+    mime = (job.mime_type or "").split(";")[0].strip().lower()
+    name = job.filename or (job.original_ref.path if job.original_ref else "") or job.source_key
+    extension = Path(name).suffix.lower()
+    if mime == "application/pdf":
+        return DocKind("pdf")
+    if mime in _OFFICE_MIMES:
+        return DocKind("office", _OFFICE_MIMES[mime])
+    if mime in _TEXT_MIMES:
+        return DocKind("text")
+    if mime.startswith("image/"):
+        return DocKind("image")
+    if extension == ".pdf":
+        return DocKind("pdf")
+    if extension in _OFFICE_EXTENSIONS:
+        return DocKind("office", _OFFICE_EXTENSIONS[extension])
+    if extension in _TEXT_EXTENSIONS:
+        return DocKind("text")
+    if extension in _IMAGE_EXTENSIONS:
+        return DocKind("image")
+    return DocKind("unknown")
