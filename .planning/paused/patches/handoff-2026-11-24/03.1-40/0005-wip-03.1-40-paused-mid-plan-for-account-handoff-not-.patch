+async def _original(run: _Run) -> Path:
+    """The original file, downloaded the first time a step needs its bytes."""
+    if run.original is not None:
+        return run.original
+    if run.deps.storage is None:
+        raise await _unavailable(run)
+    ref = run.job.original_ref
+    if ref is None:
+        raise _Stop(await _fail(run.deps, run.job, "file_missing", retryable=False))
+    try:
