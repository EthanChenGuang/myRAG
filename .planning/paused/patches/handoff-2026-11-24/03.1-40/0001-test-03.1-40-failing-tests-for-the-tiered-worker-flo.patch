+def test_mixed_fixture_parses_each_range_records_attempts_caches_and_hands_the_merged_entry_to_advance():
+    env = Env()
+    outcome = env.run_tiered()
+
+    assert outcome == JobOutcome(status="ready")
+    assert [_summary(a) for a in env.attempts()] == [
+        ("fast", "fast", 1, 6, "initial"),
+        ("structured", "structured_full", 7, 8, "initial"),
+        ("structured", "structured_ocr", 9, 10, "initial"),
+    ]
+    for attempt in env.attempts():
+        pages = attempt.pages.end - attempt.pages.start + 1
+        per_page = getattr(env.cfg.costs.tier, attempt.tier).usd_per_page
+        assert attempt.est_cost_usd == pytest.approx(pages * per_page)
+        assert attempt.ms > 0
+        assert attempt.cache_hit is False and attempt.refused is False
+        assert attempt.check is not None
+        assert attempt.parser == "docling"
+
+    job = env.ledger.jobs[_JOB_ID]
+    prefix_root = f"{_TENANT}/_parse-cache/{env.sha}/"
+    assert job.preflight_ref is not None and job.preflight_ref.startswith(prefix_root)
+    stored = env.storage.objects[(_BUCKET, job.preflight_ref)]
+    assert PreflightResult.model_validate_json(stored).page_count == 10
+
+    merged = [entry for key, entry in env.ledger.cache.items() if key[2] == "merged"]
+    assert len(merged) == 1
+    assert merged[0].object_prefix.startswith(prefix_root)
+    result = ParseResult.model_validate_json(env.storage.objects[(_BUCKET, f"{merged[0].object_prefix}result.json")])
+    assert result.page_count == 10
+    first_pages = [min(chunk.pages) for chunk in result.chunks if chunk.pages]
+    assert first_pages == sorted(first_pages) and min(first_pages) >= 1 and max(first_pages) <= 10
+
+    advance_calls = env.calls("advance")
+    assert len(advance_calls) == 1
+    assert advance_calls[0]["phase"] == "post_parse"
+    assert advance_calls[0]["parse_cache_id"] == merged[0].id
+    assert advance_calls[0]["attempt_no"] == 3
+    assert env.calls("parse_external") == []
+
+    stages = [step["stage"] for step in env.ledger.advances]
+    assert stages.index("preflight") < stages.index("parse") < stages.index("check")
+    parse_fields = next(step["fields"] for step in env.ledger.advances if step["stage"] == "parse")
+    assert parse_fields["doc_class"] == "mixed"
+    assert [(r["start"], r["end"], r["preset"]) for r in parse_fields["page_ranges"]] == [
+        (1, 6, "fast"),
+        (7, 8, "structured_full"),
+        (9, 10, "structured_ocr"),
+    ]
+    assert parse_fields["tier_page_counts"]["structured"] == 3
+    assert parse_fields["detect_counts"]["L1"] == 10
+    final_ranges = next(step["fields"] for step in env.ledger.advances if step["stage"] == "check")["page_ranges"]
+    assert all(r["status"] in {"ok", "needs_review"} and r["cache_id"] for r in final_ranges)
+
