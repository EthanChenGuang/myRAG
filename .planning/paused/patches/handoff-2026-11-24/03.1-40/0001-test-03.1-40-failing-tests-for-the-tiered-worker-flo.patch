+def _job(
+    *,
+    sha: str,
+    mime: str = "application/pdf",
+    name: str = "original.pdf",
+    kind: str = "ingest",
+    priority: int = 100,
+    settings: dict[str, Any] | None = None,
+) -> IngestionJob:
+    return IngestionJob.model_validate(
+        {
+            "id": _JOB_ID,
+            "kind": kind,
+            "status": "preflight",
+            "tenant_key": _TENANT,
+            "source": "config_upload",
+            "source_key": f"root/{name}",
+            "file_sha256": sha,
+            "filename": name,
+            "mime_type": mime,
+            "original_ref": {"bucket": _BUCKET, "path": f"{_TENANT}/lineage/1/{name}"},
+            "priority": priority,
+            "settings": settings or _settings(),
+            "locked_by": _WORKER,
+            "lease_until": (_NOW + timedelta(hours=1)).isoformat(),
+            "created_at": _NOW.isoformat(),
+            "updated_at": _NOW.isoformat(),
+        }
+    )
+
