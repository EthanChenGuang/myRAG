+def _settings(**overrides: Any) -> dict[str, Any]:
+    base = {
+        "routing": "tiered",
+        "cloud_allowed": True,
+        "escalation": True,
+        "progressive": False,
+        "premium_max_pages_per_doc": 50,
+        "premium_page_budget": 0,
+        "vlm_detect": False,
+        "profile_id": "general@1",
+        "profile_version": 1,
+        "doc_type": "general",
+        "min_tier": "fast",
+        "max_tier": "premium",
+        "embed_mode": "sync",
+        "ocr_languages": ["en"],
+        "routing_config_version": "1",
+    }
+    base.update(overrides)
+    return base
