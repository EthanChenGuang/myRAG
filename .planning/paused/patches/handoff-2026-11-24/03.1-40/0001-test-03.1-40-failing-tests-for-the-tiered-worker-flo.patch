+class TieredStorage(FakeStorage):
+    """FakeStorage with the real client's download (a path) and get_bytes."""
+
+    def __init__(self, files: dict[str, bytes] | None = None) -> None:
+        super().__init__()
+        self.files = files or {}
+        self._dirs: list[tempfile.TemporaryDirectory[str]] = []
+
+    async def download(self, original_ref: OriginalRef, *, dest_dir: Path | None = None) -> Path:  # type: ignore[override]
+        self.calls.append(("download", original_ref.bucket, original_ref.path))
+        target = dest_dir
+        if target is None:
+            holder = tempfile.TemporaryDirectory()
+            self._dirs.append(holder)
+            target = Path(holder.name)
+        out = target / Path(original_ref.path).name
+        out.write_bytes(self.files[original_ref.path])
+        return out
+
+    async def get_bytes(self, bucket: str, path: str) -> bytes:
+        self.calls.append(("get_bytes", bucket, path))
+        found = self.objects.get((bucket, path))
+        if found is None:
+            raise StorageError("storage read returned 404")
+        return found
+
+    def keys(self) -> list[str]:
+        return sorted(path for _bucket, path in self.objects)
+
+
+class TrackingLedger(FakeLedger):
+    """Records every advance with its fields and applies the fields to the row like rag_advance_ingestion_job does."""
+
+    def __init__(self) -> None:
+        super().__init__()
+        self.advances: list[dict[str, Any]] = []
+        self.lose_lease_on_cache_put: str | None = None
+
+    async def advance(self, job_id, worker, *, stage, status, stage_state=None, timing_ms=None, fields=None):  # type: ignore[override]
+        self.advances.append({"stage": stage, "status": status, "timing_ms": timing_ms, "fields": dict(fields or {})})
+        job = await super().advance(
+            job_id, worker, stage=stage, status=status, stage_state=stage_state, timing_ms=timing_ms, fields=fields
+        )
+        if fields:
+            merged = IngestionJob.model_validate({**job.model_dump(mode="json"), **fields})
+            self.jobs[job_id] = merged
+            return merged
+        return job
+
+    async def cache_put(self, job_id, parser, parser_version, options_hash, object_prefix, **kwargs):  # type: ignore[override]
+        if self.lose_lease_on_cache_put == parser:
+            raise LeaseLost("lease_lost")
+        return await super().cache_put(job_id, parser, parser_version, options_hash, object_prefix, **kwargs)
+
+    def parsers_cached(self) -> list[str]:
+        return [key[2] for key in self.cache]
+
+
+class TickClock:
+    def __init__(self, step: float = 0.25) -> None:
+        self.now = 0.0
+        self.step = step
+
+    def __call__(self) -> float:
+        self.now += self.step
+        return self.now
+
+
+class PoolSpy:
+    """Runs every submission at once and keeps what was asked of the pool."""
+
+    def __init__(self) -> None:
+        self.submitted: list[tuple[str, int]] = []
+
+    def submit(self, fn, args, *, priority, deadline_s):
+        self.submitted.append((getattr(fn, "__name__", "fn"), priority))
+        future: asyncio.Future[Any] = asyncio.get_running_loop().create_future()
+        try:
+            future.set_result(fn(*args))
+        except Exception as error:  # noqa: BLE001
+            future.set_exception(error)
+        return future
+
+
+class SpyConverter(converters.RecordedRangeConverter):
+    def __init__(self, root: Path) -> None:
+        super().__init__(root)
+        self.calls: list[tuple[str, int, int, int]] = []
+
+    def convert(self, path, file_sha256, preset, start, end, priority):
+        self.calls.append((preset, start, end, priority))
+        return super().convert(path, file_sha256, preset, start, end, priority)
+
+
+class Env:
+    def __init__(self, fixture_id: str = "mixed-routing", **job_kwargs: Any) -> None:
+        data, self.sha = _fixture_bytes(fixture_id)
+        self.job = _job(sha=self.sha, **job_kwargs)
+        self.ledger = TrackingLedger()
+        self.ledger.seed(self.job)
+        self.claim()
+        self.app = FakeApp()
+        self.app.script("advance", [AppScript(response=_advance_done())])
+        self.storage = TieredStorage({self.job.original_ref.path: data})  # type: ignore[union-attr]
+        self.converter = SpyConverter(RECORDED)
+        self.cfg = load_routing_config()
+        self.extra: dict[str, Any] = {}
+
+    def claim(self) -> IngestionJob:
+        current = self.ledger.jobs[_JOB_ID]
+        self.ledger.jobs[_JOB_ID] = current.model_copy(
+            update={"locked_by": _WORKER, "lease_until": self.ledger.clock.now() + timedelta(hours=1)}
+        )
+        return self.ledger.jobs[_JOB_ID]
+
+    def deps(self, **overrides: Any) -> WorkerDeps:
+        async def no_sleep(_seconds: float) -> None:
+            return None
+
+        values: dict[str, Any] = {
+            "ledger": self.ledger,
+            "app": self.app,
+            "worker_id": _WORKER,
+            "sleep": no_sleep,
+            "clock": TickClock(),
+            "storage": self.storage,
+            "converter": self.converter,
+            "routing_cfg": self.cfg,
+        }
+        values.update(self.extra)
+        values.update(overrides)
+        return WorkerDeps(**values)
+
+    def run_tiered(self, **kwargs: Any) -> JobOutcome:
+        deps = kwargs.pop("deps", None) or self.deps()
+        return asyncio.run(run_tiered(self.ledger.jobs[_JOB_ID], deps, **kwargs))
+
+    def process(self, **kwargs: Any) -> JobOutcome:
+        deps = kwargs.pop("deps", None) or self.deps()
+        return asyncio.run(process_job(self.ledger.jobs[_JOB_ID], deps))
+
+    def attempts(self):
+        return self.ledger.jobs[_JOB_ID].attempts
+
+    def calls(self, name: str) -> list[dict[str, Any]]:
+        return [call[2] for call in self.app.calls if call[0] == name]
+
+
+def _advance_done() -> dict[str, Any]:
+    return {"worker_id": _WORKER, "stage": "ready", "done": True, "status": "ready"}
+
