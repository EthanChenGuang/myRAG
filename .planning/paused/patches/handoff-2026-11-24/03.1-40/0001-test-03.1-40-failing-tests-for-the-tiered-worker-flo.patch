+def test_a_low_priority_range_is_submitted_to_the_pool_in_sub_ranges_and_cached_as_one_entry():
+    env = Env("bench-100", priority=10)
+    pool = PoolSpy()
+
+    def preflight_fn(path, settings, cfg, converter, *, file_sha=None):
+        from rag_sidecar.preflight.run import PreflightOutput, run_preflight
+
+        output = run_preflight(path, settings, cfg, converter, file_sha=file_sha)
+        first = output.result.ranges[0]
+        ranges = [
+            PageRange(start=1, end=60, tier="fast", preset="fast", parser="docling", layer=first.layer, signals=[], status="pending"),
+            PageRange(start=61, end=100, tier="fast", preset="fast", parser="docling", layer=first.layer, signals=[], status="pending"),
+        ]
+        return PreflightOutput(result=output.result.model_copy(update={"ranges": ranges}), reusable_fast={})
+
+    outcome = env.run_tiered(deps=env.deps(pool=pool, preflight_fn=preflight_fn))
+    assert outcome == JobOutcome(status="ready")
+    assert [(start, end) for preset, start, end, _p in env.converter.calls if preset == "fast"] == [
+        (1, 24),
+        (25, 48),
+        (49, 60),
+        (61, 84),
+        (85, 100),
+    ]
+    assert all(priority == 10 for _name, priority in pool.submitted)
+    entries = [key for key in env.ledger.cache if key[2] == "docling"]
+    assert len(entries) == 2, "one cache entry per range, not per sub-range"
