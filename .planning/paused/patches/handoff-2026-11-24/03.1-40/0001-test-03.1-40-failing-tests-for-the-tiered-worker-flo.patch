+def test_a_reclaimed_job_reuses_the_cache_for_every_finished_range():
+    env = Env()
+    env.ledger.lose_lease_on_cache_put = "merged"
+    with pytest.raises(LeaseLost):
+        env.run_tiered()
+    converted = converters.conversion_counter
+    assert converted > 0
+    assert env.ledger.parsers_cached().count("docling") >= 3
+    assert env.ledger.jobs[_JOB_ID].preflight_ref is not None
+
+    env.ledger.lose_lease_on_cache_put = None
+    env.claim()
+    before = len(env.attempts())
+    assert env.run_tiered() == JobOutcome(status="ready")
+
+    assert converters.conversion_counter == converted
+    second_run = env.attempts()[before:]
+    assert [a.cache_hit for a in second_run] == [True, True, True]
+    assert all(a.est_cost_usd == 0 for a in second_run)
+    assert len(env.calls("advance")) == 1
