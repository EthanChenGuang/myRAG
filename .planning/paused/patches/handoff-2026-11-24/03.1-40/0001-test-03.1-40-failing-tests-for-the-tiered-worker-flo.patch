+def test_pages_that_do_not_tile_the_document_fail_the_job_with_merge_invariant():
+    env = Env()
+
+    class DroppingConverter(SpyConverter):
+        def convert(self, path, file_sha256, preset, start, end, priority):
+            document, meta = super().convert(path, file_sha256, preset, start, end, priority)
+            if preset == "structured_full":
+                from rag_sidecar.ingest.merge import slice_pages
+
+                document = slice_pages(document, {start})
+            return document, meta
+
+    env.converter = DroppingConverter(RECORDED)
+    outcome = env.run_tiered()
+    assert outcome == JobOutcome(status="failed", error_class="merge_invariant")
+    assert env.calls("advance") == []
