+"""L3 preflight: vision-model verdicts for pages where L1 and L2 disagree (D-49, D-50)."""
+
+from __future__ import annotations
+
+import asyncio
+from collections.abc import Callable
+from pathlib import Path
+from typing import Protocol
+
+from rag_sidecar.contracts.queue import DetectVlmRequest, DetectVlmResponse, JobSettingsSnapshot
+from rag_sidecar.contracts.routing import ParseRoutingConfig
+from rag_sidecar.preflight.l2 import L2Page
+
+DEFAULT_TIMEOUT_S = 60.0
+
+
+class L3AppClient(Protocol):
+    async def detect_vlm(self, job_id: str, request: DetectVlmRequest) -> DetectVlmResponse: ...
+
+
+def l3_refine(
+    pages: list[L2Page],
+    disagreements: list[int],
+    path: Path | str,
+    snapshot: JobSettingsSnapshot | None,
+    app_client: L3AppClient,
+    cfg: ParseRoutingConfig,
+    *,
+    job_id: str,
+    worker_id: str,
+    attempt_no: int = 1,
+    loop: asyncio.AbstractEventLoop | None = None,
+    timeout_s: float = DEFAULT_TIMEOUT_S,
+) -> list[L2Page]:
+    return pages
+
+
+def make_l3_hook(
+    app_client: L3AppClient,
+    *,
+    job_id: str,
+    worker_id: str,
+    attempt_no: int = 1,
+    loop: asyncio.AbstractEventLoop | None = None,
+    timeout_s: float = DEFAULT_TIMEOUT_S,
+) -> Callable[[list[L2Page], list[int], Path, JobSettingsSnapshot | None, ParseRoutingConfig], list[L2Page]]:
+    def hook(
+        pages: list[L2Page],
+        disagreements: list[int],
+        path: Path,
+        snapshot: JobSettingsSnapshot | None,
+        cfg: ParseRoutingConfig,
+    ) -> list[L2Page]:
+        del disagreements, path, snapshot, cfg
+        return pages
+
+    return hook
