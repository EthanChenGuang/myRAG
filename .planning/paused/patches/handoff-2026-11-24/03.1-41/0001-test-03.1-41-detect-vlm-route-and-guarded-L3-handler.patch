+interface Ledger {
+  db: RpcClient;
+  calls: LedgerCall[];
+}
+
+function fakeLedger(rows: Record<string, Record<string, unknown>>, options: { reserve?: boolean | 'batch_refused' } = {}): Ledger {
+  const calls: LedgerCall[] = [];
+  const db: RpcClient = {
+    rpc(fn, args) {
+      const record = (args ?? {}) as Record<string, unknown>;
+      calls.push({ fn, args: record });
+      let response: RpcResponse;
+      if (fn === 'rag_get_ingestion_job_internal') {
+        const row = rows[String(record.p_job_id)];
+        response = { data: row ? [row] : [], error: null };
+      } else if (fn === 'rag_reserve_parse_budget') {
+        response = { data: [{ [fn]: options.reserve !== false }], error: null };
+      } else if (fn === 'rag_reserve_batch_budget') {
+        response = { data: [{ [fn]: options.reserve !== 'batch_refused' }], error: null };
+      } else {
+        response = { data: [{ [fn]: true }], error: null };
+      }
+      const request: RpcRequest = {
+        abortSignal: () => request,
+        then: (onFulfilled, onRejected) => Promise.resolve(response).then(onFulfilled, onRejected),
+      };
+      return request;
+    },
+  };
+  return { db, calls };
+}
+
+interface Stub {
+  inputs: VlmDetectInput[];
+  answer: (input: VlmDetectInput) => string | Promise<string>;
+}
+
+function installStub(answer: Stub['answer'] = () => JSON.stringify(VERDICT)): Stub {
+  const stub: Stub = { inputs: [], answer };
+  setVlmDetectorForTests(async (input) => {
+    stub.inputs.push(input);
+    return stub.answer(input);
+  });
+  return stub;
+}
+
+function body(worker: string, pages: number[], extra: Record<string, unknown> = {}) {
+  return {
+    worker_id: worker,
+    attempt_no: 1,
+    pages: pages.map((page) => ({ page, png_base64: pngBase64(`page-${page}`) })),
+    ...extra,
+  };
+}
+
+async function post(jobId: string, payload: unknown, secret: string | null | undefined = SECRET) {
+  const headers: Record<string, string> = { 'content-type': 'application/json' };
+  if (secret !== null && secret !== undefined) headers[SIDECAR_SECRET_HEADER] = secret;
+  const route = await import('@/app/api/internal/rag/ingest/jobs/[id]/detect-vlm/route');
+  const req = new NextRequest(`http://localhost/api/internal/rag/ingest/jobs/${jobId}/detect-vlm`, {
+    method: 'POST',
+    headers,
+    body: JSON.stringify(payload),
+  });
+  const res = await route.POST(req, { params: Promise.resolve({ id: jobId }) });
+  const text = await res.text();
+  let json: Record<string, unknown> = {};
+  try {
+    json = JSON.parse(text) as Record<string, unknown>;
+  } catch {
+    json = { raw: text };
+  }
+  return { status: res.status, json, text };
+}
+
+function install(rows: Record<string, Record<string, unknown>>, options: { reserve?: boolean | 'batch_refused' } = {}): Ledger {
