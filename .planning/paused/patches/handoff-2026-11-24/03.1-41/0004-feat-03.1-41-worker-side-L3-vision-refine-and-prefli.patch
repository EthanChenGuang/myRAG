+MAX_IMAGE_BYTES = 400_000
+# One request carries every page: keep the whole body well under common 4.5 MB request limits.
+MAX_REQUEST_IMAGE_BYTES = 3_000_000
+RENDER_SCALES = (1.4, 1.0, 0.7, 0.5)
 DEFAULT_TIMEOUT_S = 60.0
 
 
@@ -18,6 +39,65 @@ class L3AppClient(Protocol):
     async def detect_vlm(self, job_id: str, request: DetectVlmRequest) -> DetectVlmResponse: ...
 
 
+def _png_bytes(image: Any) -> bytes:
+    buffer = io.BytesIO()
+    image.save(buffer, format="PNG", optimize=True)
+    return buffer.getvalue()
+
+
+def render_page_png(path: Path | str, page_no: int, max_bytes: int = MAX_IMAGE_BYTES) -> bytes | None:
+    """Render one 1-based page to a PNG within max_bytes, or None when it cannot be made small enough."""
+    import pypdfium2 as pdfium
+
+    document = pdfium.PdfDocument(str(path))
+    try:
+        page = document[page_no - 1]
+        try:
+            for grayscale in (False, True):
+                for scale in RENDER_SCALES:
+                    if grayscale and scale > RENDER_SCALES[-1]:
+                        continue
+                    bitmap = page.render(scale=scale)
+                    image = bitmap.to_pil()
+                    if grayscale:
+                        image = image.convert("L")
+                    data = _png_bytes(image)
+                    if len(data) <= max_bytes:
+                        return data
+        finally:
+            page.close()
+    finally:
+        document.close()
+    return None
+
+
+def select_pages(disagreements: list[int], cfg: ParseRoutingConfig) -> list[int]:
+    """The disagreement pages L3 may look at: unique, in page order, at most l3.max_pages_per_doc."""
+    return sorted(set(disagreements))[: cfg.l3.max_pages_per_doc]
+
+
+def _run_coroutine[T](
+    factory: Callable[[], Coroutine[Any, Any, T]],
+    loop: asyncio.AbstractEventLoop | None,
+    timeout_s: float,
+) -> T:
+    async def bounded() -> T:
+        return await asyncio.wait_for(factory(), timeout=timeout_s)
+
+    if loop is not None and loop.is_running():
+        return asyncio.run_coroutine_threadsafe(bounded(), loop).result(timeout=timeout_s + 5)
+    try:
+        asyncio.get_running_loop()
+    except RuntimeError:
+        return asyncio.run(bounded())
+    with concurrent.futures.ThreadPoolExecutor(max_workers=1) as pool:
+        return pool.submit(lambda: asyncio.run(bounded())).result(timeout=timeout_s + 5)
+
+
+def _apply_verdict(page: L2Page, verdict: PageStructureVerdict) -> L2Page:
+    return replace(page, verdict=verdict, l3_inspected=True, uncertain=False, layer="L3")
+
