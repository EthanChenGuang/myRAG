 def l3_refine(
     pages: list[L2Page],
     disagreements: list[int],
@@ -32,7 +112,53 @@ def l3_refine(
     loop: asyncio.AbstractEventLoop | None = None,
     timeout_s: float = DEFAULT_TIMEOUT_S,
 ) -> list[L2Page]:
-    return pages
+    """Ask the app for vision verdicts on the disagreement pages and attach them to those pages.
+
+    Runs only when the job snapshot has vlm_detect on and cloud allowed. A refusal, a failure or a page without a verdict leaves the
+    page as it was, so the D-49 higher-tier rule applies; nothing here raises into the job.
+    """
+    if snapshot is None or not snapshot.vlm_detect or not snapshot.cloud_allowed:
+        return pages
+    by_page = {page.page: page for page in pages}
+    wanted = [number for number in select_pages(disagreements, cfg) if number in by_page]
+    if not wanted:
+        return pages
+
+    budget = min(MAX_IMAGE_BYTES, MAX_REQUEST_IMAGE_BYTES // len(wanted))
+    images: list[DetectVlmPageImage] = []
+    for number in wanted:
+        try:
+            png = render_page_png(path, number, budget)
+        except Exception as error:  # noqa: BLE001 - a page that cannot render is simply not refined
+            logger.warning("[Preflight] L3 render failed page=%s error=%s", number, type(error).__name__)
+            continue
+        if png is None:
+            logger.warning("[Preflight] L3 page too large to send page=%s", number)
+            continue
+        images.append(DetectVlmPageImage(page=number, png_base64=base64.b64encode(png).decode("ascii")))
+    if not images:
+        return pages
+
+    request = DetectVlmRequest(worker_id=worker_id, attempt_no=attempt_no, pages=images)
+    try:
+        response = _run_coroutine(lambda: app_client.detect_vlm(job_id, request), loop, timeout_s)
+    except Exception as error:  # noqa: BLE001 - L3 never fails the job (D-50)
+        logger.warning("[Preflight] L3 call failed error=%s", type(error).__name__)
+        return pages
+
+    sent = {image.page for image in images}
+    verdicts: dict[int, PageStructureVerdict] = {}
+    refused = 0
+    for result in response.pages:
+        if result.page not in sent:
+            continue
+        if result.verdict is not None:
+            verdicts[result.page] = result.verdict
+        elif result.refused is not None:
+            refused += 1
+    if refused:
+        logger.info("[Preflight] L3 refused pages=%s", refused)
+    return [_apply_verdict(page, verdicts[page.page]) if page.page in verdicts else page for page in pages]
 
 
