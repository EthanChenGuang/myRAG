Date: Tue, 24 Nov 2026 22:23:39 +0000
Subject: [PATCH 5/6] feat(05-03): split-safe incremental citation marker
 parser with alias validation

- per text id tail buffer, at most 17 characters held back from an unmatched opener
- aliases validated against the request set; unknown ones dropped and counted
- parseAnswerMarkers one-shot form for the eval endpoint; no AI SDK imports

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01X342shLsAZx6PYph2vA7hc
---
 .../rag/generation/citations/marker-parser.ts | 69 +++++++++++++++++--
 1 file changed, 63 insertions(+), 6 deletions(-)

diff --git a/src/lib/rag/generation/citations/marker-parser.ts b/src/lib/rag/generation/citations/marker-parser.ts
index 52b7c30..6c1e82e 100644
--- a/src/lib/rag/generation/citations/marker-parser.ts
+++ b/src/lib/rag/generation/citations/marker-parser.ts
@@ -1,3 +1,5 @@
+import { isMarkerOpener, matchMarkerAt } from '@/lib/citations/marker-grammar';
+
 export interface MarkerParseResult {
   valid: string[];
   invalidCitations: number;
@@ -10,14 +12,69 @@ export interface MarkerParser {
   finish(): MarkerParseResult;
 }
 
-export function createMarkerParser(_options: { aliases: ReadonlySet<string> }): MarkerParser {
+export function createMarkerParser(options: { aliases: ReadonlySet<string> }): MarkerParser {
+  const { aliases } = options;
+  const valid: string[] = [];
+  const invalidAliases: string[] = [];
+  const validSeen = new Set<string>();
+  let invalidCitations = 0;
+  const tails = new Map<string, string>();
+  let finished = false;
+
+  function record(found: string[]): void {
+    for (const alias of found) {
+      if (aliases.has(alias)) {
+        if (!validSeen.has(alias)) {
+          validSeen.add(alias);
+          valid.push(alias);
+        }
+      } else {
+        invalidCitations++;
+        if (!invalidAliases.includes(alias)) invalidAliases.push(alias);
+      }
+    }
+  }
+
+  function feed(textId: string, delta: string): void {
+    if (finished || delta === '') return;
+    const text = (tails.get(textId) ?? '') + delta;
+    let tail = '';
+    let i = 0;
+    while (i < text.length) {
+      if (!isMarkerOpener(text[i])) {
+        i++;
+        continue;
+      }
+      const m = matchMarkerAt(text, i);
+      if (m.kind === 'match') {
+        record(m.aliases);
+        i = m.end;
+      } else if (m.kind === 'partial') {
+        tail = text.slice(i);
+        break;
+      } else {
+        i++;
+      }
+    }
+    if (tail === '') tails.delete(textId);
+    else tails.set(textId, tail);
+  }
+
   return {
-    feed() {},
-    end() {},
-    finish: () => ({ valid: [], invalidCitations: 0, invalidAliases: [] }),
+    feed,
+    end(textId) {
+      tails.delete(textId);
+    },
+    finish() {
+      finished = true;
+      tails.clear();
+      return { valid: [...valid], invalidCitations, invalidAliases: [...invalidAliases] };
+    },
   };
 }
 
-export function parseAnswerMarkers(_text: string, _aliases: ReadonlySet<string>): MarkerParseResult {
-  return { valid: [], invalidCitations: 0, invalidAliases: [] };
+export function parseAnswerMarkers(text: string, aliases: ReadonlySet<string>): MarkerParseResult {
+  const parser = createMarkerParser({ aliases });
+  parser.feed('answer', text);
+  return parser.finish();
 }
