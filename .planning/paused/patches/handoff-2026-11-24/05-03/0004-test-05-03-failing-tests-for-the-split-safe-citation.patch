+import { describe, expect, it } from 'vitest';
+import { findCitationMarkers } from '@/lib/citations/marker-grammar';
+import {
+  createMarkerParser,
+  parseAnswerMarkers,
+  type MarkerParseResult,
+} from '@/lib/rag/generation/citations/marker-parser';
+
+const ALIASES = new Set(['S1', 'S2', 'S3', 'S12']);
+
+function feedAll(chunks: string[], aliases: ReadonlySet<string> = ALIASES, textId = 'a'): MarkerParseResult {
+  const parser = createMarkerParser({ aliases });
+  for (const chunk of chunks) parser.feed(textId, chunk);
+  parser.end(textId);
+  return parser.finish();
+}
+
+function oracle(text: string, aliases: ReadonlySet<string>): MarkerParseResult {
+  const valid: string[] = [];
+  const invalidAliases: string[] = [];
+  let invalidCitations = 0;
+  for (const marker of findCitationMarkers(text)) {
+    for (const alias of marker.aliases) {
+      if (aliases.has(alias)) {
+        if (!valid.includes(alias)) valid.push(alias);
+      } else {
+        invalidCitations++;
+        if (!invalidAliases.includes(alias)) invalidAliases.push(alias);
+      }
+    }
+  }
+  return { valid, invalidCitations, invalidAliases };
+}
+
+function mulberry32(seed: number) {
+  let a = seed >>> 0;
+  return () => {
+    a = (a + 0x6d2b79f5) >>> 0;
+    let t = a;
+    t = Math.imul(t ^ (t >>> 15), t | 1);
+    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
+
+describe('createMarkerParser', () => {
+  it('validates aliases against the request set and counts unknown ones', () => {
+    const parser = createMarkerParser({ aliases: new Set(['S1', 'S2', 'S3']) });
+    parser.feed('a', 'See [S2] and [S1, S9].');
+    parser.end('a');
+    expect(parser.finish()).toEqual({ valid: ['S2', 'S1'], invalidCitations: 1, invalidAliases: ['S9'] });
+  });
+
+  it('gives the one-delta result for every single split position', () => {
+    const text = 'x [S12, S3] y【S2】z [S9]';
+    const expected = feedAll([text]);
+    expect(expected).toEqual({ valid: ['S12', 'S3', 'S2'], invalidCitations: 1, invalidAliases: ['S9'] });
+    for (let k = 0; k <= text.length; k++) {
+      expect(feedAll([text.slice(0, k), text.slice(k)]), `split at ${k}`).toEqual(expected);
+    }
+  });
+
+  it('gives the one-delta result for every pair of split positions', () => {
+    const text = 'x [S12, S3] y【S2】z［S1，S9］';
+    const expected = feedAll([text]);
+    expect(expected).toEqual({ valid: ['S12', 'S3', 'S2', 'S1'], invalidCitations: 1, invalidAliases: ['S9'] });
+    for (let i = 0; i <= text.length; i++) {
+      for (let j = i; j <= text.length; j++) {
+        expect(feedAll([text.slice(0, i), text.slice(i, j), text.slice(j)]), `splits ${i},${j}`).toEqual(expected);
+      }
+    }
+  });
+
+  it('gives the one-delta result when fed one character at a time', () => {
+    const text = 'a[S1]b[S2, S3]c【S12】d［S9、S1］e[[S2]';
+    const expected = { valid: ['S1', 'S2', 'S3', 'S12'], invalidCitations: 1, invalidAliases: ['S9'] };
+    expect(feedAll([text])).toEqual(expected);
+    expect(feedAll([...text])).toEqual(expected);
+  });
+
+  it('lists a repeated alias once, in order of first appearance, and counts every invalid repeat', () => {
+    expect(feedAll(['[S3] [S1] [S3] [S1, S3]'])).toEqual({ valid: ['S3', 'S1'], invalidCitations: 0, invalidAliases: [] });
+    expect(feedAll(['[S9][S9] [S9]'])).toEqual({ valid: [], invalidCitations: 3, invalidAliases: ['S9'] });
+  });
+
+  it('releases an unmatched opener after 16 characters and never turns it into a marker', () => {
+    const long = ['[S1, S2, S3, S1', ', S2, S3', ']'];
+    expect(feedAll(long)).toEqual(feedAll([long.join('')]));
+    expect(feedAll(long).valid).toEqual([]);
+    expect(feedAll(['[', 'x'.repeat(20), ' then [S1]'])).toEqual({ valid: ['S1'], invalidCitations: 0, invalidAliases: [] });
+  });
+
+  it('keeps each text id independent and flushes a pending opener on end', () => {
+    const parser = createMarkerParser({ aliases: ALIASES });
+    parser.feed('a', 'one [S');
+    parser.feed('b', '1] and [S2');
+    parser.feed('a', '] two');
+    parser.feed('b', ']');
+    parser.end('a');
+    parser.end('b');
+    expect(parser.finish()).toEqual({ valid: ['S2'], invalidCitations: 0, invalidAliases: [] });
+
+    const flushed = createMarkerParser({ aliases: ALIASES });
+    flushed.feed('a', 'tail [S1');
+    flushed.end('a');
+    flushed.feed('a', '] later');
+    expect(flushed.finish().valid).toEqual([]);
+  });
+
+  it('finish flushes ids that never ended and ignores input after it', () => {
+    const parser = createMarkerParser({ aliases: ALIASES });
+    parser.feed('a', 'x [S1] y [S2');
+    const result = parser.finish();
+    expect(result).toEqual({ valid: ['S1'], invalidCitations: 0, invalidAliases: [] });
+    parser.feed('a', '] [S3]');
+    expect(parser.finish()).toEqual(result);
+  });
+
+  it('only observes: feed and end return nothing', () => {
+    const parser = createMarkerParser({ aliases: ALIASES });
+    expect(parser.feed('a', 'x [S1]')).toBeUndefined();
+    expect(parser.end('a')).toBeUndefined();
+  });
+});
+
+describe('parseAnswerMarkers', () => {
+  it('equals feeding the whole text at once', () => {
+    const text = 'Paris [S1], Rome【S12】, Oslo ［S9，S2］.';
+    expect(parseAnswerMarkers(text, ALIASES)).toEqual(feedAll([text]));
+    expect(parseAnswerMarkers(text, ALIASES)).toEqual({ valid: ['S1', 'S12', 'S2'], invalidCitations: 1, invalidAliases: ['S9'] });
+  });
+
+  it('returns an empty result for text without markers', () => {
+    expect(parseAnswerMarkers('', ALIASES)).toEqual({ valid: [], invalidCitations: 0, invalidAliases: [] });
+    expect(parseAnswerMarkers('plain [text] S1', ALIASES)).toEqual({ valid: [], invalidCitations: 0, invalidAliases: [] });
+  });
+});
+
+describe('marker parser properties', () => {
+  const ALPHABET = ['[', ']', '【', '】', '［', '］', 'S', 'S', '1', '2', '3', '9', '0', ' ', ',', '，', '、', 'x', '\n', 's'];
+
+  function randomText(rand: () => number, maxLength: number): string {
+    const length = Math.floor(rand() * maxLength);
+    let out = '';
+    for (let i = 0; i < length; i++) out += ALPHABET[Math.floor(rand() * ALPHABET.length)];
+    return out;
+  }
+
+  function randomSplit(rand: () => number, text: string): string[] {
+    const cuts = new Set<number>();
+    const count = Math.floor(rand() * 6);
+    for (let i = 0; i < count; i++) cuts.add(Math.floor(rand() * (text.length + 1)));
+    const points = [0, ...[...cuts].sort((a, b) => a - b), text.length];
+    const chunks: string[] = [];
+    for (let i = 0; i < points.length - 1; i++) chunks.push(text.slice(points[i], points[i + 1]));
+    return chunks;
+  }
+
+  it('matches the grammar oracle for random text under random chunking', () => {
+    const rand = mulberry32(0x5eed);
+    const aliases = new Set(['S1', 'S2', 'S3', 'S12', 'S19']);
+    for (let n = 0; n < 3000; n++) {
+      const text = randomText(rand, 60);
+      const expected = oracle(text, aliases);
+      expect(parseAnswerMarkers(text, aliases), JSON.stringify(text)).toEqual(expected);
+      const chunks = randomSplit(rand, text);
+      expect(feedAll(chunks, aliases), JSON.stringify(chunks)).toEqual(expected);
+    }
+  });
+
+  it('matches the oracle when text is assembled from marker-heavy tokens', () => {
+    const rand = mulberry32(0xc17e);
+    const tokens = ['[S1]', '[S2, S3]', '【S12】', '［S1，S2］', '[S9]', '[S1', 'S3]', '[', ']', ' ', 'word', '、', '[S3、S1]'];
+    const aliases = new Set(['S1', 'S2', 'S3', 'S12']);
+    for (let n = 0; n < 2000; n++) {
+      let text = '';
+      const parts = Math.floor(rand() * 12);
+      for (let i = 0; i < parts; i++) text += tokens[Math.floor(rand() * tokens.length)];
+      const expected = oracle(text, aliases);
+      expect(feedAll(randomSplit(rand, text), aliases), JSON.stringify(text)).toEqual(expected);
+      expect(feedAll([...text], aliases), JSON.stringify(text)).toEqual(expected);
+    }
+  });
+});
+
+describe('marker parser adversarial input', () => {
+  const BUDGET_MS = 20_000;
+  const SIZE = 200_000;
+
+  function timed(fn: () => void): number {
+    const start = performance.now();
+    fn();
+    return performance.now() - start;
+  }
+
+  it.each([
+    ['openers only', '['.repeat(SIZE)],
+    ['unclosed alias prefix repeated', '[S1'.repeat(SIZE / 3)],
+    ['one long unclosed list', '[' + 'S1, '.repeat(SIZE / 4)],
+    ['digits without a closer', '[S' + '1'.repeat(SIZE)],
+    ['spaces without a closer', '[S1' + ' '.repeat(SIZE)],
+    ['mixed brackets', '[【［'.repeat(SIZE / 3)],
+    ['separators', '[S1' + ',，、'.repeat(SIZE / 3)],
+    ['valid markers back to back', '[S1]'.repeat(SIZE / 4)],
+  ])('stays linear for %s (one shot and char by char)', (_name, text) => {
+    const aliases = new Set(['S1']);
+    expect(timed(() => parseAnswerMarkers(text, aliases))).toBeLessThan(BUDGET_MS);
+    expect(timed(() => findCitationMarkers(text))).toBeLessThan(BUDGET_MS);
+    const small = text.slice(0, 20_000);
+    expect(
+      timed(() => {
+        const parser = createMarkerParser({ aliases });
+        for (let i = 0; i < small.length; i++) parser.feed('a', small[i]);
+        parser.finish();
+      }),
+    ).toBeLessThan(BUDGET_MS);
+  });
+
+  it('counts back-to-back markers correctly at scale', () => {
+    const aliases = new Set(['S1']);
+    const result = parseAnswerMarkers('[S1][S7]'.repeat(5000), aliases);
+    expect(result).toEqual({ valid: ['S1'], invalidCitations: 5000, invalidAliases: ['S7'] });
+  });
+});
