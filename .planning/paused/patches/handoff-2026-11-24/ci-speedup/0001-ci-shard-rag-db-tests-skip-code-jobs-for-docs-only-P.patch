diff --git a/scripts/ci/classify-changes.mjs b/scripts/ci/classify-changes.mjs
new file mode 100644
index 0000000..f069cfb
--- /dev/null
+++ b/scripts/ci/classify-changes.mjs
@@ -0,0 +1,33 @@
+import { appendFileSync } from 'node:fs';
+import { spawnSync } from 'node:child_process';
+import { pathToFileURL } from 'node:url';
+
+// Paths no test or build step reads. Markdown elsewhere (AGENTS.md, CLAUDE.md,
+// README_*.md, supabase/README.md, eval fixtures) is test input, so it counts as code.
+const DOCS_PREFIXES = ['.planning/'];
+const DOCS_FILES = new Set(['CONTRIBUTING.md', 'HANDOFF.md', 'SECURITY.md', 'TRADEMARKS.md', 'THIRD_PARTY_NOTICES.md', 'LICENSE']);
+
+export function isDocsPath(file) {
+  return DOCS_FILES.has(file) || DOCS_PREFIXES.some((prefix) => file.startsWith(prefix));
+}
+
+export function needsCodeJobs(files) {
+  const changed = files.map((f) => f.trim()).filter(Boolean);
+  if (changed.length === 0) return true;
+  return changed.some((file) => !isDocsPath(file));
+}
+
+function decide(env) {
+  if (env.EVENT_NAME !== 'pull_request') return { code: true, reason: `event ${env.EVENT_NAME || 'unknown'} always runs everything` };
+  const diff = spawnSync('git', ['diff', '--name-only', 'HEAD^1', 'HEAD'], { encoding: 'utf8' });
+  if (diff.status !== 0) return { code: true, reason: 'git diff failed, running everything' };
+  const files = diff.stdout.split('\n').filter(Boolean);
+  const code = needsCodeJobs(files);
+  return { code, reason: `${files.length} changed file(s), ${code ? 'code present' : 'docs only'}` };
+}
+
+if (process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href) {
+  const { code, reason } = decide(process.env);
+  console.log(`classify-changes: code=${code} (${reason})`);
+  if (process.env.GITHUB_OUTPUT) appendFileSync(process.env.GITHUB_OUTPUT, `code=${code}\n`);
+}
