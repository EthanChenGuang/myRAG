new file mode 100644
index 0000000..4a7dd97
--- /dev/null
+++ b/scripts/ci/shard-tests.mjs
@@ -0,0 +1,67 @@
+import { readdirSync } from 'node:fs';
+import { join } from 'node:path';
+
+// Usage:
+//   node scripts/ci/shard-tests.mjs --dir tests/rag-db --total 4 --shard 2   (print one shard, one path per line)
+//   node scripts/ci/shard-tests.mjs --dir tests/rag-db --total 4 --check     (assert the shards partition the directory)
+
+export function listTests(dir) {
+  return readdirSync(dir)
+    .filter((name) => name.endsWith('.test.mts'))
+    .sort()
+    .map((name) => join(dir, name));
+}
+
+export function shardOf(files, shard, total) {
+  return files.filter((_, index) => index % total === shard - 1);
+}
+
+export function checkPartition(files, total) {
+  const seen = new Map();
+  for (let shard = 1; shard <= total; shard += 1) {
+    for (const file of shardOf(files, shard, total)) seen.set(file, (seen.get(file) ?? 0) + 1);
+  }
+  const problems = [];
+  for (const file of files) if (seen.get(file) !== 1) problems.push(`${file} runs ${seen.get(file) ?? 0} times`);
+  for (const file of seen.keys()) if (!files.includes(file)) problems.push(`${file} is not in the directory`);
+  return problems;
+}
+
+function arg(name) {
+  const index = process.argv.indexOf(`--${name}`);
+  return index === -1 ? undefined : process.argv[index + 1];
+}
+
+if (process.argv[1] && import.meta.url === new URL(`file://${process.argv[1]}`).href) {
+  const dir = arg('dir');
+  const total = Number(arg('total'));
+  if (!dir || !Number.isInteger(total) || total < 1) {
+    console.error('shard-tests: --dir and a positive integer --total are required');
+    process.exit(2);
+  }
+  const files = listTests(dir);
+  if (files.length === 0) {
+    console.error(`shard-tests: no *.test.mts files in ${dir}`);
+    process.exit(1);
+  }
+  if (process.argv.includes('--check')) {
+    const problems = checkPartition(files, total);
+    if (problems.length) {
+      console.error(`shard-tests: FAILED\n${problems.join('\n')}`);
+      process.exit(1);
+    }
+    console.log(`shard-tests: ${files.length} files covered exactly once across ${total} shards`);
+  } else {
+    const shard = Number(arg('shard'));
+    if (!Number.isInteger(shard) || shard < 1 || shard > total) {
+      console.error('shard-tests: --shard must be between 1 and --total');
+      process.exit(2);
+    }
+    const mine = shardOf(files, shard, total);
+    if (mine.length === 0) {
+      console.error(`shard-tests: shard ${shard}/${total} is empty`);
+      process.exit(1);
+    }
+    console.log(mine.join('\n'));
+  }
+}
