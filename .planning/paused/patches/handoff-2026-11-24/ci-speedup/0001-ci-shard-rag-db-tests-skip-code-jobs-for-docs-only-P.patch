+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { needsCodeJobs } from '../ci/classify-changes.mjs';
+import { checkPartition, shardOf } from '../ci/shard-tests.mjs';
+
+test('docs-only changes skip the code jobs', () => {
+  assert.equal(needsCodeJobs(['.planning/STATE.md', '.planning/phases/x/PLAN.md']), false);
+  assert.equal(needsCodeJobs(['HANDOFF.md', 'LICENSE']), false);
+});
+
+test('anything else, including markdown read by tests, runs the code jobs', () => {
+  assert.equal(needsCodeJobs(['.planning/a.md', 'src/a.ts']), true);
+  assert.equal(needsCodeJobs(['AGENTS.md']), true);
+  assert.equal(needsCodeJobs(['CLAUDE.md']), true);
+  assert.equal(needsCodeJobs(['README_VOICE_INTEGRATION.md']), true);
+  assert.equal(needsCodeJobs(['supabase/README.md']), true);
+  assert.equal(needsCodeJobs(['eval/fixtures/ingest/text/contract-zh.md']), true);
+  assert.equal(needsCodeJobs(['.github/workflows/pr-smoke.yml']), true);
+  assert.equal(needsCodeJobs(['.planning-evil/x.md']), true);
+});
+
+test('an empty change list runs everything', () => {
+  assert.equal(needsCodeJobs([]), true);
+});
+
+test('shards partition the file list exactly once', () => {
+  const files = Array.from({ length: 23 }, (_, i) => `t/${String(i).padStart(2, '0')}.test.mts`);
+  for (const total of [1, 3, 4, 7]) {
+    assert.deepEqual(checkPartition(files, total), []);
+    const union = Array.from({ length: total }, (_, i) => shardOf(files, i + 1, total)).flat().sort();
+    assert.deepEqual(union, files);
+  }
+});
