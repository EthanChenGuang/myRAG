+interface RenderEntry {
+  chunkId: string;
+  documentId: string;
+  label: string;
+  body: string;
+  isImage: boolean;
+  page: number | null;
+  sectionPath: string[] | null;
+  version: number | null;
+}
+
+function blockTitle(name: string, page: number | null, sectionPath: string[] | null): string {
+  return `${name}${page !== null ? `, p.${page}` : ''}${sectionPath && sectionPath.length > 0 ? ` / ${sectionPath.join(' > ')}` : ''}`;
+}
+
+function numberOrNull(value: unknown): number | null {
+  return typeof value === 'number' && Number.isFinite(value) ? value : null;
+}
+
+function sectionPathOf(value: unknown): string[] | null {
+  if (!Array.isArray(value)) return null;
+  const parts = value.filter((part): part is string => typeof part === 'string');
+  return parts.length > 0 ? parts : null;
+}
+
+/** Consecutive entries of one run become one unit; image entries always stand alone. */
+function renderUnits(entries: RenderEntry[], runs: string[][] | undefined): RenderEntry[][] {
+  const runOf = new Map<string, number>();
+  runs?.forEach((run, index) => run.forEach((chunkId) => runOf.set(chunkId, index)));
+  const units: RenderEntry[][] = [];
+  for (const entry of entries) {
+    const last = units[units.length - 1];
+    const previous = last?.[last.length - 1];
+    const run = runOf.get(entry.chunkId);
+    if (last && previous && !entry.isImage && !previous.isImage && run !== undefined && run === runOf.get(previous.chunkId)) {
+      last.push(entry);
+    } else {
+      units.push([entry]);
+    }
+  }
+  return units;
+}
+
+function unitBlock(
+  unit: RenderEntry[],
+  docName: string,
+  covered: Map<string, string[]> | undefined,
+): Omit<ContextBlock, 'alias'> {
+  const first = unit[0]!;
+  const chunkIds: string[] = [];
+  for (const entry of unit) {
+    for (const id of covered?.get(entry.chunkId) ?? [entry.chunkId]) {
+      if (!chunkIds.includes(id)) chunkIds.push(id);
+    }
+  }
+  return {
+    documentId: first.documentId,
+    documentName: docName,
+    documentVersion: first.version,
+    chunkIds,
+    page: first.page,
+    sectionPath: first.sectionPath,
+    title: blockTitle(docName, first.page, first.sectionPath),
+    text: unit.map((entry) => entry.body).join('\n\n'),
+    isImage: first.isImage,
+  };
+}
+
+/** Blocks for the referenced sections; with a labeler the section is re-rendered in place with its header. */
+function referencedBlocks(
+  referencedContext: string,
+  sections: ReferencedSection[] | undefined,
+  labeler: CitationLabeler | undefined,
+): { context: string; blocks: ContextBlock[]; ordinal: number } {
+  const blocks: ContextBlock[] = [];
+  let context = '';
+  let cursor = 0;
+  let ordinal = 0;
+  for (const section of sections ?? []) {
+    const rendered = renderReferencedSection(section.documentName, section.text);
+    const at = referencedContext.indexOf(rendered, cursor);
+    if (at < 0) continue;
+    const block: Omit<ContextBlock, 'alias'> = {
+      documentId: section.documentId,
+      documentName: section.documentName,
+      documentVersion: null,
+      chunkIds: [...section.chunkIds],
+      page: null,
+      sectionPath: null,
+      title: section.documentName,
+      text: section.text,
+      isImage: false,
+    };
+    if (labeler) {
+      ordinal += 1;
+      const label = labeler(block, ordinal);
+      context += referencedContext.slice(cursor, at) + renderReferencedSection(section.documentName, label.text, label.header);
+      blocks.push({ ...block, text: label.text, alias: label.alias });
+    } else {
+      blocks.push({ ...block, alias: null });
+    }
+    cursor = at + rendered.length;
+  }
+  return { context: labeler && blocks.length > 0 ? context + referencedContext.slice(cursor) : referencedContext, blocks, ordinal };
+}
