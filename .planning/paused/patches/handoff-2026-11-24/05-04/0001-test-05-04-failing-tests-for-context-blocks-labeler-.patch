+
+const USER_A = '00000000-0000-4000-8000-0000000000a1';
+const DOC_A = '00000000-0000-4000-8000-0000000000d1';
+const DOC_FULL = '00000000-0000-4000-8000-0000000000d2';
+
+function fakeRefAdmin() {
+  const tables: Record<string, Array<Record<string, unknown>>> = {
+    documents: [
+      { id: DOC_A, filename: 'alpha.md', created_at: null, content: 'alpha text', user_id: USER_A, organization_id: null, metadata: {}, is_current: true, status: 'ready' },
+      { id: DOC_FULL, filename: 'full.md', created_at: null, content: 'full document text', text: 'full document text', user_id: USER_A, organization_id: null, metadata: {}, is_current: true, status: 'ready' },
+    ],
+    document_chunks: [
+      { id: 'chunk-a1', document_id: DOC_A, content: 'alpha one', is_current: true, status: 'ready' },
+      { id: 'chunk-a2', document_id: DOC_A, content: 'alpha two', is_current: true, status: 'ready' },
+    ],
+  };
+  const admin = {
+    from(table: string) {
+      const predicates: Array<(r: Record<string, unknown>) => boolean> = [];
+      let columns: string[] | null = null;
+      let single = false;
+      const builder: Record<string, unknown> = {};
+      builder.select = (list: string) => {
+        columns = list === '*' ? null : list.split(',').map((c) => c.trim());
+        return builder;
+      };
+      builder.eq = (column: string, value: unknown) => {
+        predicates.push((r) => r[column] === value);
+        return builder;
+      };
+      builder.is = (column: string, value: unknown) => {
+        predicates.push((r) => (r[column] ?? null) === value);
+        return builder;
+      };
+      builder.ilike = () => builder;
+      builder.limit = () => builder;
+      builder.single = () => {
+        single = true;
+        return builder;
+      };
+      builder.abortSignal = () => builder;
+      builder.then = (ok: (v: unknown) => unknown, bad?: (e: unknown) => unknown) => {
+        const matched = (tables[table] ?? []).filter((r) => predicates.every((p) => p(r)));
+        const projected = matched.map((r) => (columns ? Object.fromEntries(columns.map((c) => [c, r[c]])) : { ...r }));
+        const response = single
+          ? projected.length === 1
+            ? { data: projected[0], error: null }
+            : { data: null, error: { message: 'no row', code: 'PGRST116' } }
+          : { data: projected, error: null };
+        return Promise.resolve(response).then(ok, bad);
+      };
+      return builder;
+    },
+  };
+  return admin as unknown as SupabaseClient;
+}
+
+describe('resolveDocumentRefs sections', () => {
+  beforeEach(() => {
+    vi.spyOn(console, 'log').mockImplementation(() => undefined);
+  });
+  afterEach(() => {
+    vi.restoreAllMocks();
+  });
+
+  it('returns the unchanged context plus one section per rendered document in render order', async () => {
+    const result = await resolveDocumentRefs({
+      scope: mintScope('personal', USER_A, null),
+      mentions: [],
+      documentParts: [{ id: DOC_A, name: 'alpha.md' }],
+      admin: fakeRefAdmin(),
+      signal: new AbortController().signal,
+    });
+    expect(result.context).toBe('\n\n=== DOCUMENT: "alpha.md" ===\nalpha one\n\nalpha two\n=== END OF DOCUMENT ===\n');
+    expect(result.sections).toEqual([
+      { documentId: DOC_A, documentName: 'alpha.md', chunkIds: ['chunk-a1', 'chunk-a2'], text: 'alpha one\n\nalpha two' },
+    ]);
+  });
+
+  it('lists no chunk ids when the full document text was used', async () => {
+    const result = await resolveDocumentRefs({
+      scope: mintScope('personal', USER_A, null),
+      mentions: [],
+      documentParts: [{ id: DOC_FULL, name: 'full.md' }],
+      admin: fakeRefAdmin(),
+      signal: new AbortController().signal,
+    });
+    expect(result.context).toBe('\n\n=== DOCUMENT: "full.md" ===\nfull document text\n=== END OF DOCUMENT ===\n');
+    expect(result.sections).toEqual([{ documentId: DOC_FULL, documentName: 'full.md', chunkIds: [], text: 'full document text' }]);
+  });
+});
+
+describe('runRetrieval under RAG_PIPELINE=legacy with a labeler', () => {
+  const scope = mintScope('single', null, null);
+
+  beforeEach(() => {
+    uninstallDeps();
+    vi.spyOn(console, 'log').mockImplementation(() => undefined);
+    vi.spyOn(console, 'warn').mockImplementation(() => undefined);
