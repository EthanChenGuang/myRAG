+    expect(labelled.blocks?.map((block) => block.alias)).toEqual(['S1', 'S2', 'S3']);
+    expect(labelled.blocks?.map((block) => block.text)).toEqual(['FIXTURE CHUNK BODY 1', 'FIXTURE CHUNK BODY 2', 'FIXTURE CHUNK BODY 3']);
+    expect(labelled.usedDocuments).toEqual(plain.usedDocuments);
+    expect(labelled.kept).toEqual(plain.kept);
+    expect(labelled.sourceImages).toEqual(plain.sourceImages);
