+/** A parent block stands for every top candidate that points at that parent, in rank order. */
+function coveredChunkIds(selected: Candidate[], candidates: Candidate[], parentChunkIds: Set<string> | undefined): Map<string, string[]> {
+  const covered = new Map<string, string[]>();
+  if (!parentChunkIds?.size) return covered;
+  for (const chosen of selected) {
+    if (!parentChunkIds.has(chosen.chunk_id) || !chosen.parent_id) continue;
+    covered.set(
+      chosen.chunk_id,
+      candidates
+        .filter((candidate) => candidate.parent_id === chosen.parent_id && candidate.document_id === chosen.document_id)
+        .map((candidate) => candidate.chunk_id),
+    );
+  }
+  return covered;
+}
