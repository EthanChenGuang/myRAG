Claude-Session: https://claude.ai/code/session_01X342shLsAZx6PYph2vA7hc
---
 eval/tests/test_ingest_golden.py | 56 +++++++++++++++++++++++++++++++-
 1 file changed, 55 insertions(+), 1 deletion(-)

diff --git a/eval/tests/test_ingest_golden.py b/eval/tests/test_ingest_golden.py
index 2c3f2cd..3aad925 100644
--- a/eval/tests/test_ingest_golden.py
+++ b/eval/tests/test_ingest_golden.py
@@ -48,4 +48,58 @@ def test_golden_ingest_items_validate_and_quotes_live_in_fixture_text(manifest_d
             continue
         for span in item.gold_evidence:
             haystack = manifest_documents.get(span.document, "")
-            assert span.quote in haystack, f"{item.id}: quote missing from {span.document}"
\ No newline at end of file
+            assert span.quote in haystack, f"{item.id}: quote missing from {span.document}"
+
+LEGACY_INGEST_IDS = {
+    "ingest-table-header-zh",
+    "ingest-scan-zh",
+    "ingest-scan-en",
+    "ingest-scan-it",
+    "ingest-contract-exception-zh",
+    "ingest-invoice-zh",
+    "ingest-invoice-en",
+    "ingest-invoice-it",
+    "ingest-image-caption-en",
+    "ingest-injection-zh-no-answer",
+    "ingest-injection-en-no-answer",
+    "ingest-injection-it-no-answer",
+}
+CONTRACT_DOCUMENT = "contract-zh.pdf"
+
+
+def _clauses(text: str) -> list[str]:
+    parts = text.split("\n### ")
+    return [part for part in parts[1:] if part.startswith("第")]
+
+
+def _clause_items():
+    return [item for item in load_golden(GOLDEN) if "clause" in item.tags]
+
+
+def test_legacy_ingest_items_are_still_present():
+    assert LEGACY_INGEST_IDS <= {item.id for item in load_golden(GOLDEN)}
+    assert all("clause" not in item.tags for item in load_golden(GOLDEN) if item.id in LEGACY_INGEST_IDS)
+
+
+def test_at_least_four_clause_items_cover_zh_en_and_it_on_the_contract():
+    items = _clause_items()
+    assert len(items) >= 4
+    assert sum(1 for item in items if item.language == "zh") >= 2
+    for language in ("en", "it"):
+        matching = [item for item in items if item.language == language]
+        assert matching, language
+        assert all(item.category == "cross_lingual" and item.evidence_language == "zh" for item in matching)
+    for item in items:
+        assert item.answerable and item.review_status == "approved" and item.provenance == "synthetic_fixture"
+        assert {span.document for span in item.gold_evidence} == {CONTRACT_DOCUMENT}
+
+
+def test_each_clause_item_quote_lies_inside_exactly_one_clause(manifest_documents: dict[str, str]):
+    clauses = _clauses(manifest_documents[CONTRACT_DOCUMENT])
+    assert len(clauses) >= 3
+    items = _clause_items()
+    assert items
+    for item in items:
+        for span in item.gold_evidence:
+            holders = [clause for clause in clauses if span.quote in clause]
+            assert len(holders) == 1, f"{item.id}: quote must lie inside one clause"
