+++ b/eval/src/rag_eval/item_parity.py
@@ -0,0 +1,49 @@
+import argparse
+import json
+import sys
+from dataclasses import dataclass
+from pathlib import Path
+
+
+@dataclass(frozen=True)
+class ItemParity:
+    changed: list[str]
+    missing: list[str]
+    added: list[str]
+
+    @property
+    def all_zero(self) -> bool:
+        return not self.changed and not self.missing
+
+
+def compare_items(before: dict, after: dict) -> ItemParity:
+    old = before["items"]
+    new = after["items"]
+    return ItemParity(
+        changed=sorted(item_id for item_id in old if item_id in new and old[item_id] != new[item_id]),
+        missing=sorted(item_id for item_id in old if item_id not in new),
+        added=sorted(item_id for item_id in new if item_id not in old),
+    )
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(
+        prog="rag_eval.item_parity",
+        description="fail when a pre-existing item's per-item result differs between two baselines",
+    )
+    parser.add_argument("before", type=Path)
+    parser.add_argument("after", type=Path)
+    args = parser.parse_args(argv)
+    result = compare_items(
+        json.loads(args.before.read_text(encoding="utf-8")),
+        json.loads(args.after.read_text(encoding="utf-8")),
+    )
