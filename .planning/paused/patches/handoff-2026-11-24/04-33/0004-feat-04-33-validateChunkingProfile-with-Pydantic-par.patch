@@ -78,6 +78,9 @@ export function resetEmbeddingProvidersForTests(): void {
   defaults = null;
 }
 
-export function maxInputTokensFor(_providerId: string): number {
-  return 0;
+/** The documented input limit of a provider's embedding model, in tokens. Unknown ids throw. */
+export function maxInputTokensFor(providerId: string): number {
+  const provider = findProvider(providerId);
+  if (!provider) throw new Error(`[Embedding Profile] unknown provider ${providerId}`);
+  return provider.maxInputTokens;
 }
