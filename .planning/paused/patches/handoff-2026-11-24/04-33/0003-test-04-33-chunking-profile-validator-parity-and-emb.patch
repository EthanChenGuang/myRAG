+import fs from 'node:fs';
+import path from 'node:path';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import type { EmbeddingProfile } from '@/lib/rag/embeddings/active-profile';
+import { resetRagConfigForTests } from '@/lib/rag/config';
+import { resetRagDepsForTests, setRagDepsForTests } from '@/lib/rag/deps';
+
+const activeProfile = vi.hoisted(() => ({ provider: 'openai' as string }));
+
+vi.mock('@/lib/rag/embeddings/active-profile', async (importOriginal) => {
+  const actual = await importOriginal<typeof import('@/lib/rag/embeddings/active-profile')>();
+  return { ...actual, getActiveProfile: async () => ({ ...actual.LEGACY_PROFILE, provider: activeProfile.provider }) as EmbeddingProfile };
+});
+
+import { validateChunkingProfile } from '@/lib/rag/chunking/validate';
+
+interface CaseRow {
+  input: Record<string, unknown>;
+  errors: string[];
+  warnings: string[];
+}
+
+interface CaseTable {
+  cases: CaseRow[];
+  default_context: { max_child_tokens: number; top_k: number; context_budget: number };
+}
+
+const TABLE = JSON.parse(fs.readFileSync(path.resolve(__dirname, '../../../rag-sidecar/schemas/chunking-profile-cases.json'), 'utf8')) as CaseTable;
+
+const codes = (findings: { code: string }[]): string[] => findings.map((finding) => finding.code).sort();
+
+beforeEach(() => {
+  activeProfile.provider = 'openai';
+  resetRagConfigForTests();
+  setRagDepsForTests({ ragEnv: () => ({}) });
+});
+
+afterEach(() => {
+  resetRagDepsForTests();
+  resetRagConfigForTests();
+});
+
+describe('validateChunkingProfile parity with chunking-profile-cases.json (Pydantic)', () => {
+  it('reads a case table with every error and warning code', () => {
+    expect(TABLE.cases.length).toBeGreaterThanOrEqual(5);
+  });
+
+  for (const [index, row] of TABLE.cases.entries()) {
+    it(`case ${index} ${String(row.input.id)} gives errors [${row.errors.join(',')}] and warnings [${row.warnings.join(',')}]`, async () => {
+      const result = await validateChunkingProfile(row.input, {
+        maxChildTokens: TABLE.default_context.max_child_tokens,
+        topK: TABLE.default_context.top_k,
+        contextBudget: TABLE.default_context.context_budget,
+      });
+      expect(codes(result.errors)).toEqual([...row.errors].sort());
+      expect(codes(result.warnings)).toEqual([...row.warnings].sort());
+    });
+  }
+});
+
+describe('validateChunkingProfile context', () => {
+  const child9000 = { id: 'big-child', doc_type: 'general', child_tokens: 9000, parent_mode: 'none', parent_tokens: null, status: 'building', preset: 'custom' };
+
+  it('takes the child limit from the active embedding profile provider when none is given', async () => {
+    activeProfile.provider = 'openai';
+    expect(codes((await validateChunkingProfile(child9000)).errors)).toEqual(['child_exceeds_embedding_input']);
+    activeProfile.provider = 'voyage';
+    expect((await validateChunkingProfile(child9000)).errors).toEqual([]);
+    activeProfile.provider = 'qwen3';
+    expect((await validateChunkingProfile({ ...child9000, child_tokens: 32769 })).errors.map((e) => e.code)).toEqual(['child_exceeds_embedding_input']);
+  });
+
+  it('takes top_k from the effective retrieval params and the budget from RAG_CONTEXT_TOKEN_BUDGET', async () => {
+    const profile = { id: 'p', doc_type: 'general', child_tokens: 256, parent_mode: 'structure', parent_tokens: 1024, status: 'building', preset: '256/1024' };
+    expect(codes((await validateChunkingProfile(profile)).warnings)).toEqual(['top_k_parent_over_budget']);
+    resetRagConfigForTests();
+    setRagDepsForTests({ ragEnv: () => ({ RAG_CONTEXT_TOKEN_BUDGET: '9000' }) });
+    expect((await validateChunkingProfile(profile)).warnings).toEqual([]);
+  });
+
+  it('an explicit context value wins over the default', async () => {
+    activeProfile.provider = 'voyage';
+    const result = await validateChunkingProfile(child9000, { maxChildTokens: 8191 });
+    expect(codes(result.errors)).toEqual(['child_exceeds_embedding_input']);
+  });
+
+  it('reports a malformed profile as one invalid_shape error instead of throwing', async () => {
+    const result = await validateChunkingProfile({ id: '', doc_type: 'memo', child_tokens: 0 });
+    expect(codes(result.errors)).toEqual(['invalid_shape']);
+    expect(result.warnings).toEqual([]);
+  });
+
+  it('gives every finding a message without echoing input values', async () => {
+    const result = await validateChunkingProfile(child9000, { maxChildTokens: 8191 });
+    expect(result.errors[0]?.message.length).toBeGreaterThan(10);
+  });
+});
