+  it('returns the documented input limit of each registered provider', () => {
+    expect(maxInputTokensFor('openai')).toBe(8191);
+    expect(maxInputTokensFor('voyage')).toBe(32000);
+    expect(maxInputTokensFor('qwen3')).toBe(32768);
