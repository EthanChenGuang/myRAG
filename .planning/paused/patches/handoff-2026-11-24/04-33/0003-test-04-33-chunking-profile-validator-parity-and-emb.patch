+
+  it('follows a provider swapped in for a test and throws for an unknown id', () => {
+    setEmbeddingProvidersForTests({
+      openai: {
+        id: 'openai',
+        model: 'fake-model',
+        maxInputTokens: 123,
+        supportedDims: [1536],
+        normalize: true,
+        embedDocuments: async () => ({ vectors: [], model: 'fake-model', host: 'fake', usage: { tokens: 0 } }),
+        embedQuery: async () => ({ vectors: [], model: 'fake-model', host: 'fake', usage: { tokens: 0 } }),
+      },
+    });
+    expect(maxInputTokensFor('openai')).toBe(123);
+    expect(() => maxInputTokensFor('cohere')).toThrow('[Embedding Profile] unknown provider cohere');
+    expect(() => maxInputTokensFor('__proto__')).toThrow(/unknown provider/);
+  });
+});
