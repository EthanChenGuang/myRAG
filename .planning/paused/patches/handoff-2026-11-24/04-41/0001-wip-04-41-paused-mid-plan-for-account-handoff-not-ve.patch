+import { createHash } from 'node:crypto';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import type { PGlite } from '@electric-sql/pglite';
+import { chunkLexicalText, lexicalTokens } from '../../src/lib/rag/lexical/chunk-text';
+import { embedText } from './fixture-embedder.mts';
+import { createFixtureDatabase, type DeploymentMode, type FixtureDatabase } from './pglite-supabase.mts';
+import { TWO_TENANT_IDS, createTwoTenantDatabase, type TwoTenantDatabase } from './two-tenant.mts';
+
+const REPO_ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../..');
+const DEFAULT_CORPUS_DIR = path.join(REPO_ROOT, 'eval/fixtures/corpus');
+
+export const V2_LEGACY_EMBEDDING_PROFILE = 'openai-3-small-1536';
+/** The non-legacy chunking profile every tenant's canary document is also written under, made the active profile of its doc type. */
+export const V2_CHUNKING_PROFILE = 'p-canary-256';
+export const V2_CANARY_PHRASE = 'Two tenant isolation canary phrase';
+/** Identical in every tenant: only the tenant marker next to it tells the copies apart. */
+export const V2_EXACT_CODE = 'SKU-CANARY-4417';
+export const V2_TRANSLATED_QUERY = { text: 'frase canarino isolamento tenant', language: 'it' } as const;
+/** A doc type each tenant has and the others lack. */
+export const V2_PRIVATE_DOC_TYPE = { A: 'product_technical', B: 'financial_report', O: 'contract_legal', S: 'contract_legal' } as const;
+/** The same supplier and invoice number in every tenant. */
+export const V2_INVOICE = { supplier: 'Fornitore Canary', number: 'INV-CANARY-0001', gross: 500, currency: 'EUR' } as const;
+/** Only the tenant itself holds the answer to its topic question. */
+export const V2_TOPICS: Record<'A' | 'B' | 'O' | 'S', { question: string; text: string }> = {
+  A: { question: 'quokka habitat survey nesting sites counted', text: 'The quokka habitat survey counted eleven nesting sites' },
+  B: { question: 'zephyr turbine maintenance interval hours', text: 'The zephyr turbine maintenance interval is every 4400 hours' },
+  O: { question: 'nautilus archive retention period years', text: 'The nautilus archive retention period is seven years' },
+  S: { question: 'meerkat sentinel rota weekends hours', text: 'The meerkat sentinel rota on weekends alternates every two hours' },
+};
+
+export type V2TenantLabel = 'A' | 'B' | 'O' | 'S';
+
+export interface V2Tenant {
+  label: V2TenantLabel;
+  /** The tenant key the SQL functions take. */
+  key: string;
+  userId: string | null;
+  organizationId: string | null;
+  /** Appears in every text of this tenant and in no text of another tenant. */
+  marker: string;
+  imageUrl: string;
+  /** Every image url a result of this tenant may carry: its own mark, and for O the logo of the Phase 2 organization document. */
+  imageUrls: string[];
+  /** The Phase 2 canary document and its legacy chunk. */
+  docId: string;
+  legacyChunkId: string;
+  skuDocId: string;
+  skuChunkId: string;
+  imageDocId: string;
+  imageChunkId: string;
+  italianDocId: string;
+  italianChunkId: string;
+  privateTypeDocId: string;
+  privateTypeChunkId: string;
+  privateDocType: string;
+  invoiceDocId: string;
+  invoiceChunkId: string;
+  topicDocId: string;
+  topicChunkId: string;
+  topicQuestion: string;
+  parentId: string;
+  childIds: string[];
+}
+
+export type TwoTenantV2Database = TwoTenantDatabase & {
+  deploymentMode: DeploymentMode;
+  tenants: V2Tenant[];
+  tenant(label: V2TenantLabel): V2Tenant;
+};
+
+const CREATED_AT = '2025-01-15T00:00:00.000Z';
+
+const MARKERS: Record<V2TenantLabel, string> = {
+  A: 'alpha personal notes',
+  B: 'bravo personal notes',
+  O: 'organization shared handbook',
+  S: 'single tenant default notes',
+};
+
+const SLOT: Record<V2TenantLabel, number> = { A: 1, B: 2, O: 3, S: 4 };
+
+function rowId(group: number, label: V2TenantLabel): string {
+  return `00000000-0000-4000-8000-${String(group).padStart(6, '0')}${String(SLOT[label]).padStart(6, '0')}`;
+}
+
+function vectorLiteral(values: number[]): string {
+  return `[${values.join(',')}]`;
+}
+
+function describeTenant(label: V2TenantLabel): Omit<V2Tenant, 'parentId' | 'childIds'> {
+  const ids = TWO_TENANT_IDS;
+  const identity: Record<V2TenantLabel, Pick<V2Tenant, 'key' | 'userId' | 'organizationId' | 'docId' | 'legacyChunkId'>> = {
+    A: { key: `u:${ids.userA}`, userId: ids.userA, organizationId: null, docId: ids.docA, legacyChunkId: ids.chunkA },
+    B: { key: `u:${ids.userB}`, userId: ids.userB, organizationId: null, docId: ids.docB, legacyChunkId: ids.chunkB },
+    O: { key: `o:${ids.orgO}`, userId: ids.userA, organizationId: ids.orgO, docId: ids.docO, legacyChunkId: ids.chunkO },
+    S: { key: 's:default', userId: null, organizationId: null, docId: rowId(400, 'S'), legacyChunkId: rowId(401, 'S') },
+  };
+  return {
+    label,
+    ...identity[label],
+    marker: MARKERS[label],
+    imageUrl: `https://example.invalid/two-tenant-v2/tenant-${label.toLowerCase()}/mark.png`,
+    imageUrls: [
+      `https://example.invalid/two-tenant-v2/tenant-${label.toLowerCase()}/mark.png`,
+      ...(label === 'O' ? ['https://example.invalid/logo.png'] : []),
+    ],
+    skuDocId: rowId(410, label),
+    skuChunkId: rowId(411, label),
+    imageDocId: rowId(420, label),
+    imageChunkId: rowId(421, label),
+    italianDocId: rowId(430, label),
+    italianChunkId: rowId(431, label),
+    privateTypeDocId: rowId(440, label),
+    privateTypeChunkId: rowId(441, label),
+    privateDocType: V2_PRIVATE_DOC_TYPE[label],
+    invoiceDocId: rowId(450, label),
+    invoiceChunkId: rowId(451, label),
+    topicDocId: rowId(460, label),
+    topicChunkId: rowId(461, label),
+    topicQuestion: V2_TOPICS[label].question,
+  };
+}
+
+/** The deterministic row ids rag_write_profile_chunks gives parents and children (the first 16 bytes of a sha256 as a UUID). */
+function profileRowId(documentId: string, kind: 'parent' | 'child', index: number): string {
+  const hex = createHash('sha256').update(`${documentId}:${V2_CHUNKING_PROFILE}:${kind}:${index}`, 'utf8').digest('hex').slice(0, 32);
+  return `${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(16, 20)}-${hex.slice(20, 32)}`;
+}
+
+interface ExtraDocument {
+  docId: string;
+  chunkId: string;
+  filename: string;
+  docType: string;
+  text: string;
+  chunkMetadata: Record<string, unknown>;
+  chunkKind: 'text' | 'image' | 'invoice_header';
+  language: string | null;
+  invoice?: boolean;
+}
+
+function extraDocuments(tenant: Omit<V2Tenant, 'parentId' | 'childIds'>): ExtraDocument[] {
+  const slug = tenant.label.toLowerCase();
+  const canary = `${V2_CANARY_PHRASE}: ${tenant.marker}`;
+  return [
+    {
+      docId: tenant.skuDocId,
+      chunkId: tenant.skuChunkId,
+      filename: `tenant-${slug}-sku.md`,
+      docType: 'general',
+      text: `${canary}. Reference code ${V2_EXACT_CODE} applies to this canary.`,
+      chunkMetadata: { name: `Reference ${slug}` },
+      chunkKind: 'text',
+      language: 'en',
+    },
+    {
+      docId: tenant.imageDocId,
+      chunkId: tenant.imageChunkId,
+      filename: `tenant-${slug}-image.md`,
+      docType: 'scanned_image',
+      text: `Image: ${canary} brand logo mark`,
+      chunkMetadata: { name: `Logo ${slug}`, image_context: `brand logo mark ${tenant.marker}`, image_url: tenant.imageUrl },
+      chunkKind: 'image',
+      language: 'en',
+    },
+    {
+      docId: tenant.italianDocId,
+      chunkId: tenant.italianChunkId,
+      filename: `tenant-${slug}-it.md`,
+      docType: 'general',
+      text: `Frase canarino isolamento tenant: ${tenant.marker}. Il manuale condiviso resta riservato.`,
+      chunkMetadata: { name: `Italiano ${slug}` },
+      chunkKind: 'text',
+      language: 'it',
+    },
+    {
+      docId: tenant.privateTypeDocId,
+      chunkId: tenant.privateTypeChunkId,
+      filename: `tenant-${slug}-private-type.md`,
+      docType: tenant.privateDocType,
+      text: `${canary} ledger of the ${tenant.privateDocType} kind`,
+      chunkMetadata: { name: `Private type ${slug}` },
+      chunkKind: 'text',
+      language: 'en',
+    },
+    {
+      docId: tenant.invoiceDocId,
+      chunkId: tenant.invoiceChunkId,
+      filename: `tenant-${slug}-invoice.md`,
+      docType: 'invoice_receipt',
+      text: `fattura ${V2_INVOICE.supplier} numero ${V2_INVOICE.number} importo ${V2_INVOICE.gross} ${canary}`,
+      chunkMetadata: { name: `Invoice ${slug}` },
+      chunkKind: 'invoice_header',
+      language: 'it',
+      invoice: true,
+    },
+    {
+      docId: tenant.topicDocId,
+      chunkId: tenant.topicChunkId,
+      filename: `tenant-${slug}-topic.md`,
+      docType: 'general',
+      text: `${V2_TOPICS[tenant.label].text} (${tenant.marker}).`,
+      chunkMetadata: { name: `Topic ${slug}` },
+      chunkKind: 'text',
+      language: 'en',
+    },
+  ];
+}
+
+async function insertExtraDocument(db: PGlite, tenant: Omit<V2Tenant, 'parentId' | 'childIds'>, doc: ExtraDocument): Promise<void> {
+  const stored = `Document: ${doc.filename}. Chunk 1 of 1. Content: ${doc.text}`;
+  const multiTenant = tenant.label !== 'S';
+  await db.query(
+    `INSERT INTO documents (id, filename, content, metadata, ${multiTenant ? 'user_id, organization_id, ' : ''}doc_type, language, created_at)
+     VALUES ($1, $2, $3, $4::jsonb, ${multiTenant ? '$5, $6, ' : ''}$${multiTenant ? 7 : 5}, $${multiTenant ? 8 : 6}, $${multiTenant ? 9 : 7})`,
+    [
+      doc.docId,
+      doc.filename,
+      doc.text,
+      JSON.stringify({ relpath: `two-tenant-v2/${doc.filename}` }),
+      ...(multiTenant ? [tenant.userId, tenant.organizationId] : []),
+      doc.docType,
+      doc.language,
+      CREATED_AT,
+    ],
+  );
+  if (doc.invoice) {
+    await db.query(
+      `UPDATE documents SET supplier_name = $2, invoice_number = $3, issue_date = '2025-06-01', gross_total = $4, currency = $5 WHERE id = $1`,
+      [doc.docId, V2_INVOICE.supplier, V2_INVOICE.number, V2_INVOICE.gross, V2_INVOICE.currency],
+    );
+  }
+  const lexical = chunkLexicalText({
+    sectionPath: [],
+    content: stored,
+    chunkKind: doc.chunkKind,
+    metadata: doc.chunkMetadata,
+    documentFilename: doc.filename,
+  });
+  await db.query(
+    `INSERT INTO document_chunks (id, document_id, content, embedding, chunk_index, metadata, doc_type, language, chunk_kind, lexical_text, created_at)
+     VALUES ($1, $2, $3, $4::vector, 0, $5::jsonb, $6, $7, $8, $9, $10)`,
+    [doc.chunkId, doc.docId, stored, vectorLiteral(embedText(doc.text)), JSON.stringify(doc.chunkMetadata), doc.docType, doc.language, doc.chunkKind, lexical, CREATED_AT],
+  );
+}
+
+async function insertSingleTenantCanary(db: PGlite, tenant: Omit<V2Tenant, 'parentId' | 'childIds'>): Promise<void> {
+  const text = `${V2_CANARY_PHRASE}: ${tenant.marker}`;
+  const filename = 'tenant-s-default.md';
+  const stored = `Document: ${filename}. Chunk 1 of 1. Content: ${text}`;
+  await db.query('INSERT INTO documents (id, filename, content, metadata, doc_type, created_at) VALUES ($1, $2, $3, $4::jsonb, $5, $6)', [
+    tenant.docId,
+    filename,
+    text,
+    JSON.stringify({ relpath: `two-tenant-v2/${filename}` }),
+    'general',
+    CREATED_AT,
+  ]);
+  await db.query(
+    `INSERT INTO document_chunks (id, document_id, content, embedding, chunk_index, metadata, doc_type, lexical_text, created_at)
+     VALUES ($1, $2, $3, $4::vector, 0, $5::jsonb, 'general', $6, $7)`,
+    [
+      tenant.legacyChunkId,
+      tenant.docId,
+      stored,
+      vectorLiteral(embedText(text)),
+      JSON.stringify({ name: 'Default notes' }),
+      chunkLexicalText({ sectionPath: [], content: stored, documentFilename: filename }),
+      CREATED_AT,
+    ],
+  );
+}
+
+function childTexts(tenant: Omit<V2Tenant, 'parentId' | 'childIds'>): string[] {
+  const canary = `${V2_CANARY_PHRASE}: ${tenant.marker}`;
+  return [`${canary}. Profile child one of the canary section.`, `${canary}. Profile child two keeps the warranty terms for ${tenant.marker}.`];
+}
+
+function parentText(tenant: Omit<V2Tenant, 'parentId' | 'childIds'>): string {
+  return `PARENT SECTION of ${tenant.marker}. ${V2_CANARY_PHRASE}: ${tenant.marker}. The whole canary section with both child paragraphs and the warranty terms for ${tenant.marker}.`;
+}
+
+async function writeProfileChunks(db: PGlite, tenant: Omit<V2Tenant, 'parentId' | 'childIds'>): Promise<{ parentId: string; childIds: string[] }> {
+  const texts = childTexts(tenant);
+  const children = texts.map((content, index) => ({
+    chunk_index: index,
+    parent_index: 0,
+    content,
+    section_path: ['Canary'],
+    chunk_kind: 'text',
+    embedding_text_version: 1,
+    content_hash: `v2-${tenant.label}-${index}`,
+    lexical_text: chunkLexicalText({ sectionPath: ['Canary'], content }),
+    metadata: { name: `Canary profile ${tenant.label}` },
+  }));
+  const parents = [{ parent_index: 0, section_path: ['Canary'], content: parentText(tenant), token_count: 60 }];
+  const vectors = texts.map((text) => embedText(text));
+  await db.query(
+    `SELECT * FROM rag_write_profile_chunks(
+       p_document_id => $1, p_tenant_key => $2, p_profile_id => $3, p_parents => $4::jsonb, p_children => $5::jsonb, p_embeddings => $6::jsonb,
+       p_final => true, p_total => $7)`,
+    [
+      tenant.docId,
+      tenant.key,
+      V2_CHUNKING_PROFILE,
+      JSON.stringify(parents),
+      JSON.stringify(children),
+      JSON.stringify({ [V2_LEGACY_EMBEDDING_PROFILE]: { vectors, host: 'fixture' } }),
+      children.length,
+    ],
+  );
+  return { parentId: profileRowId(tenant.docId, 'parent', 0), childIds: texts.map((_, index) => profileRowId(tenant.docId, 'child', index)) };
+}
+
+/**
+ * Adds the Phase 4 canary rows to a database that already holds the Phase 2 two-tenant rows (multi-tenant) or nothing of the tenant (single-tenant).
+ * Every tenant gets: an exact-id code in the legacy canary chunk, a code document, an image chunk, an Italian document, a document of a type
+ * only this tenant has, and a non-legacy chunking profile (one parent and two children) that is the active profile of the general doc type.
+ */
+export async function seedTwoTenantV2(db: PGlite, mode: DeploymentMode): Promise<V2Tenant[]> {
+  const labels: V2TenantLabel[] = mode === 'multi-tenant' ? ['A', 'B', 'O'] : ['S'];
+  const described = labels.map(describeTenant);
+
+  await db.query(
+    `INSERT INTO chunking_profiles (id, doc_type, child_tokens, parent_mode, parent_tokens, status, preset)
+     VALUES ($1, 'general', 256, 'structure', 1024, 'building', '256/1024')`,
+    [V2_CHUNKING_PROFILE],
+  );
+
+  const tenants: V2Tenant[] = [];
+  for (const tenant of described) {
+    if (tenant.label === 'S') await insertSingleTenantCanary(db, tenant);
+    for (const doc of extraDocuments(tenant)) await insertExtraDocument(db, tenant, doc);
+
+    // The legacy canary chunk keeps the exact-id code; once the profile children exist the hybrid search hides it, so only the exact-id list finds it.
+    await db.query(
+      `UPDATE document_chunks SET content = content || $2, lexical_text = lexical_text || ' ' || $3 WHERE id = $1`,
+      [tenant.legacyChunkId, ` Archived reference code ${V2_EXACT_CODE}.`, lexicalTokens(`Archived reference code ${V2_EXACT_CODE}.`).join(' ')],
+    );
+
+    const written = await writeProfileChunks(db, tenant);
+    tenants.push({ ...tenant, parentId: written.parentId, childIds: written.childIds });
+  }
+
+  await db.query("UPDATE chunking_profiles SET status = 'ready' WHERE id = 'legacy' AND doc_type = 'general'");
+  await db.query("UPDATE chunking_profiles SET status = 'active', activated_at = now(), activated_by = 'fixture' WHERE id = $1 AND doc_type = 'general'", [
+    V2_CHUNKING_PROFILE,
+  ]);
+  return tenants;
+}
+
+function withLookup(fixture: FixtureDatabase, mode: DeploymentMode, tenants: V2Tenant[]): TwoTenantV2Database {
+  return Object.assign(fixture, {
+    deploymentMode: mode,
+    tenants,
+    tenant(label: V2TenantLabel): V2Tenant {
+      const found = tenants.find((tenant) => tenant.label === label);
+      if (!found) throw new Error(`[Two Tenant V2] no tenant ${label} in a ${mode} fixture`);
+      return found;
+    },
+  });
+}
+
+/** Builds on createTwoTenantDatabase without changing it: Phase 2 tests keep their fixture. */
+export async function createTwoTenantV2Database(options: { corpusDir?: string } = {}): Promise<TwoTenantV2Database> {
+  const fixture = await createTwoTenantDatabase({ corpusDir: options.corpusDir ?? DEFAULT_CORPUS_DIR });
+  try {
+    const tenants = await seedTwoTenantV2(fixture.db, 'multi-tenant');
+    return withLookup(fixture, 'multi-tenant', tenants);
+  } catch (error) {
+    await fixture.db.close().catch(() => undefined);
+    throw error;
+  }
+}
+
+export async function createSingleTenantV2Database(options: { corpusDir?: string } = {}): Promise<TwoTenantV2Database> {
+  const fixture = await createFixtureDatabase({ deploymentMode: 'single-tenant', corpusDir: options.corpusDir ?? DEFAULT_CORPUS_DIR });
+  try {
+    // The one tenant holds the canary rows only, so the corpus does not compete with them for the top ranks.
+    await fixture.db.query('DELETE FROM document_chunks');
+    await fixture.db.query('DELETE FROM documents');
+    const tenants = await seedTwoTenantV2(fixture.db, 'single-tenant');
+    return withLookup(fixture, 'single-tenant', tenants);
+  } catch (error) {
+    await fixture.db.close().catch(() => undefined);
+    throw error;
+  }
+}
+
+/** Every text and url that identifies another tenant: the markers (all texts carry them) and the image urls. */
+export function foreignSignatures(tenants: V2Tenant[], own: V2TenantLabel): string[] {
+  return tenants.filter((tenant) => tenant.label !== own).flatMap((tenant) => [tenant.marker, ...tenant.imageUrls, `tenant-${tenant.label.toLowerCase()}-`]);
+}
+
+export function ownSignature(tenant: V2Tenant): string {
+  return tenant.marker;
+}
+
+/** Returns the first foreign signature found in the text, or null. */
+export function findForeignText(text: string, tenants: V2Tenant[], own: V2TenantLabel): string | null {
+  const lowered = text.toLowerCase();
+  for (const signature of foreignSignatures(tenants, own)) {
+    if (lowered.includes(signature.toLowerCase())) return signature;
+  }
+  return null;
+}
+
+/** Every Phase 4 switch on, with a hosted quality reranker served by the fake edge. */
+export const V2_MATRIX_ENV_DEFAULTS: Readonly<Record<string, string>> = Object.freeze({
+  RAG_PIPELINE: 'v2',
+  RAG_LEXICAL_SEARCH: 'true',
+  RAG_RERANKER: 'cohere',
+  RAG_RERANK_TIER_CHAT: 'quality',
+  RAG_REFUSAL_THRESHOLD: 'true',
+  RAG_CONTEXT_EDGE_ORDER: 'true',
+  RAG_CONTEXT_COMPRESSION: 'true',
+  RAG_PARENT_CHILD: 'true',
+  RAG_LEXICAL_TRANSLATION: 'true',
+  RAG_EXACT_ID_LOOKUP: 'true',
+});
+
+export const V2_MATRIX_ENV_VARIABLE = 'TWO_TENANT_V2_ENV';
+const MATRIX_ENV_KEY = /^(?:RAG_[A-Z0-9_]+|COHERE_[A-Z0-9_]+|VOYAGE_[A-Z0-9_]+)$/;
+
+/**
+ * The environment the matrix runs under: the all-on defaults with the entries of TWO_TENANT_V2_ENV (a JSON object of strings) laid over them.
+ * A later phase runs the same matrix under other defaults by setting that variable, for example
+ * TWO_TENANT_V2_ENV='{"RAG_RERANKER":"auto","RAG_REFUSAL_FLOOR":"legacy_rule"}'; names this base does not read yet pass through unchanged.
+ */
+export function v2MatrixEnv(source: Record<string, string | undefined> = process.env): Record<string, string> {
+  const raw = (source[V2_MATRIX_ENV_VARIABLE] ?? '').trim();
+  if (raw === '') return { ...V2_MATRIX_ENV_DEFAULTS };
+  let parsed: unknown;
+  try {
+    parsed = JSON.parse(raw);
+  } catch {
+    throw new Error(`[Two Tenant V2] ${V2_MATRIX_ENV_VARIABLE} is not valid JSON`);
+  }
+  if (typeof parsed !== 'object' || parsed === null || Array.isArray(parsed)) {
+    throw new Error(`[Two Tenant V2] ${V2_MATRIX_ENV_VARIABLE} must be a JSON object`);
+  }
+  const overlay: Record<string, string> = {};
+  for (const [name, value] of Object.entries(parsed)) {
+    if (!MATRIX_ENV_KEY.test(name)) throw new Error(`[Two Tenant V2] ${V2_MATRIX_ENV_VARIABLE} may set RAG_, COHERE_ and VOYAGE_ variables only, not ${name}`);
+    if (typeof value !== 'string') throw new Error(`[Two Tenant V2] ${V2_MATRIX_ENV_VARIABLE}.${name} must be a string`);
+    overlay[name] = value;
+  }
+  return { ...V2_MATRIX_ENV_DEFAULTS, ...overlay };
+}
