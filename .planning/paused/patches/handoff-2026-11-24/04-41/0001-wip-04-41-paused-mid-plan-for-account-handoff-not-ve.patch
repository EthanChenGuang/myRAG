+import { after, before, describe, test } from 'node:test';
+import assert from 'node:assert/strict';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import type { RetrievalResult } from '@/lib/rag/types';
+import type { TenantScope } from '@/lib/rag/tenant/scope';
+import { NextRequest } from 'next/server';
+import { startFakeEdge, type FakeEdge } from '../../eval/harness/fake-edge.mts';
+import { prepareInProcessEval, type InProcessEval } from '../../eval/harness/run-eval.mts';
+import type { DeploymentMode } from '../../eval/harness/pglite-supabase.mts';
+import {
+  V2_CANARY_PHRASE,
+  V2_EXACT_CODE,
+  V2_INVOICE,
+  V2_PRIVATE_DOC_TYPE,
+  V2_TOPICS,
+  V2_TRANSLATED_QUERY,
+  createSingleTenantV2Database,
+  createTwoTenantV2Database,
+  findForeignText,
+  V2_MATRIX_ENV_VARIABLE,
+  v2MatrixEnv,
+  type TwoTenantV2Database,
+  type V2Tenant,
+  type V2TenantLabel,
+} from '../../eval/harness/two-tenant-v2.mts';
+
+const REPO_ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../..');
+const CORPUS_DIR = path.join(REPO_ROOT, 'eval/fixtures/corpus');
+const VOICE_SECRET = 'two-tenant-v2-voice-secret-placeholder-0000000000';
+export const PROFILES = ['chat', 'embed', 'voice', 'eval'] as const;
+type MatrixProfile = (typeof PROFILES)[number];
+
+const Q_CANARY = 'two tenant isolation canary phrase';
+const Q_EXACT = `reference code ${V2_EXACT_CODE}`;
+const Q_TRANSLATE = 'which tenant manual keeps the canary';
+const Q_INVOICE_NUMBER = `invoice ${V2_INVOICE.number} from ${V2_INVOICE.supplier}`;
+// No identifier-shaped token: the exact-id list does not apply, so the SQL invoice caps decide.
+const Q_INVOICE = `fattura ${V2_INVOICE.supplier} numero importo ${V2_INVOICE.gross} ${V2_CANARY_PHRASE}`;
+const OPTIONS = { maxResults: 25, fallbackToLowerThreshold: true };
+
+interface RecordedFetch {
+  url: string;
+  body: string;
+}
+
+export interface Session {
+  fixture: TwoTenantV2Database;
+  edge: FakeEdge;
+  prepared: InProcessEval;
+  env: Record<string, string>;
+  rerankCalls: RecordedFetch[];
+  restoreEnv(): void;
+}
+
+function snapshotEnv(): () => void {
+  const saved = { ...process.env } as Record<string, string | undefined>;
+  return () => {
+    const env = process.env as Record<string, string | undefined>;
+    for (const name of Object.keys(env)) {
+      if (!(name in saved)) delete env[name];
+    }
+    Object.assign(env, saved);
+  };
+}
+
+/**
+ * Everything the session starts is closed by close(), including when the build fails halfway: the edge and database
+ * (a fake server that stays up keeps the node:test process alive), the fixture translator and the dep overrides.
+ */
+export async function openSession(mode: DeploymentMode): Promise<{ session: Session; close: () => Promise<void> }> {
+  const restoreEnv = snapshotEnv();
+  const matrixEnv = v2MatrixEnv();
+  let fixture: TwoTenantV2Database | undefined;
+  let edge: FakeEdge | undefined;
+  let prepared: InProcessEval | undefined;
+  let translator: typeof import('@/lib/rag/query/translate') | undefined;
+  let depsModule: typeof import('@/lib/rag/deps') | undefined;
+  let backend: typeof import('@/lib/rag/backend/registry') | undefined;
+  let rerankSelect: typeof import('@/lib/rag/rerank/select') | undefined;
+  let closed = false;
+
+  const close = async (): Promise<void> => {
+    if (closed) return;
+    closed = true;
+    try {
+      translator?.resetTranslatorForTests();
+      depsModule?.resetRagDepsForTests();
+      backend?.resetRetrievalBackendForTests();
+      rerankSelect?.resetRerankerFactoryForTests();
+    } finally {
+      try {
+        await prepared?.close();
+      } finally {
+        try {
+          await edge?.close();
+        } finally {
+          try {
+            await fixture?.db.close().catch(() => undefined);
+          } finally {
+            restoreEnv();
+          }
+        }
+      }
+    }
+  };
+
+  try {
+    fixture = mode === 'multi-tenant' ? await createTwoTenantV2Database() : await createSingleTenantV2Database();
+    edge = await startFakeEdge({ db: fixture.db });
+    const allowed = fixture.tenants.filter((tenant) => tenant.userId !== null).map((tenant) => (tenant.organizationId ? `org:${tenant.organizationId}` : `user:${tenant.userId}`));
+    prepared = await prepareInProcessEval({
+      corpusDir: CORPUS_DIR,
+      deploymentMode: mode,
+      ingestFixture: Object.assign(fixture, { edge }),
+      allowedScopes: allowed,
+      envOverrides: matrixEnv,
+    });
+    // The harness points the vendor routes at their own paths; the fake edge serves the Voyage rerank at /v1.
+    process.env.VOYAGE_BASE_URL = `${edge.url}/v1`;
+    process.env.MYRAG_DEPLOYMENT_MODE = mode;
+    process.env.RAG_VOICE_TOKEN_SECRET = VOICE_SECRET;
+
+    depsModule = await import('@/lib/rag/deps');
+    translator = await import('@/lib/rag/query/translate');
+    backend = await import('@/lib/rag/backend/registry');
+    rerankSelect = await import('@/lib/rag/rerank/select');
+    const cohere = await import('@/lib/rag/rerank/cohere');
+    const voyage = await import('@/lib/rag/rerank/voyage');
+    const localBm25 = await import('@/lib/rag/rerank/local-bm25');
+    const startup = await import('@/lib/rag/v2/startup');
+    const rerankCalls: RecordedFetch[] = [];
+    const realFetch = depsModule.getRagDeps().fetch;
+    depsModule.setRagDepsForTests({
+      fetch: (async (input: Parameters<typeof fetch>[0], init?: Parameters<typeof fetch>[1]) => {
+        const url = typeof input === 'string' ? input : input instanceof URL ? input.toString() : input.url;
+        if (url.includes('/rerank')) rerankCalls.push({ url, body: typeof init?.body === 'string' ? init.body : '' });
+        return realFetch(input, init);
+      }) as typeof fetch,
+    });
+    // The fixture edge serves fake-* rerank model ids only; the adapters are the real ones, the model id is the fake of the same tier.
+    rerankSelect.setRerankerFactoryForTests((provider, model, ragEnv, fetchImpl) => {
+      const fake = /fast|lite/.test(model) ? 'fake-fast-v1' : 'fake-quality-v1';
+      if (provider === 'cohere') {
+        return cohere.createCohereReranker({ fetch: fetchImpl, apiKey: ragEnv.COHERE_API_KEY ?? '', baseUrl: ragEnv.COHERE_BASE_URL ?? '', model: fake });
+      }
+      if (provider === 'voyage') {
+        return voyage.createVoyageReranker({ fetch: fetchImpl, apiKey: ragEnv.VOYAGE_API_KEY ?? '', baseUrl: ragEnv.VOYAGE_BASE_URL ?? '', model: fake });
+      }
+      return provider === 'local_bm25' ? localBm25.createLocalBm25Reranker() : null;
+    });
+    translator.setTranslatorForTests({
+      name: 'two-tenant-v2',
+      translate: async (text) => (text === Q_TRANSLATE ? [{ ...V2_TRANSLATED_QUERY }] : []),
+    });
+    backend.resetRetrievalBackendForTests();
+    startup.resetV2StartupForTests();
+    await startup.verifyV2Startup();
+
+    return { session: { fixture, edge, prepared, env: matrixEnv, rerankCalls, restoreEnv }, close };
+  } catch (error) {
+    await close();
+    throw error;
+  }
+}
+
+interface Modules {
+  rag: typeof import('@/lib/rag');
+  scopeModule: typeof import('@/lib/rag/tenant/scope');
+  resolveChat: typeof import('@/lib/rag/tenant/resolve-chat');
+  embedModule: typeof import('@/lib/rag/tenant/embed');
+  voiceModule: typeof import('@/lib/rag/tenant/voice');
+  voiceToken: typeof import('@/lib/rag/tenant/voice-token');
+  evalModule: typeof import('@/lib/rag/tenant/eval');
+  supabaseModule: typeof import('@/lib/supabase');
+  depsModule: typeof import('@/lib/rag/deps');
+  contextModule: typeof import('@/lib/rag/v2/stages/context');
+  collectorModule: typeof import('@/lib/rag/trace/collector');
+  paramsModule: typeof import('@/lib/rag/v2/retrieval-params');
+  configModule: typeof import('@/lib/rag/config');
+  hitHelpers: typeof import('../rag/fusion/helpers.ts');
+}
+
+async function loadModules(): Promise<Modules> {
+  return {
+    rag: await import('@/lib/rag'),
+    scopeModule: await import('@/lib/rag/tenant/scope'),
+    resolveChat: await import('@/lib/rag/tenant/resolve-chat'),
+    embedModule: await import('@/lib/rag/tenant/embed'),
+    voiceModule: await import('@/lib/rag/tenant/voice'),
+    voiceToken: await import('@/lib/rag/tenant/voice-token'),
+    evalModule: await import('@/lib/rag/tenant/eval'),
+    supabaseModule: await import('@/lib/supabase'),
+    depsModule: await import('@/lib/rag/deps'),
+    contextModule: await import('@/lib/rag/v2/stages/context'),
+    collectorModule: await import('@/lib/rag/trace/collector'),
+    paramsModule: await import('@/lib/rag/v2/retrieval-params'),
+    configModule: await import('@/lib/rag/config'),
+    hitHelpers: await import('../rag/fusion/helpers.ts'),
+  };
+}
+
+interface Retrieved {
+  result: RetrievalResult;
+  rerankDocuments: string[][];
+}
+
+class Matrix {
+  constructor(
+    readonly session: Session,
+    readonly mode: DeploymentMode,
+    readonly m: Modules,
+  ) {}
+
+  get tenants(): V2Tenant[] {
+    return this.session.fixture.tenants;
+  }
+
+  tenant(label: V2TenantLabel): V2Tenant {
+    return this.session.fixture.tenant(label);
+  }
+
+  get allowedScopes(): string {
+    return this.tenants
+      .filter((tenant) => tenant.userId !== null)
+      .map((tenant) => (tenant.organizationId ? `org:${tenant.organizationId}` : `user:${tenant.userId}`))
+      .join(',');
+  }
+
+  config() {
+    return this.m.configModule.loadRagConfig(this.m.depsModule.getRagDeps().ragEnv());
+  }
+
+  private admin() {
+    return this.m.supabaseModule.getSupabaseAdmin();
+  }
+
+  /** The scope each entry point resolves for the tenant, through the real resolver of that entry point. */
+  async scopeFor(profile: MatrixProfile, tenant: V2Tenant): Promise<TenantScope> {
+    const signal = new AbortController().signal;
+    const chat = async () => {
+      const resolved = await this.m.resolveChat.resolveTenantScope({
+        requestedOrganizationId: tenant.organizationId,
+        deploymentMode: this.mode,
+        getUser: async () => (tenant.userId ? { id: tenant.userId } : null),
+        admin: this.admin(),
+        signal,
+      });
+      assert.ok(resolved.ok && resolved.scope, `chat scope of ${tenant.label} must resolve`);
+      return resolved.scope;
+    };
+    let scope: TenantScope;
+    if (profile === 'chat') {
+      scope = await chat();
+    } else if (profile === 'embed') {
+      const resolved = await this.m.embedModule.resolveEmbedScope({
+        rawBody: {},
+        configuredTenant: this.mode === 'multi-tenant' ? tenant.key : '',
+        deploymentMode: this.mode,
+        admin: this.admin(),
+        signal,
+      });
+      assert.ok(resolved.ok, `embed scope of ${tenant.label} must resolve`);
+      scope = resolved.scope;
+    } else if (profile === 'voice') {
+      const minted = this.m.voiceToken.mintVoiceToken({ scope: await chat(), secret: VOICE_SECRET, ttlSeconds: 600 });
+      assert.ok(minted.ok, 'voice token must mint');
+      const resolved = await this.m.voiceModule.resolveVoiceScope({
+        headers: new Headers({ 'x-rag-scope-token': minted.token }),
+        deploymentMode: this.mode,
+        secret: VOICE_SECRET,
+        admin: this.admin(),
+        signal,
+      });
+      assert.ok(resolved.ok, `voice scope of ${tenant.label} must resolve`);
+      scope = resolved.scope;
+    } else {
+      const resolved = this.m.evalModule.evalScope({
+        deploymentMode: this.mode,
+        organizationId: tenant.organizationId,
+        userId: tenant.userId,
+        allowedScopes: this.allowedScopes,
+      });
+      assert.ok(resolved.ok, `eval scope of ${tenant.label} must resolve`);
+      scope = resolved.scope;
+    }
+    assert.equal(this.m.scopeModule.scopeKey(scope), tenant.key, `${profile} scope of ${tenant.label}`);
+    return scope;
+  }
+
+  async retrieve(
+    scope: TenantScope,
+    profile: MatrixProfile,
+    query: string,
+    extra: { retrievalFilters?: Parameters<Modules['rag']['runRetrieval']>[0]['retrievalFilters'] } = {},
+  ): Promise<Retrieved> {
+    const before = this.session.rerankCalls.length;
+    const result = await this.m.rag.runRetrieval({
+      scope,
+      query,
+      profile,
+      options: OPTIONS,
+      signal: new AbortController().signal,
+      ...(extra.retrievalFilters ? { retrievalFilters: extra.retrievalFilters } : {}),
+    });
+    const rerankDocuments = this.session.rerankCalls.slice(before).map((call) => {
+      const parsed = JSON.parse(call.body) as { documents?: unknown };
+      return Array.isArray(parsed.documents) ? parsed.documents.map(String) : [];
+    });
+    return { result, rerankDocuments };
+  }
+
+  async keysOf(table: 'document_chunks' | 'documents' | 'document_parents', ids: string[]): Promise<Map<string, string | null>> {
+    if (ids.length === 0) return new Map();
+    const rows = await this.session.fixture.db.query<{ id: string; tenant_key: string | null }>(`SELECT id, tenant_key FROM ${table} WHERE id = ANY($1::uuid[])`, [ids]);
+    return new Map(rows.rows.map((row) => [row.id, row.tenant_key]));
+  }
+
+  /** Every surface a caller can read must hold the caller's tenant only, by id (tenant_key of the row) and by text. */
+  async assertClean(retrieved: Retrieved, tenant: V2Tenant, label: string): Promise<void> {
+    const { result, rerankDocuments } = retrieved;
+    const surfaces = {
+      context: result.context,
+      usedDocuments: result.usedDocuments,
+      sourceImages: result.sourceImages,
+      links: result.links,
+      relevantChunks: result.relevantChunks,
+      kept: result.kept,
+      candidates: result.candidates,
+      voice: result.voice ?? null,
+      refusal: result.refusal ?? null,
+      stages: result.stages,
+    };
+    const foreign = findForeignText(JSON.stringify(surfaces), this.tenants, tenant.label);
+    assert.equal(foreign, null, `${label}: a foreign text reached the result`);
+    for (const documents of rerankDocuments) {
+      for (const document of documents) {
+        assert.equal(findForeignText(document, this.tenants, tenant.label), null, `${label}: a foreign text reached the reranker`);
+      }
+    }
+
+    const chunkIds = new Set<string>([
+      ...result.candidates.map((candidate) => candidate.chunk_id),
+      ...result.relevantChunks.map((chunk) => chunk.chunk_id),
+      ...result.kept.map((chunk) => chunk.chunk_id),
+      ...(result.voice?.results ?? []).map((chunk) => String((chunk as { chunk_id?: string }).chunk_id ?? '')).filter((id) => id !== ''),
+    ]);
+    const chunkKeys = await this.keysOf('document_chunks', [...chunkIds]);
+    for (const id of chunkIds) assert.equal(chunkKeys.get(id), tenant.key, `${label}: chunk ${id} is not of ${tenant.key}`);
+
+    const documentIds = new Set<string>([
+      ...result.usedDocuments.map((doc) => doc.id),
+      ...result.candidates.map((candidate) => candidate.document_id),
+      ...result.kept.map((chunk) => chunk.document_id),
+    ]);
+    const documentKeys = await this.keysOf('documents', [...documentIds]);
+    for (const id of documentIds) assert.equal(documentKeys.get(id), tenant.key, `${label}: document ${id} is not of ${tenant.key}`);
+
+    const parentIds = new Set<string>(result.candidates.map((candidate) => candidate.parent_id).filter((id): id is string => typeof id === 'string'));
+    const parentKeys = await this.keysOf('document_parents', [...parentIds]);
+    for (const id of parentIds) assert.equal(parentKeys.get(id), tenant.key, `${label}: parent ${id} is not of ${tenant.key}`);
+
+    for (const image of result.sourceImages) assert.ok(image.url !== undefined && tenant.imageUrls.includes(image.url), `${label}: source image of another tenant (${image.url})`);
+    const voiceImages = (result.voice?.source_images ?? []) as Array<{ url?: string }>;
+    for (const image of voiceImages) assert.ok(image.url !== undefined && tenant.imageUrls.includes(image.url), `${label}: voice source image of another tenant (${image.url})`);
+  }
+
+  voiceChunks(result: RetrievalResult): Array<{ chunk_id: string; content: string }> {
+    return (result.voice?.results ?? []) as unknown as Array<{ chunk_id: string; content: string }>;
+  }
+
+  ownChunkIds(result: RetrievalResult, profile: MatrixProfile): string[] {
+    return profile === 'voice' ? this.voiceChunks(result).map((chunk) => chunk.chunk_id) : result.candidates.map((candidate) => candidate.chunk_id);
+  }
+}
+
+export function describeMatrix(mode: DeploymentMode): void {
+  describe(`v2 two-tenant matrix (${mode})`, () => {
+    let matrix: Matrix;
+    let close: () => Promise<void>;
+
+    before(async () => {
+      const opened = await openSession(mode);
+      close = opened.close;
+      matrix = new Matrix(opened.session, mode, await loadModules());
+    });
+
+    after(async () => {
+      await close?.();
+    });
+
+    const labels = (): V2TenantLabel[] => matrix.tenants.map((tenant) => tenant.label);
+    const expectsRerank = () => ['cohere', 'voyage'].includes((matrix.session.env.RAG_RERANKER ?? '').toLowerCase());
+
+    test('the fixture holds the canary rows of every tenant under the tenant keys, in one non-legacy active profile', async () => {
+      const { db } = matrix.session.fixture;
+      for (const tenant of matrix.tenants) {
+        const rows = await db.query<{ tenant_key: string | null; profile: string }>(
+          `SELECT c.tenant_key, c.chunking_profile_id AS profile FROM document_chunks c
+           WHERE c.document_id = ANY($1::uuid[])`,
+          [[tenant.docId, tenant.skuDocId, tenant.imageDocId, tenant.italianDocId, tenant.privateTypeDocId, tenant.invoiceDocId, tenant.topicDocId]],
+        );
+        assert.ok(rows.rows.length >= 9, `${tenant.label}: canary rows exist`);
+        assert.ok(rows.rows.every((row) => row.tenant_key === tenant.key), `${tenant.label}: every row carries ${tenant.key}`);
+        const children = rows.rows.filter((row) => row.profile !== 'legacy');
+        assert.equal(children.length, 2, `${tenant.label}: two profile children`);
+        const parent = await db.query<{ tenant_key: string }>('SELECT tenant_key FROM document_parents WHERE id = $1', [tenant.parentId]);
+        assert.equal(parent.rows[0]?.tenant_key, tenant.key);
+      }
+      const active = await db.query<{ id: string }>("SELECT id FROM chunking_profiles WHERE doc_type = 'general' AND status = 'active'");
+      assert.deepEqual(active.rows.map((row) => row.id), ['p-canary-256']);
+    });
+
+    for (const profile of PROFILES) {
+      describe(`entry point ${profile}`, () => {
+        test('canary query: dense and lexical legs, rerank, parents, assembly, sources and images stay in the caller tenant', async () => {
+          for (const label of labels()) {
+            const tenant = matrix.tenant(label);
+            const retrieved = await matrix.retrieve(await matrix.scopeFor(profile, tenant), profile, Q_CANARY);
+            const where = `${profile}/${label}/canary`;
+            assert.equal(retrieved.result.status, 'ok', `${where}: ${retrieved.result.reason}`);
+            await matrix.assertClean(retrieved, tenant, where);
+            const ids = matrix.ownChunkIds(retrieved.result, profile);
+            assert.ok(ids.length >= 3, `${where}: the tenant's own rows are returned (${ids.length})`);
+            if (profile === 'voice') {
+              assert.ok(JSON.stringify(retrieved.result.voice).includes(tenant.marker), `${where}: own marker`);
+            } else {
+              assert.ok(retrieved.result.context.includes(tenant.marker), `${where}: own marker in the context`);
+            }
+            const legs = new Set(retrieved.result.candidates.flatMap((candidate) => Object.keys(candidate.legs ?? {}).map((key) => key.split(':')[0])));
+            if (profile !== 'voice') {
+              assert.ok(legs.has('dense'), `${where}: dense leg`);
+              if (matrix.config().v2.lexicalSearch) assert.ok(legs.has('lexical'), `${where}: lexical leg`);
+            }
+            if (expectsRerank()) {
+              assert.ok(retrieved.rerankDocuments.length >= 1, `${where}: the reranker was called`);
+              assert.ok(retrieved.rerankDocuments.flat().some((document) => document.includes(tenant.marker)), `${where}: the reranker got own text`);
+            }
+          }
+        });
+
+        test('parent expansion renders the tenant own parent only', async () => {
+          if (profile === 'voice' || !matrix.config().v2.parentChild) return;
+          for (const label of labels()) {
+            const tenant = matrix.tenant(label);
+            const retrieved = await matrix.retrieve(await matrix.scopeFor(profile, tenant), profile, Q_CANARY);
+            const where = `${profile}/${label}/parents`;
+            assert.ok(retrieved.result.context.includes(`PARENT SECTION of ${tenant.marker}`), `${where}: own parent expanded`);
+            assert.ok(retrieved.result.stages.some((stage) => stage.name === 'expand_parents' && stage.status === 'ok'), `${where}: stage ok`);
+            await matrix.assertClean(retrieved, tenant, where);
+          }
+        });
+
+        test('image chunk: source_images carry the tenant own image only', async () => {
+          if (profile === 'voice') return;
+          for (const label of labels()) {
+            const tenant = matrix.tenant(label);
+            const retrieved = await matrix.retrieve(await matrix.scopeFor(profile, tenant), profile, `brand logo mark ${V2_CANARY_PHRASE}`);
+            const where = `${profile}/${label}/image`;
+            await matrix.assertClean(retrieved, tenant, where);
+            assert.ok(retrieved.result.sourceImages.length >= 1, `${where}: the tenant's own image is returned`);
+            assert.ok(retrieved.result.sourceImages.some((image) => image.url === tenant.imageUrl), `${where}: the tenant's own mark`);
+          }
+        });
+
+        test('exact-id list: the code that every tenant holds returns the caller rows only, hydrated through the tenant-filtered fetch', async () => {
+          if (profile === 'voice' || !matrix.config().exactIdLookup) return;
+          for (const label of labels()) {
+            const tenant = matrix.tenant(label);
+            const retrieved = await matrix.retrieve(await matrix.scopeFor(profile, tenant), profile, Q_EXACT);
+            const where = `${profile}/${label}/exact-id`;
+            await matrix.assertClean(retrieved, tenant, where);
+            const exact = retrieved.result.candidates.filter((candidate) => 'exact_id' in (candidate.legs ?? {}));
+            assert.ok(exact.length >= 1, `${where}: the exact-id list contributed`);
+            assert.ok(exact.some((candidate) => candidate.chunk_id === tenant.legacyChunkId), `${where}: the hidden legacy chunk came through the exact-id list`);
+          }
+        });
+
+        test('translated variant: its dense and lexical searches are tenant-filtered', async () => {
+          if (profile === 'voice' || !matrix.config().v2.lexicalTranslation) return;
+          for (const label of labels()) {
+            const tenant = matrix.tenant(label);
+            const retrieved = await matrix.retrieve(await matrix.scopeFor(profile, tenant), profile, Q_TRANSLATE);
+            const where = `${profile}/${label}/translate`;
+            assert.ok(retrieved.result.stages.some((stage) => stage.name === 'translate' && stage.status === 'ok'), `${where}: translate stage ran`);
+            await matrix.assertClean(retrieved, tenant, where);
+            const italian = retrieved.result.candidates.find((candidate) => candidate.chunk_id === tenant.italianChunkId);
+            assert.ok(italian, `${where}: the tenant's Italian chunk was found`);
