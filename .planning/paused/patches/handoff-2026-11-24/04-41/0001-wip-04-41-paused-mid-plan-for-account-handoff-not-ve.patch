+import assert from 'node:assert/strict';
+import { describe, test } from 'node:test';
+import { V2_MATRIX_ENV_VARIABLE } from '../../eval/harness/two-tenant-v2.mts';
+import { describeMatrix, openSession } from '../helpers/v2-two-tenant-matrix.mts';
+
+describeMatrix('single-tenant');
+
+
+describe('the matrix session closes everything it starts', () => {
+  test('after close() the fake edge refuses connections and the process environment and dep overrides are restored', async () => {
+    const before = { pipeline: process.env.RAG_PIPELINE, url: process.env.NEXT_PUBLIC_SUPABASE_URL };
+    const opened = await openSession('single-tenant');
+    const url = opened.session.edge.url;
+    const reachable = await fetch(`${url}/rest/v1/organizations`).then(() => true, () => false);
+    assert.equal(reachable, true, 'the edge answers while the session is open');
+    assert.equal(process.env.RAG_PIPELINE, 'v2');
+    await opened.close();
+    await opened.close();
+    const afterClose = await fetch(`${url}/rest/v1/organizations`).then(() => true, () => false);
+    assert.equal(afterClose, false, 'the edge must be closed');
+    assert.equal(process.env.RAG_PIPELINE, before.pipeline);
+    assert.equal(process.env.NEXT_PUBLIC_SUPABASE_URL, before.url);
+    const translate = await import('@/lib/rag/query/translate');
+    assert.equal(translate.getTranslator().name, 'none');
+  });
+
+  test('a malformed overlay is refused before anything starts', async () => {
+    const saved = process.env[V2_MATRIX_ENV_VARIABLE];
+    process.env[V2_MATRIX_ENV_VARIABLE] = '{not json';
+    try {
+      await assert.rejects(() => openSession('single-tenant'), /not valid JSON/);
+    } finally {
+      if (saved === undefined) delete process.env[V2_MATRIX_ENV_VARIABLE];
+      else process.env[V2_MATRIX_ENV_VARIABLE] = saved;
+    }
+  });
+});
