+from datetime import datetime
+from typing import Annotated, Literal
+
+from pydantic import Field, model_validator
+
 from rag_sidecar.contracts.golden import _Contract
 
+GroundednessScorerName = Literal["hhem_2_3_vectara", "hhem_2_1_open"]
+ThresholdCellSource = Literal["default", "calibrated"]
+
+_Text = Annotated[str, Field(min_length=1)]
+
 
 class GroundednessRequest(_Contract):
-    request_id: str
-    language: str
-    premise_texts: list[str]
-    hypothesis: str
+    request_id: _Text
+    language: _Text
+    premise_texts: list[_Text] = Field(min_length=1)
+    hypothesis: _Text
     allow_vectara: bool
 
 
 class GroundednessResult(_Contract):
-    status: str
-    scorer: str
-    score: float | None = None
-    reason: str | None = None
+    status: Literal["scored", "not_checked"]
+    scorer: Literal["hhem_2_3_vectara", "hhem_2_1_open", "none"]
+    score: float | None = Field(default=None, ge=0, le=1)
+    reason: str | None = Field(default=None, min_length=1, max_length=64)
     truncated: bool = False
-    latency_ms: int
+    latency_ms: int = Field(ge=0)
+
+    @model_validator(mode="after")
+    def _per_status(self) -> "GroundednessResult":
+        if self.status == "scored":
+            if self.score is None:
+                raise ValueError("a scored result needs a score")
+            if self.scorer == "none":
+                raise ValueError("a scored result needs a real scorer")
+        else:
+            if self.score is not None:
+                raise ValueError("a not_checked result carries no score")
+            if self.reason is None:
+                raise ValueError("a not_checked result needs a reason")
+        return self
 
 
 class GroundednessThresholdCell(_Contract):
-    scorer: str
-    language: str
-    threshold: float
-    source: str
-    fitted_at: str | None = None
+    scorer: GroundednessScorerName
+    language: _Text
+    threshold: float = Field(ge=0, le=1)
+    source: ThresholdCellSource
+    fitted_at: datetime | None = None
     dev: dict[str, float] | None = None
     holdout: dict[str, float] | None = None
 
 
 class GroundednessThresholds(_Contract):
-    schema_version: int = 1
+    schema_version: Literal[1] = 1
     cells: list[GroundednessThresholdCell]
+
+    @model_validator(mode="after")
+    def _unique_cells(self) -> "GroundednessThresholds":
+        pairs = [(cell.scorer, cell.language) for cell in self.cells]
+        if len(set(pairs)) != len(pairs):
+            raise ValueError("each (scorer, language) pair may appear once")
+        return self
