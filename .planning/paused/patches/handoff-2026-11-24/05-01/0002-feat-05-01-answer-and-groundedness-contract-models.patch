diff --git a/rag-sidecar/src/rag_sidecar/contracts/answers.py b/rag-sidecar/src/rag_sidecar/contracts/answers.py
index eb020e0..611f06f 100644
--- a/rag-sidecar/src/rag_sidecar/contracts/answers.py
+++ b/rag-sidecar/src/rag_sidecar/contracts/answers.py
@@ -1,62 +1,118 @@
-from typing import Any
+from datetime import datetime
+from typing import Annotated, Literal
+from uuid import UUID
+
+from pydantic import Field, model_validator
 
 from rag_sidecar.contracts.golden import _Contract
 
+CitationStrategy = Literal["claude-citations", "chunk-alias"]
+GroundednessScorer = Literal["hhem_2_3_vectara", "hhem_2_1_open", "none"]
+GroundednessStatus = Literal["pending", "scored", "not_checked"]
+GroundednessLabel = Literal["verified", "possibly_unreliable", "not_checked"]
+ThresholdSource = Literal["default", "calibrated"]
+FeedbackVote = Literal["helpful", "not_helpful"]
+FeedbackReason = Literal["wrong", "incomplete", "not_from_documents", "bad_citation"]
+DocumentAvailability = Literal["current", "unavailable"]
+
+_ShortCode = Annotated[str, Field(min_length=1, max_length=64)]
+_Reasons = Annotated[list[FeedbackReason], Field(max_length=4)]
+_Comment = Annotated[str, Field(max_length=500)]
+
+
+def _unique_reasons(reasons: list[FeedbackReason]) -> list[FeedbackReason]:
+    if len(set(reasons)) != len(reasons):
+        raise ValueError("reasons must not repeat")
+    return reasons
+
 
 class CitationRecord(_Contract):
-    n: int
-    alias: str
+    n: int = Field(ge=1)
+    alias: str = Field(pattern=r"^S[1-9][0-9]*$")
     chunkIds: list[str]
-    documentId: str
-    documentName: str
+    documentId: str = Field(min_length=1)
+    documentName: str = Field(min_length=1)
     documentVersion: int | None = None
     page: int | None = None
     sectionPath: list[str] | None = None
-    quote: str
-    quoteHash: str
-    strategy: str
+    quote: str = Field(min_length=1)
+    quoteHash: str = Field(pattern=r"^[0-9a-f]{64}$")
+    strategy: CitationStrategy
 
 
 class AnswerGroundedness(_Contract):
-    status: str
-    scorer: str | None = None
-    score: float | None = None
-    label: str | None = None
-    threshold: float | None = None
-    thresholdSource: str | None = None
-    reason: str | None = None
+    status: GroundednessStatus
+    scorer: GroundednessScorer | None = None
+    score: float | None = Field(default=None, ge=0, le=1)
+    label: GroundednessLabel | None = None
+    threshold: float | None = Field(default=None, ge=0, le=1)
+    thresholdSource: ThresholdSource | None = None
+    reason: _ShortCode | None = None
     truncated: bool = False
-    latencyMs: int | None = None
-    checkedAt: str | None = None
+    latencyMs: int | None = Field(default=None, ge=0)
+    checkedAt: datetime | None = None
+
+    @model_validator(mode="after")
+    def _per_status(self) -> "AnswerGroundedness":
+        if self.status == "pending":
+            if self.label is not None or self.score is not None or self.scorer is not None:
+                raise ValueError("a pending groundedness carries no scorer, label or score")
+        elif self.status == "scored":
+            if self.scorer is None or self.scorer == "none":
+                raise ValueError("a scored groundedness needs a real scorer")
+            if self.score is None:
+                raise ValueError("a scored groundedness needs a score")
+            if self.label not in ("verified", "possibly_unreliable"):
+                raise ValueError("a scored groundedness is verified or possibly_unreliable")
+            if self.threshold is None or self.thresholdSource is None:
+                raise ValueError("a scored groundedness needs its threshold and threshold source")
+        else:
+            if self.label != "not_checked":
+                raise ValueError("a not_checked groundedness has label not_checked")
+            if self.score is not None:
+                raise ValueError("a not_checked groundedness carries no score")
+            if self.reason is None:
+                raise ValueError("a not_checked groundedness needs a reason")
+        return self
 
 
 class AnswerFeedback(_Contract):
-    vote: str
-    reasons: list[str]
-    comment: str | None = None
-    updatedAt: str
+    vote: FeedbackVote
+    reasons: _Reasons = Field(default_factory=list)
+    comment: _Comment | None = None
+    updatedAt: datetime
+
+    @model_validator(mode="after")
+    def _unique(self) -> "AnswerFeedback":
+        _unique_reasons(self.reasons)
+        return self
 
 
 class AnswerFeedbackRequest(_Contract):
-    vote: str
-    reasons: list[str] = []
-    comment: str | None = None
-    chatId: str | None = None
+    vote: FeedbackVote
+    reasons: _Reasons = Field(default_factory=list)
+    comment: _Comment | None = None
+    chatId: UUID | None = None
+
+    @model_validator(mode="after")
+    def _unique(self) -> "AnswerFeedbackRequest":
+        _unique_reasons(self.reasons)
+        return self
 
 
 class AnswerRecord(_Contract):
-    answerId: str
-    chatId: str | None = None
-    traceId: str
-    modelId: str
-    citationStrategy: str | None = None
-    ragMode: str
+    answerId: UUID
+    chatId: UUID | None = None
+    traceId: str = Field(min_length=1)
+    modelId: str = Field(min_length=1)
+    citationStrategy: CitationStrategy | None = None
+    ragMode: str = Field(min_length=1)
     answerLanguage: str | None = None
-    invalidCitations: int = 0
+    invalidCitations: int = Field(default=0, ge=0)
     citations: list[CitationRecord]
     groundedness: AnswerGroundedness
     feedback: AnswerFeedback | None = None
-    documents: dict[str, Any] = {}
+    documents: dict[str, DocumentAvailability] = Field(default_factory=dict)
     feedbackEnabled: bool = False
-    createdAt: str
-    updatedAt: str
+    createdAt: datetime
+    updatedAt: datetime
