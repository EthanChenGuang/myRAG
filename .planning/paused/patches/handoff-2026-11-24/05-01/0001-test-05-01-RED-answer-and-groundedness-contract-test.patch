@@ -0,0 +1,370 @@
+import json
+from pathlib import Path
+
+import pytest
+from pydantic import ValidationError
+
+from rag_sidecar.contracts import (
+    AnswerFeedback,
+    AnswerFeedbackRequest,
+    AnswerGroundedness,
+    AnswerRecord,
+    CitationRecord,
+    GroundednessRequest,
+    GroundednessResult,
+    GroundednessThresholds,
+)
+from rag_sidecar.contracts.samples import build_samples
+from rag_sidecar.export_schemas import CONTRACTS
+
+REPO_ROOT = Path(__file__).resolve().parents[2]
+THRESHOLDS_PATH = REPO_ROOT / "eval" / "config" / "groundedness-thresholds.json"
+HASH = "a" * 64
+
+
+def _citation(**overrides):
+    base = {
+        "n": 1,
+        "alias": "S1",
+        "chunkIds": ["c-1", "c-2"],
+        "documentId": "d-1",
+        "documentName": "report.pdf",
+        "documentVersion": 2,
+        "page": 4,
+        "sectionPath": ["Terms", "Payment"],
+        "quote": "text",
+        "quoteHash": HASH,
+        "strategy": "chunk-alias",
+    }
+    base.update(overrides)
+    return base
+
+
+def _request(**overrides):
+    base = {
+        "request_id": "req-1",
+        "language": "en",
+        "premise_texts": ["Evidence one."],
+        "hypothesis": "A claim.",
+        "allow_vectara": True,
+    }
+    base.update(overrides)
+    return base
+
+
+def _result(**overrides):
+    base = {
+        "status": "scored",
+        "scorer": "hhem_2_3_vectara",
+        "score": 0.9,
+        "reason": None,
+        "truncated": False,
+        "latency_ms": 120,
+    }
+    base.update(overrides)
+    return base
+
+
+def _groundedness(**overrides):
+    base = {
+        "status": "scored",
+        "scorer": "hhem_2_3_vectara",
+        "score": 0.9,
+        "label": "verified",
+        "threshold": 0.5,
+        "thresholdSource": "default",
+        "latencyMs": 120,
+        "checkedAt": "2026-11-24T10:00:00Z",
+    }
+    base.update(overrides)
+    return base
+
+
+def _cell(**overrides):
+    base = {"scorer": "hhem_2_3_vectara", "language": "en", "threshold": 0.5, "source": "default"}
+    base.update(overrides)
+    return base
+
+
+def _answer_record(**overrides):
+    base = {
+        "answerId": "00000000-0000-4000-8000-000000000001",
+        "chatId": None,
+        "traceId": "trace-1",
+        "modelId": "model-x",
+        "citationStrategy": "chunk-alias",
+        "ragMode": "strict",
+        "answerLanguage": "en",
+        "invalidCitations": 0,
+        "citations": [_citation()],
+        "groundedness": _groundedness(),
+        "feedback": None,
+        "createdAt": "2026-11-24T10:00:00Z",
+        "updatedAt": "2026-11-24T10:00:00Z",
+    }
+    base.update(overrides)
+    return base
+
+
+class TestCitationRecord:
+    def test_accepts_full_record(self):
+        record = CitationRecord.model_validate(_citation())
+        assert record.alias == "S1"
+        assert record.chunkIds == ["c-1", "c-2"]
+
+    def test_accepts_referenced_document_without_chunks(self):
+        assert CitationRecord.model_validate(_citation(chunkIds=[])).chunkIds == []
+
+    def test_optional_fields_may_be_null_or_absent(self):
+        payload = _citation(page=None, sectionPath=None, documentVersion=None)
+        record = CitationRecord.model_validate(payload)
+        assert record.page is None and record.sectionPath is None and record.documentVersion is None
+        for key in ("page", "sectionPath", "documentVersion"):
+            absent = {k: v for k, v in _citation().items() if k != key}
+            assert getattr(CitationRecord.model_validate(absent), key) is None
+
+    def test_claude_citations_strategy_accepted(self):
+        assert CitationRecord.model_validate(_citation(strategy="claude-citations")).strategy == "claude-citations"
+
+    @pytest.mark.parametrize("alias", ["S0", "S01", "s1", "X1", "S", "S1a", ""])
+    def test_bad_alias_rejected(self, alias):
+        with pytest.raises(ValidationError):
+            CitationRecord.model_validate(_citation(alias=alias))
+
+    @pytest.mark.parametrize("alias", ["S10", "S99", "S123"])
+    def test_multi_digit_alias_accepted(self, alias):
+        assert CitationRecord.model_validate(_citation(alias=alias)).alias == alias
+
+    def test_n_zero_rejected(self):
+        with pytest.raises(ValidationError):
+            CitationRecord.model_validate(_citation(n=0))
+
+    @pytest.mark.parametrize("quote_hash", ["a" * 63, "A" * 64, "g" * 64, "a" * 65, ""])
+    def test_bad_quote_hash_rejected(self, quote_hash):
+        with pytest.raises(ValidationError):
+            CitationRecord.model_validate(_citation(quoteHash=quote_hash))
+
+    def test_underscore_strategy_rejected(self):
+        with pytest.raises(ValidationError):
+            CitationRecord.model_validate(_citation(strategy="claude_citations"))
+
+    def test_empty_quote_rejected(self):
+        with pytest.raises(ValidationError):
+            CitationRecord.model_validate(_citation(quote=""))
+
+    def test_long_quote_not_capped_in_contract(self):
+        assert len(CitationRecord.model_validate(_citation(quote="x" * 5000)).quote) == 5000
+
+    def test_unknown_key_rejected(self):
+        with pytest.raises(ValidationError):
+            CitationRecord.model_validate(_citation(extra_key=1))
+
+
+class TestGroundednessRequest:
+    def test_valid_request(self):
+        assert GroundednessRequest.model_validate(_request()).allow_vectara is True
+
+    @pytest.mark.parametrize(
+        "overrides",
+        [
+            {"premise_texts": []},
+            {"premise_texts": [""]},
+            {"hypothesis": ""},
+            {"language": ""},
+            {"request_id": ""},
+            {"rogue": 1},
+        ],
+    )
+    def test_invalid_request_rejected(self, overrides):
+        with pytest.raises(ValidationError):
+            GroundednessRequest.model_validate(_request(**overrides))
+
+    def test_allow_vectara_required(self):
+        payload = _request()
+        del payload["allow_vectara"]
+        with pytest.raises(ValidationError):
+            GroundednessRequest.model_validate(payload)
+
+
+class TestGroundednessResult:
+    def test_scored_result(self):
+        assert GroundednessResult.model_validate(_result()).score == 0.9
+
+    def test_not_checked_result(self):
+        result = GroundednessResult.model_validate(
+            _result(status="not_checked", scorer="none", score=None, reason="unsupported_language")
+        )
+        assert result.score is None and result.reason == "unsupported_language"
+
+    @pytest.mark.parametrize(
+        "overrides",
+        [
+            {"score": None},
+            {"score": 1.2},
+            {"score": -0.1},
+            {"scorer": "none"},
+            {"latency_ms": -1},
+            {"status": "not_checked", "scorer": "none", "score": 0.4, "reason": "x"},
+            {"status": "not_checked", "scorer": "none", "score": None, "reason": None},
+            {"status": "pending"},
+        ],
+    )
+    def test_invalid_result_rejected(self, overrides):
+        with pytest.raises(ValidationError):
+            GroundednessResult.model_validate(_result(**overrides))
+
+
+class TestGroundednessThresholds:
+    def test_valid_thresholds(self):
+        model = GroundednessThresholds.model_validate({"schema_version": 1, "cells": [_cell(), _cell(language="zh-Hans")]})
+        assert len(model.cells) == 2
+
+    def test_duplicate_cell_rejected(self):
+        with pytest.raises(ValidationError):
+            GroundednessThresholds.model_validate({"schema_version": 1, "cells": [_cell(), _cell(threshold=0.6)]})
+
+    @pytest.mark.parametrize("threshold", [-0.1, 1.1])
+    def test_threshold_out_of_range_rejected(self, threshold):
+        with pytest.raises(ValidationError):
+            GroundednessThresholds.model_validate({"schema_version": 1, "cells": [_cell(threshold=threshold)]})
+
+    def test_unknown_source_rejected(self):
+        with pytest.raises(ValidationError):
+            GroundednessThresholds.model_validate({"schema_version": 1, "cells": [_cell(source="guess")]})
+
+    def test_calibrated_cell_carries_metrics(self):
+        cell = _cell(source="calibrated", fitted_at="2026-11-24T10:00:00Z", dev={"f1": 0.8}, holdout={"f1": 0.75})
+        assert GroundednessThresholds.model_validate({"schema_version": 1, "cells": [cell]}).cells[0].dev == {"f1": 0.8}
+
+    def test_committed_default_file_validates(self):
+        model = GroundednessThresholds.model_validate(json.loads(THRESHOLDS_PATH.read_text(encoding="utf-8")))
+        pairs = {(cell.scorer, cell.language) for cell in model.cells}
+        assert pairs == {("hhem_2_3_vectara", "en"), ("hhem_2_3_vectara", "zh-Hans"), ("hhem_2_1_open", "en")}
+        assert all(cell.threshold == 0.5 and cell.source == "default" and cell.fitted_at is None for cell in model.cells)
+
+
+class TestAnswerGroundedness:
+    def test_scored(self):
+        assert AnswerGroundedness.model_validate(_groundedness()).label == "verified"
+
+    def test_scored_possibly_unreliable(self):
+        assert AnswerGroundedness.model_validate(_groundedness(label="possibly_unreliable", score=0.1)).score == 0.1
+
+    def test_pending_has_no_label_or_score(self):
+        model = AnswerGroundedness.model_validate({"status": "pending"})
+        assert model.label is None and model.score is None
+
+    @pytest.mark.parametrize(
+        "payload",
+        [
+            {"status": "pending", "label": "verified"},
+            {"status": "pending", "score": 0.4},
+            {"status": "scored", "scorer": "hhem_2_3_vectara", "score": 0.9, "label": "not_checked", "threshold": 0.5, "thresholdSource": "default"},
+            {"status": "scored", "scorer": "hhem_2_3_vectara", "score": 0.9, "label": None, "threshold": 0.5, "thresholdSource": "default"},
+            {"status": "scored", "scorer": "hhem_2_3_vectara", "score": None, "label": "verified", "threshold": 0.5, "thresholdSource": "default"},
+            {"status": "scored", "scorer": "hhem_2_3_vectara", "score": 0.9, "label": "verified"},
+            {"status": "scored", "scorer": "none", "score": 0.9, "label": "verified", "threshold": 0.5, "thresholdSource": "default"},
+            {"status": "not_checked", "label": "verified", "reason": "timeout"},
+            {"status": "not_checked", "label": "not_checked"},
+            {"status": "not_checked", "label": "not_checked", "reason": "timeout", "score": 0.3},
+        ],
+    )
+    def test_per_status_rules(self, payload):
+        with pytest.raises(ValidationError):
+            AnswerGroundedness.model_validate(payload)
+
+    def test_not_checked(self):
+        model = AnswerGroundedness.model_validate({"status": "not_checked", "label": "not_checked", "reason": "timeout"})
+        assert model.reason == "timeout" and model.truncated is False
+
+
+class TestAnswerFeedback:
+    def test_minimal_request(self):
+        request = AnswerFeedbackRequest.model_validate({"vote": "helpful"})
+        assert request.reasons == [] and request.comment is None and request.chatId is None
+
+    def test_full_request(self):
+        request = AnswerFeedbackRequest.model_validate(
+            {
+                "vote": "not_helpful",
+                "reasons": ["wrong", "incomplete", "not_from_documents", "bad_citation"],
+                "comment": "x" * 500,
+                "chatId": "00000000-0000-4000-8000-000000000002",
+            }
+        )
+        assert len(request.reasons) == 4
+
+    @pytest.mark.parametrize(
+        "payload",
+        [
+            {"vote": "maybe"},
+            {"vote": "helpful", "reasons": ["other"]},
+            {"vote": "helpful", "reasons": ["wrong", "wrong"]},
+            {"vote": "helpful", "reasons": ["wrong", "incomplete", "not_from_documents", "bad_citation", "wrong"]},
+            {"vote": "helpful", "comment": "x" * 501},
+            {"vote": "helpful", "chatId": "not-a-uuid"},
+            {"vote": "helpful", "rogue": 1},
+            {},
+        ],
+    )
+    def test_invalid_request_rejected(self, payload):
+        with pytest.raises(ValidationError):
+            AnswerFeedbackRequest.model_validate(payload)
+
+    def test_stored_feedback_shape(self):
+        feedback = AnswerFeedback.model_validate(
+            {"vote": "not_helpful", "reasons": ["wrong"], "comment": None, "updatedAt": "2026-11-24T10:00:00Z"}
+        )
+        assert feedback.vote == "not_helpful"
+
+
+class TestAnswerRecord:
+    def test_round_trip(self):
+        record = AnswerRecord.model_validate(_answer_record(feedback={"vote": "helpful", "reasons": [], "comment": None, "updatedAt": "2026-11-24T10:00:00Z"}))
+        dumped = record.model_dump(mode="json")
+        assert AnswerRecord.model_validate(dumped).model_dump(mode="json") == dumped
+
+    def test_defaults(self):
+        record = AnswerRecord.model_validate(_answer_record())
+        assert record.documents == {} and record.feedbackEnabled is False and record.invalidCitations == 0
+
+    def test_no_server_only_fields(self):
+        assert "review_reasons" not in AnswerRecord.model_fields
+        with pytest.raises(ValidationError):
+            AnswerRecord.model_validate(_answer_record(review_reasons=["x"]))
+
+    def test_documents_map_values_constrained(self):
+        assert AnswerRecord.model_validate(_answer_record(documents={"d-1": "current", "d-2": "unavailable"}))
+        with pytest.raises(ValidationError):
+            AnswerRecord.model_validate(_answer_record(documents={"d-1": "gone"}))
+
+    def test_null_chat_and_strategy_allowed(self):
+        record = AnswerRecord.model_validate(_answer_record(chatId=None, citationStrategy=None, answerLanguage=None))
+        assert record.chatId is None and record.citationStrategy is None
+
+
+class TestRegistration:
+    def test_models_registered_with_modes(self):
+        registered = {model.__name__: mode for model, mode in CONTRACTS}
+        assert registered["GroundednessRequest"] == "validation"
+        assert registered["AnswerFeedbackRequest"] == "validation"
+        for name in ("CitationRecord", "GroundednessResult", "GroundednessThresholds", "AnswerRecord"):
+            assert registered[name] == "serialization"
+
+    def test_one_sample_each(self):
+        samples = build_samples()["samples"]
+        for name in (
+            "CitationRecord",
+            "GroundednessRequest",
+            "GroundednessResult",
+            "GroundednessThresholds",
+            "AnswerFeedbackRequest",
+            "AnswerRecord",
+        ):
+            assert name in samples
+
+    def test_answer_record_sample_content(self):
+        sample = AnswerRecord.model_validate(build_samples()["samples"]["AnswerRecord"])
+        assert len(sample.citations) == 1 and sample.citations[0].strategy == "chunk-alias"
+        assert sample.groundedness.status == "scored"
+        assert sample.feedback is not None and sample.feedback.vote == "not_helpful"
