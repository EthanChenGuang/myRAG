@@ -0,0 +1,62 @@
+from typing import Any
+
+from rag_sidecar.contracts.golden import _Contract
+
+
+class CitationRecord(_Contract):
+    n: int
+    alias: str
+    chunkIds: list[str]
+    documentId: str
+    documentName: str
+    documentVersion: int | None = None
+    page: int | None = None
+    sectionPath: list[str] | None = None
+    quote: str
+    quoteHash: str
+    strategy: str
+
+
+class AnswerGroundedness(_Contract):
+    status: str
+    scorer: str | None = None
+    score: float | None = None
+    label: str | None = None
+    threshold: float | None = None
+    thresholdSource: str | None = None
+    reason: str | None = None
+    truncated: bool = False
+    latencyMs: int | None = None
+    checkedAt: str | None = None
+
+
+class AnswerFeedback(_Contract):
+    vote: str
+    reasons: list[str]
+    comment: str | None = None
+    updatedAt: str
+
+
+class AnswerFeedbackRequest(_Contract):
+    vote: str
+    reasons: list[str] = []
+    comment: str | None = None
+    chatId: str | None = None
+
+
+class AnswerRecord(_Contract):
+    answerId: str
+    chatId: str | None = None
+    traceId: str
+    modelId: str
+    citationStrategy: str | None = None
+    ragMode: str
+    answerLanguage: str | None = None
+    invalidCitations: int = 0
+    citations: list[CitationRecord]
+    groundedness: AnswerGroundedness
+    feedback: AnswerFeedback | None = None
+    documents: dict[str, Any] = {}
+    feedbackEnabled: bool = False
+    createdAt: str
+    updatedAt: str
diff --git a/rag-sidecar/src/rag_sidecar/contracts/groundedness.py b/rag-sidecar/src/rag_sidecar/contracts/groundedness.py
new file mode 100644
index 0000000..685c232
--- /dev/null
+++ b/rag-sidecar/src/rag_sidecar/contracts/groundedness.py
@@ -0,0 +1,33 @@
+from rag_sidecar.contracts.golden import _Contract
+
+
+class GroundednessRequest(_Contract):
+    request_id: str
+    language: str
+    premise_texts: list[str]
+    hypothesis: str
+    allow_vectara: bool
+
+
+class GroundednessResult(_Contract):
+    status: str
+    scorer: str
+    score: float | None = None
+    reason: str | None = None
+    truncated: bool = False
+    latency_ms: int
+
+
+class GroundednessThresholdCell(_Contract):
+    scorer: str
+    language: str
+    threshold: float
+    source: str
+    fitted_at: str | None = None
+    dev: dict[str, float] | None = None
+    holdout: dict[str, float] | None = None
+
+
+class GroundednessThresholds(_Contract):
+    schema_version: int = 1
+    cells: list[GroundednessThresholdCell]
diff --git a/rag-sidecar/tests/test_answer_contracts.py b/rag-sidecar/tests/test_answer_contracts.py
