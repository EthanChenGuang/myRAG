     AdvanceRequest,
     AdvanceResponse,
     BackfillDryRunReport,
@@ -810,6 +819,71 @@ def _activation_evidence() -> ActivationEvidence:
     )
 
 
+def _phase5_contract_samples() -> dict[str, Any]:
+    citation = CitationRecord(
+        n=1,
+        alias="S1",
+        chunkIds=["chunk-0001"],
+        documentId=_SAMPLE_DOC_ID,
+        documentName="handbook.pdf",
+        documentVersion=1,
+        page=3,
+        sectionPath=["Leave", "Annual leave"],
+        quote="Employees receive twenty days of annual leave.",
+        quoteHash=_HASH_A,
+        strategy="chunk-alias",
+    )
+    return {
+        "CitationRecord": citation,
+        "GroundednessRequest": GroundednessRequest(
+            request_id="req-0001",
+            language="en",
+            premise_texts=["Employees receive twenty days of annual leave."],
+            hypothesis="Employees get twenty days of leave.",
+            allow_vectara=True,
+        ),
+        "GroundednessResult": GroundednessResult(
+            status="scored", scorer="hhem_2_3_vectara", score=0.93, truncated=False, latency_ms=140
+        ),
