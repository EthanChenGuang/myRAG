# Server Configuration
PORT=3000

# Required for production. Every route except /health needs
# "Authorization: Bearer <API_KEY>". Use the same value as FLYIO_API_KEY
# (or KOYEB_API_KEY) in myRAG.
API_KEY=

# Where to send incoming messages, and the secret used to sign them.
# WEBHOOK_SECRET must match WHATSAPP_WEBHOOK_SECRET in myRAG, which is required in production.
WEBHOOK_URL=
WEBHOOK_SECRET=

# WhatsApp Configuration
# Set to true if you want to use pairing code instead of QR
USE_PAIRING_CODE=false

# Phone number for pairing code (only used if USE_PAIRING_CODE=true)
# Format: country code + number without spaces or special characters
# Example: 1234567890
PHONE_NUMBER=

# Link previews. Building a preview makes this service fetch the URL in a reply
# (and its preview image), so an injected answer could leak data through the query string.
# Empty (the default): no previews, no fetches. Otherwise a comma-separated list of
# exact hostnames (no wildcards, subdomains are not included). A reply gets a preview only
# when every URL in it uses https and one of these hosts. The preview image an allowlisted
# page names is fetched too, wherever it is hosted, so list only hosts you control.
WHATSAPP_LINK_PREVIEW_HOSTS=
