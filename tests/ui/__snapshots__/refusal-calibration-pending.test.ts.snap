// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`RefusalCalibrationPanel with the derived marks > a status without the new fields renders exactly as before this phase 1`] = `"<h3 data-refusal-title="">Refusal calibration</h3><div data-refusal-description="">Read-only. Shows which refusal thresholds the app can use and how they scored when they were calibrated. Thresholds change only through the calibration tool and a pull request. Applies to every workspace in this deployment.</div><div data-refusal-alert=""></div><div data-refusal-content=""><div class="flex flex-wrap items-center justify-end gap-2 mb-4"><span class="text-xs text-base-content/70">Updated <time/></span><button class="btn btn-outline btn-sm" type="button"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i>Refresh status</button></div><div class="flex flex-col gap-6"><div class="flex flex-col gap-4"><dl class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-2"><div><dt class="text-xs text-base-content/70">Pipeline</dt><dd class="text-sm">v2</dd></div><div><dt class="text-xs text-base-content/70">Threshold refusal</dt><dd class="text-sm">On</dd></div><div><dt class="text-xs text-base-content/70">Reranker</dt><dd class="text-sm">Cohere</dd></div><div><dt class="text-xs text-base-content/70">Score type</dt><dd class="text-sm">No reranker</dd></div></dl><div class="overflow-x-auto"><table class="table table-sm"><caption class="text-left text-xs font-semibold text-base-content/70 pb-1">Reranker model by use and question language</caption><thead><tr><td></td><th class="text-xs font-semibold" scope="col">Chinese</th><th class="text-xs font-semibold" scope="col">English</th><th class="text-xs font-semibold" scope="col">Italian</th></tr></thead><tbody><tr><th class="font-normal text-sm" scope="row">Chat (quality tier)</th><td class="font-mono text-xs break-all" translate="no">model-a</td><td class="font-mono text-xs break-all" translate="no">model-a</td><td class="font-mono text-xs break-all" translate="no">model-a</td></tr><tr><th class="font-normal text-sm" scope="row">Voice (fast tier)</th><td class="font-mono text-xs break-all" translate="no">model-a</td><td class="font-mono text-xs break-all" translate="no">model-a</td><td class="font-mono text-xs break-all" translate="no">model-a</td></tr></tbody></table></div><p class="text-xs text-base-content/70">Current versions: tokenizer 1, rerank text 1. Thresholds calibrated with other versions are not used.</p></div><div><h4 class="text-base font-semibold mb-2">Warnings</h4><div class="grid gap-2"><div class="alert alert-warning items-start text-left"><i class="bi bi-exclamation-triangle mt-0.5" aria-hidden="true"></i><div class="flex flex-col gap-2 items-start min-w-0 max-w-prose"><p class="text-sm">Thresholds calibrated with an older tokenizer or rerank text version: 1. They are marked Stale below and are not used. Run <code class="font-mono text-xs break-words" translate="no">python -m rag_eval.calibrate refusal</code> again, commit the result and redeploy.</p></div></div></div></div><div><h4 class="text-base font-semibold">Thresholds</h4><p class="text-xs text-base-content/70 max-w-prose mt-1 mb-2">False refusals are answerable questions that were refused. Correct refusals are questions with no answer in the knowledge base that were refused. The 95% upper bound is the highest false-refusal rate the data still allows; with few items it is far above the point estimate.</p><div class="overflow-x-auto rounded-lg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2" tabindex="0" role="region" aria-label="Refusal thresholds by reranker model and question language"><table class="table table-sm"><caption class="sr-only">Refusal thresholds by reranker model and question language</caption><thead><tr><th class="text-xs font-semibold align-bottom " scope="col" rowspan="2"><div>Reranker model</div></th><th class="text-xs font-semibold align-bottom " scope="col" rowspan="2"><div>Question language</div></th><th class="text-xs font-semibold align-bottom hidden md:table-cell" scope="col" rowspan="2"><div>Document language</div></th><th class="text-xs font-semibold align-bottom " scope="col" rowspan="2"><div>Status</div></th><th class="text-xs font-semibold align-bottom text-right" scope="col" rowspan="2"><div>Threshold</div></th><th class="text-xs font-semibold text-center hidden lg:table-cell" scope="colgroup" colspan="2">Dev set</th><th class="text-xs font-semibold text-center lg:hidden" scope="colgroup" colspan="1">Dev set</th><th class="text-xs font-semibold text-center hidden lg:table-cell" scope="colgroup" colspan="2">Holdout set</th><th class="text-xs font-semibold text-center lg:hidden" scope="colgroup" colspan="1">Holdout set</th><th class="text-xs font-semibold align-bottom hidden lg:table-cell" scope="col" rowspan="2"><div>Recorded</div></th></tr><tr><th class="text-xs font-semibold align-bottom " scope="col"><div>False refusals</div><div class="font-normal text-base-content/70">point estimate, 95% upper bound</div></th><th class="text-xs font-semibold align-bottom hidden lg:table-cell" scope="col"><div>Correct refusals</div><div class="font-normal text-base-content/70">point estimate</div></th><th class="text-xs font-semibold align-bottom " scope="col"><div>False refusals</div><div class="font-normal text-base-content/70">point estimate, 95% upper bound</div></th><th class="text-xs font-semibold align-bottom hidden lg:table-cell" scope="col"><div>Correct refusals</div><div class="font-normal text-base-content/70">point estimate</div></th></tr></thead><tbody><tr><th class="font-normal align-top min-w-40" scope="row"><div class="text-sm">Cohere</div><div class="font-mono text-xs break-all" translate="no">model-a</div></th><td class="align-top"><div class="text-sm">English</div><div class="text-xs text-base-content/70 md:hidden">Same as the question</div></td><td class="align-top text-sm hidden md:table-cell">Same as the question</td><td class="align-top min-w-40"><div class="flex flex-wrap gap-1"><span class="badge badge-success badge-outline badge-sm h-auto whitespace-nowrap">Calibrated</span></div><div class="text-xs text-base-content/70 mt-1">Passed the holdout check.</div></td><td class="align-top text-right tabular-nums text-sm">0.420</td><td class="align-top"><div class="flex flex-col gap-1"><div class="flex items-center gap-2"><span class="text-sm tabular-nums"><span class="sr-only">point estimate </span>10.0%</span><div class="relative w-24 h-1 rounded-full bg-base-300 hidden md:block shrink-0" aria-hidden="true"><div class="absolute inset-y-0 left-0 rounded-full bg-base-content/30"></div><div class="absolute top-1/2 -translate-y-1/2 w-2 h-2 rounded-full bg-base-content"></div></div></div><div class="text-xs text-base-content/70 tabular-nums">95% upper bound 30.0%</div><div class="text-xs text-base-content/70 tabular-nums">n = 10</div></div></td><td class="align-top hidden lg:table-cell"><div class="flex flex-col gap-1"><span class="text-sm tabular-nums"><span class="sr-only">point estimate </span>90.0%</span><span class="text-xs text-base-content/70 tabular-nums">n = 10</span></div></td><td class="align-top"><div class="flex flex-col gap-1"><div class="flex items-center gap-2"><span class="text-sm tabular-nums"><span class="sr-only">point estimate </span>10.0%</span><div class="relative w-24 h-1 rounded-full bg-base-300 hidden md:block shrink-0" aria-hidden="true"><div class="absolute inset-y-0 left-0 rounded-full bg-base-content/30"></div><div class="absolute top-1/2 -translate-y-1/2 w-2 h-2 rounded-full bg-base-content"></div></div></div><div class="text-xs text-base-content/70 tabular-nums">95% upper bound 30.0%</div><div class="text-xs text-base-content/70 tabular-nums">n = 10</div></div></td><td class="align-top hidden lg:table-cell"><div class="flex flex-col gap-1"><span class="text-sm tabular-nums"><span class="sr-only">point estimate </span>90.0%</span><span class="text-xs text-base-content/70 tabular-nums">n = 10</span></div></td><td class="align-top text-sm tabular-nums hidden lg:table-cell"><time datetime="2026-11-01">Nov 1, 2026</time></td></tr><tr><th class="font-normal align-top min-w-40" scope="row"><div class="text-sm">Cohere</div><div class="font-mono text-xs break-all" translate="no">model-b</div></th><td class="align-top"><div class="text-sm">Chinese</div><div class="text-xs text-base-content/70 md:hidden">Same as the question</div></td><td class="align-top text-sm hidden md:table-cell">Same as the question</td><td class="align-top min-w-40"><div class="flex flex-wrap gap-1"><span class="badge badge-ghost badge-sm h-auto whitespace-nowrap">Not calibrated</span><span class="badge badge-warning badge-outline badge-sm h-auto whitespace-nowrap">Stale</span></div><div class="text-xs text-base-content/70 mt-1">No threshold was fitted. Never causes a refusal.</div></td><td class="align-top text-right tabular-nums text-sm">None</td><td class="align-top"><div class="flex flex-col gap-1"><div class="flex items-center gap-2"><span class="text-sm tabular-nums"><span class="sr-only">point estimate </span>10.0%</span><div class="relative w-24 h-1 rounded-full bg-base-300 hidden md:block shrink-0" aria-hidden="true"><div class="absolute inset-y-0 left-0 rounded-full bg-base-content/30"></div><div class="absolute top-1/2 -translate-y-1/2 w-2 h-2 rounded-full bg-base-content"></div></div></div><div class="text-xs text-base-content/70 tabular-nums">95% upper bound 30.0%</div><div class="text-xs text-base-content/70 tabular-nums">n = 10</div></div></td><td class="align-top hidden lg:table-cell"><div class="flex flex-col gap-1"><span class="text-sm tabular-nums"><span class="sr-only">point estimate </span>90.0%</span><span class="text-xs text-base-content/70 tabular-nums">n = 10</span></div></td><td class="align-top"><div class="flex flex-col gap-1"><div class="flex items-center gap-2"><span class="text-sm tabular-nums"><span class="sr-only">point estimate </span>10.0%</span><div class="relative w-24 h-1 rounded-full bg-base-300 hidden md:block shrink-0" aria-hidden="true"><div class="absolute inset-y-0 left-0 rounded-full bg-base-content/30"></div><div class="absolute top-1/2 -translate-y-1/2 w-2 h-2 rounded-full bg-base-content"></div></div></div><div class="text-xs text-base-content/70 tabular-nums">95% upper bound 30.0%</div><div class="text-xs text-base-content/70 tabular-nums">n = 10</div></div></td><td class="align-top hidden lg:table-cell"><div class="flex flex-col gap-1"><span class="text-sm tabular-nums"><span class="sr-only">point estimate </span>90.0%</span><span class="text-xs text-base-content/70 tabular-nums">n = 10</span></div></td><td class="align-top text-sm tabular-nums hidden lg:table-cell"><time datetime="2026-11-01">Nov 1, 2026</time></td></tr></tbody></table></div><details class="mt-4"><summary class="text-sm cursor-pointer rounded focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2">What the statuses mean</summary><ul class="flex flex-col gap-1 mt-2 text-xs max-w-prose"><li><span class="font-semibold">Calibrated</span>: Passed the holdout check.</li><li><span class="font-semibold">Not calibrated</span>: No threshold was fitted. Never causes a refusal.</li><li><span class="font-semibold">Not enough data</span>: Too few items to fit a threshold. Never causes a refusal.</li><li><span class="font-semibold">Failed the holdout check</span>: The threshold did not hold on the holdout set. Never causes a refusal.</li><li>Fixture, eval only: calibrated on the built-in test data. Used when evaluating, never for live answers.</li><li>Stale: calibrated with another tokenizer or rerank text version than the app runs now. Not used until calibrated again.</li></ul></details></div></div></div><div data-refusal-status="" tabindex="-1">Status loaded. Thresholds: 2. Warnings: 1.</div>"`;
