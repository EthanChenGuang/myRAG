{
  "schema_version": 1,
  "rules_version": "supersession@1",
  "title_similarity_min": 1,
  "content_overlap_min_percent": 60,
  "min_conflicting_numbers": 2,
  "title_min_chars": 3,
  "year_pattern": "(?:19|20)\\d{2}",
  "max_title_candidates": 100,
  "overlap_max_documents": 10,
  "overlap_max_chars_per_document": 20000,
  "overlap_min_sentence_chars": 12,
  "hook_timeout_ms": 5000
}
