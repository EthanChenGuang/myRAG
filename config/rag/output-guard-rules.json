  "obfuscation_patterns": [
    {
      "id": "obf.scheme-hxxp",
      "pattern": "^h(?:xx|__|\\*\\*)ps?://$"
    },
    {
      "id": "obf.scheme-fxp",
      "pattern": "^fxps?://$"
    },
    {
      "id": "obf.bracket-dot",
      "pattern": "^[\\[({]\\s*(?:\\.|dot)\\s*[\\])}]$"
    },
    {
      "id": "obf.bracket-colon",
      "pattern": "^[\\[({]\\s*:\\s*[\\])}]$"
    },
    {
      "id": "obf.bracket-at",
      "pattern": "^[\\[({]\\s*(?:@|at)\\s*[\\])}]$"
    },
    {
      "id": "obf.spelled-dot",
      "pattern": "^\\s+dot\\s+$"
    }
  ],
