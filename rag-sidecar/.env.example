# Shared secret for /v1/* (minimum 32 characters). Placeholder only.
RAG_SIDECAR_SECRET=replace-with-a-random-secret-at-least-32-chars-long

# Ingestion worker (sidecar-only). Default off keeps Phase 3 behaviour.
RAG_INGEST_WORKER=off
RAG_INGEST_WORKER_CONCURRENCY=2

# App internal base URL for ingestion callbacks (worker uses this, not the public site URL).
RAG_APP_INTERNAL_URL=https://your-app-internal.example

# Reused from the main app Supabase project (service role — placeholder only).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key-placeholder

# Callback token bucket (requests per second, sidecar-only).
RAG_INGEST_APP_RATE=10

# Test-only Docling fixture converter — refused unless RAG_SIDECAR_ENV=test (set only by the e2e launcher).
# RAG_INGEST_CONVERTER=docling
# RAG_INGEST_RECORDED_DIR=/path/to/eval/fixtures/parse/recorded
# Ingestion queue maintenance loop (sidecar-only): dead-letter count signal + stale job purge.
# Default on; set off to disable. Interval in seconds, retention in days for terminal jobs.
RAG_INGEST_MAINTENANCE=on
RAG_INGEST_MAINTENANCE_INTERVAL_SECONDS=3600
RAG_INGEST_JOB_RETENTION_DAYS=90
