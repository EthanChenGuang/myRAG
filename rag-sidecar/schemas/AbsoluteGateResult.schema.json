{
  "$defs": {
    "CompositionLanguageResult": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "minimum": 0,
          "title": "Items",
          "type": "integer"
        },
        "kinds": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Kinds",
          "type": "object"
        },
        "language": {
          "enum": [
            "zh",
            "en",
            "it"
          ],
          "title": "Language",
          "type": "string"
        },
        "min": {
          "maximum": 1,
          "minimum": 0,
          "title": "Min",
          "type": "number"
        },
        "no_answer": {
          "minimum": 0,
          "title": "No Answer",
          "type": "integer"
        },
        "result": {
          "enum": [
            "passed",
            "failed",
            "warning",
            "insufficient_n"
          ],
          "title": "Result",
          "type": "string"
        },
        "share": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Share"
        },
        "target": {
          "maximum": 1,
          "minimum": 0,
          "title": "Target",
          "type": "number"
        }
      },
      "required": [
        "language",
        "items",
        "no_answer",
        "min",
        "target",
        "result"
      ],
      "title": "CompositionLanguageResult",
      "type": "object"
    },
    "CompositionResult": {
      "additionalProperties": false,
      "properties": {
        "languages": {
          "items": {
            "$ref": "#/$defs/CompositionLanguageResult"
          },
          "title": "Languages",
          "type": "array"
        },
        "missing_required_kinds": {
          "items": {
            "pattern": "^[a-z0-9_]+$",
            "type": "string"
          },
          "title": "Missing Required Kinds",
          "type": "array"
        }
      },
      "title": "CompositionResult",
      "type": "object"
    },
    "GateCheckRow": {
      "additionalProperties": false,
      "description": "One absolute check on one slice; skipped and insufficient_n are never counted as passed.",
      "properties": {
        "check": {
          "pattern": "^[a-z0-9_]+$",
          "title": "Check",
          "type": "string"
        },
        "denominator": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Denominator"
        },
        "limit": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit"
        },
        "limit_kind": {
          "enum": [
            "max",
            "min"
          ],
          "title": "Limit Kind",
          "type": "string"
        },
        "measured": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Measured"
        },
        "numerator": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numerator"
        },
        "reason": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9_]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "result": {
          "enum": [
            "passed",
            "failed",
            "insufficient_n",
            "report_only",
            "skipped"
          ],
          "title": "Result",
          "type": "string"
        },
        "slice": {
          "pattern": "^[a-z0-9_]+(:[A-Za-z0-9_.|-]+)*$",
          "title": "Slice",
          "type": "string"
        }
      },
      "required": [
        "check",
        "slice",
        "limit_kind",
        "result"
      ],
      "title": "GateCheckRow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "checks": {
      "items": {
        "$ref": "#/$defs/GateCheckRow"
      },
      "title": "Checks",
      "type": "array"
    },
    "composition": {
      "$ref": "#/$defs/CompositionResult"
    },
    "exit_code": {
      "enum": [
        0,
        11,
        12
      ],
      "title": "Exit Code",
      "type": "integer"
    },
    "failed": {
      "items": {
        "pattern": "^[a-z0-9_]+$",
        "type": "string"
      },
      "title": "Failed",
      "type": "array"
    },
    "mode": {
      "enum": [
        "enforce",
        "report"
      ],
      "title": "Mode",
      "type": "string"
    },
    "passed": {
      "title": "Passed",
      "type": "boolean"
    },
    "rag_mode": {
      "enum": [
        "strict",
        "balanced",
        "flexible"
      ],
      "title": "Rag Mode",
      "type": "string"
    },
    "stale_count": {
      "default": 0,
      "minimum": 0,
      "title": "Stale Count",
      "type": "integer"
    },
    "stale_result": {
      "enum": [
        "passed",
        "failed",
        "insufficient_n",
        "report_only",
        "skipped"
      ],
      "title": "Stale Result",
      "type": "string"
    },
    "stale_share": {
      "default": 0.0,
      "maximum": 1,
      "minimum": 0,
      "title": "Stale Share",
      "type": "number"
    }
  },
  "required": [
    "passed",
    "mode",
    "rag_mode",
    "composition",
    "stale_result",
    "exit_code"
  ],
  "title": "AbsoluteGateResult",
  "type": "object"
}
