{
  "$defs": {
    "ChunkPrepBoilerplatePart": {
      "additionalProperties": false,
      "description": "Cleaning state of a document prepared while `RAG_PAGE_BOILERPLATE` is on (Phase 3.3 D-13).",
      "properties": {
        "cleaner_version": {
          "minimum": 1,
          "title": "Cleaner Version",
          "type": "integer"
        },
        "mode": {
          "enum": [
            "detect",
            "rules",
            "both"
          ],
          "title": "Mode",
          "type": "string"
        },
        "rule_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Rule Fingerprint",
          "type": "string"
        },
        "rules_version": {
          "minimum": 1,
          "title": "Rules Version",
          "type": "integer"
        }
      },
      "required": [
        "mode",
        "cleaner_version",
        "rules_version",
        "rule_fingerprint"
      ],
      "title": "ChunkPrepBoilerplatePart",
      "type": "object"
    },
    "ChunkPrepPart": {
      "additionalProperties": false,
      "description": "Optional fingerprint part of the shared chunk preparation; present only when a writer sets it (D-13, F-22).",
      "properties": {
        "boilerplate": {
          "$ref": "#/$defs/ChunkPrepBoilerplatePart"
        },
        "section_rules": {
          "$ref": "#/$defs/ChunkPrepSectionRulesPart"
        }
      },
      "title": "ChunkPrepPart",
      "type": "object"
    },
    "ChunkPrepSectionRulesPart": {
      "additionalProperties": false,
      "description": "Rule set a document was cut by while `RAG_SECTION_RULES` is on (Phase 3.3 D-17).",
      "properties": {
        "rule_set_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Rule Set Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "rule_set_id",
        "version"
      ],
      "title": "ChunkPrepSectionRulesPart",
      "type": "object"
    },
    "FingerprintSwitches": {
      "additionalProperties": false,
      "description": "State of this phase's ingestion-side switches, as the raw variable values (D-13, D-19, D-21, D-23).",
      "properties": {
        "caption_language": {
          "enum": [
            "en",
            "document"
          ],
          "title": "Caption Language",
          "type": "string"
        },
        "language_aware_ingest": {
          "enum": [
            "off",
            "on"
          ],
          "title": "Language Aware Ingest",
          "type": "string"
        },
        "table_header_repeat": {
          "enum": [
            "profile",
            "always"
          ],
          "title": "Table Header Repeat",
          "type": "string"
        },
        "table_row_serialization": {
          "enum": [
            "false",
            "true"
          ],
          "title": "Table Row Serialization",
          "type": "string"
        }
      },
      "required": [
        "language_aware_ingest",
        "table_header_repeat",
        "table_row_serialization",
        "caption_language"
      ],
      "title": "FingerprintSwitches",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Parts hashed into `documents.ingest_fingerprint` (D-10); strings and integers only, so canonical JSON is stable.",
  "properties": {
    "assumed_defaults": {
      "items": {
        "enum": [
          "parser_used",
          "parser_version",
          "processing_profile_id",
          "processing_profile_version",
          "ocr_engine_codes",
          "chunking_profile_id",
          "lexical_version",
          "embedding_text_version",
          "embedding_profile_id",
          "embedding_profile_version",
          "language_pack_versions",
          "switches"
        ],
        "type": "string"
      },
      "title": "Assumed Defaults",
      "type": "array"
    },
    "chunk_prep": {
      "$ref": "#/$defs/ChunkPrepPart"
    },
    "chunking_profile_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Chunking Profile Id",
      "type": "string"
    },
    "embedding_profile_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Embedding Profile Id",
      "type": "string"
    },
    "embedding_profile_version": {
      "minimum": 1,
      "title": "Embedding Profile Version",
      "type": "integer"
    },
    "embedding_text_version": {
      "minimum": 0,
      "title": "Embedding Text Version",
      "type": "integer"
    },
    "language_pack_versions": {
      "patternProperties": {
        "^[a-z]{2,3}$": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "title": "Language Pack Versions",
      "type": "object"
    },
    "lexical_version": {
      "minimum": 0,
      "title": "Lexical Version",
      "type": "integer"
    },
    "ocr_engine_codes": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 64,
      "title": "Ocr Engine Codes",
      "type": "array"
    },
    "parser_used": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Parser Used",
      "type": "string"
    },
    "parser_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Parser Version",
      "type": "string"
    },
    "processing_profile_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Processing Profile Id",
      "type": "string"
    },
    "processing_profile_version": {
      "minimum": 1,
      "title": "Processing Profile Version",
      "type": "integer"
    },
    "switches": {
      "$ref": "#/$defs/FingerprintSwitches"
    }
  },
  "required": [
    "parser_used",
    "parser_version",
    "processing_profile_id",
    "processing_profile_version",
    "ocr_engine_codes",
    "chunking_profile_id",
    "lexical_version",
    "embedding_text_version",
    "embedding_profile_id",
    "embedding_profile_version",
    "language_pack_versions",
    "switches"
  ],
  "title": "IngestFingerprintParts",
  "type": "object"
}
