{
  "additionalProperties": false,
  "properties": {
    "chunk_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Chunk Id",
      "type": "string"
    },
    "chunk_index": {
      "minimum": 0,
      "title": "Chunk Index",
      "type": "integer"
    },
    "content_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "document_content_hash": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Document Content Hash"
    },
    "document_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Document Id",
      "type": "string"
    },
    "is_golden_test_evidence": {
      "title": "Is Golden Test Evidence",
      "type": "boolean"
    },
    "language": {
      "enum": [
        "zh",
        "en",
        "it"
      ],
      "title": "Language",
      "type": "string"
    },
    "split": {
      "enum": [
        "train",
        "dev",
        "test"
      ],
      "title": "Split",
      "type": "string"
    },
    "tenant_key": {
      "pattern": "^(s:default|[uo]:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$",
      "title": "Tenant Key",
      "type": "string"
    },
    "text": {
      "minLength": 1,
      "title": "Text",
      "type": "string"
    },
    "token_count": {
      "minimum": 0,
      "title": "Token Count",
      "type": "integer"
    }
  },
  "required": [
    "tenant_key",
    "document_id",
    "chunk_id",
    "chunk_index",
    "content_hash",
    "language",
    "split",
    "text",
    "token_count",
    "is_golden_test_evidence"
  ],
  "title": "ExportedChunk",
  "type": "object"
}
