{
  "$defs": {
    "CitationAlsoIn": {
      "additionalProperties": false,
      "description": "D-21: a duplicate of the cited chunk in another document, collapsed under this citation.",
      "properties": {
        "chunkId": {
          "minLength": 1,
          "title": "Chunkid",
          "type": "string"
        },
        "documentId": {
          "minLength": 1,
          "title": "Documentid",
          "type": "string"
        },
        "filename": {
          "title": "Filename",
          "type": "string"
        }
      },
      "required": [
        "documentId",
        "filename",
        "chunkId"
      ],
      "title": "CitationAlsoIn",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "alias": {
      "pattern": "^S[1-9][0-9]*$",
      "title": "Alias",
      "type": "string"
    },
    "alsoIn": {
      "items": {
        "$ref": "#/$defs/CitationAlsoIn"
      },
      "title": "Alsoin",
      "type": "array"
    },
    "chunkIds": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Chunkids",
      "type": "array"
    },
    "documentId": {
      "minLength": 1,
      "title": "Documentid",
      "type": "string"
    },
    "documentName": {
      "title": "Documentname",
      "type": "string"
    },
    "documentVersion": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Documentversion"
    },
    "effectiveFrom": {
      "format": "date",
      "title": "Effectivefrom",
      "type": "string"
    },
    "effectiveTo": {
      "format": "date",
      "title": "Effectiveto",
      "type": "string"
    },
    "isCurrent": {
      "title": "Iscurrent",
      "type": "boolean"
    },
    "n": {
      "minimum": 1,
      "title": "N",
      "type": "integer"
    },
    "page": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Page"
    },
    "quote": {
      "minLength": 1,
      "title": "Quote",
      "type": "string"
    },
    "quoteHash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Quotehash",
      "type": "string"
    },
    "sectionPath": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sectionpath"
    },
    "strategy": {
      "enum": [
        "claude-citations",
        "chunk-alias"
      ],
      "title": "Strategy",
      "type": "string"
    },
    "versionLabel": {
      "maxLength": 40,
      "title": "Versionlabel",
      "type": "string"
    }
  },
  "required": [
    "n",
    "alias",
    "chunkIds",
    "documentId",
    "documentName",
    "quote",
    "quoteHash",
    "strategy"
  ],
  "title": "CitationRecord",
  "type": "object"
}
