  "additionalProperties": false,
  "properties": {
    "answer": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Answer"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/TraceCandidate"
      },
      "title": "Candidates",
      "type": "array"
    },
    "citations": {
      "items": {
        "$ref": "#/$defs/TraceCitation"
      },
      "title": "Citations",
      "type": "array"
    },
    "config_hash": {
      "title": "Config Hash",
      "type": "string"
    },
    "context": {
      "title": "Context",
      "type": "string"
    },
    "context_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Context Tokens"
    },
    "effective_config": {
      "$ref": "#/$defs/TraceEffectiveConfig"
    },
    "item_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Item Id"
    },
    "kept": {
      "items": {
        "$ref": "#/$defs/TraceKeptChunk"
      },
      "title": "Kept",
      "type": "array"
    },
    "query": {
      "title": "Query",
      "type": "string"
    },
    "query_context": {
      "$ref": "#/$defs/TraceQueryContext"
    },
    "query_language": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Query Language"
    },
    "query_transforms": {
      "items": {
        "$ref": "#/$defs/TraceQueryTransform"
      },
      "title": "Query Transforms",
      "type": "array"
    },
    "refusal": {
      "anyOf": [
        {
          "$ref": "#/$defs/TraceRefusal"
        },
        {
          "type": "null"
        }
      ],
      "default": null
