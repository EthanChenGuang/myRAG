    "refusal_reason": {
      "anyOf": [
        {
          "enum": [
            "no_relevant_context",
            "below_threshold",
            "below_similarity_floor"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Refusal Reason"
    },
    "refused": {
      "title": "Refused",
      "type": "boolean"
    },
    "retrieval_config_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retrieval Config Hash"
    },
    "retrieval_strategy": {
      "title": "Retrieval Strategy",
      "type": "string"
    },
    "retrieval_versions": {
      "anyOf": [
        {
          "$ref": "#/$defs/TraceRetrievalVersions"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "stage_counts": {
      "additionalProperties": {
        "additionalProperties": {
          "type": "number"
        },
        "type": "object"
      },
      "title": "Stage Counts",
      "type": "object"
    },
    "stage_latency_ms": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Stage Latency Ms",
      "type": "object"
    },
    "stage_status": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Stage Status",
      "type": "object"
    },
    "used_documents": {
      "items": {
        "$ref": "#/$defs/TraceUsedDocument"
      },
      "title": "Used Documents",
      "type": "array"
    }
  },
  "required": [
    "query",
    "query_context",
    "retrieval_strategy",
    "candidates",
    "kept",
    "used_documents",
    "context",
    "refused",
    "citations",
    "stage_latency_ms",
    "effective_config",
    "config_hash"
  ],
  "title": "RagTrace",
  "type": "object"
}
