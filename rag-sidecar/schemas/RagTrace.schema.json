            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Documentversion"
        },
        "n": {
          "minimum": 1,
          "title": "N",
          "type": "integer"
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "quoteHash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Quotehash",
          "type": "string"
        },
        "sectionPath": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sectionpath"
        },
        "strategy": {
          "enum": [
            "claude-citations",
            "chunk-alias"
          ],
          "title": "Strategy",
          "type": "string"
        }
      },
      "required": [
        "n",
        "alias",
        "chunkIds",
        "documentId",
        "documentName",
        "quote",
        "quoteHash",
        "strategy"
      ],
      "title": "CitationRecord",
      "type": "object"
    },
