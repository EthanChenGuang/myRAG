{
  "$defs": {
    "IrMetrics": {
      "additionalProperties": false,
      "properties": {
        "mrr_at_10": {
          "maximum": 1,
          "minimum": 0,
          "title": "Mrr At 10",
          "type": "number"
        },
        "n": {
          "minimum": 0,
          "title": "N",
          "type": "integer"
        },
        "ndcg_at_10": {
          "maximum": 1,
          "minimum": 0,
          "title": "Ndcg At 10",
          "type": "number"
        },
        "recall_at_10": {
          "maximum": 1,
          "minimum": 0,
          "title": "Recall At 10",
          "type": "number"
        }
      },
      "required": [
        "n",
        "recall_at_10",
        "mrr_at_10",
        "ndcg_at_10"
      ],
      "title": "IrMetrics",
      "type": "object"
    },
    "MetricDelta": {
      "additionalProperties": false,
      "properties": {
        "ci_high": {
          "maximum": 1,
          "minimum": -1,
          "title": "Ci High",
          "type": "number"
        },
        "ci_low": {
          "maximum": 1,
          "minimum": -1,
          "title": "Ci Low",
          "type": "number"
        },
        "comparison": {
          "enum": [
            "finetuned_vs_production",
            "finetuned_vs_base"
          ],
          "title": "Comparison",
          "type": "string"
        },
        "delta": {
          "maximum": 1,
          "minimum": -1,
          "title": "Delta",
          "type": "number"
        },
        "metric": {
          "enum": [
            "recall_at_10",
            "mrr_at_10",
            "ndcg_at_10"
          ],
          "title": "Metric",
          "type": "string"
        },
        "slice": {
          "pattern": "^(overall|language:[a-z]{2,3}|pair:[a-z]{2,3}->[a-z]{2,3}|source:(synthetic|mined))$",
          "title": "Slice",
          "type": "string"
        }
      },
      "required": [
        "comparison",
        "metric",
        "slice",
        "delta",
        "ci_low",
        "ci_high"
      ],
      "title": "MetricDelta",
      "type": "object"
    },
    "ModelMetricsBlock": {
      "additionalProperties": false,
      "properties": {
        "by_language": {
          "additionalProperties": {
            "$ref": "#/$defs/IrMetrics"
          },
          "propertyNames": {
            "enum": [
              "zh",
              "en",
              "it"
            ]
          },
          "title": "By Language",
          "type": "object"
        },
        "by_pair": {
          "patternProperties": {
            "^[a-z]{2,3}->[a-z]{2,3}$": {
              "$ref": "#/$defs/IrMetrics"
            }
          },
          "title": "By Pair",
          "type": "object"
        },
        "by_source": {
          "additionalProperties": {
            "$ref": "#/$defs/IrMetrics"
          },
          "propertyNames": {
            "enum": [
              "synthetic",
              "mined"
            ]
          },
          "title": "By Source",
          "type": "object"
        },
        "overall": {
          "$ref": "#/$defs/IrMetrics"
        }
      },
      "required": [
        "overall",
        "by_language",
        "by_pair",
        "by_source"
      ],
      "title": "ModelMetricsBlock",
      "type": "object"
    },
    "OfflineEvalReport": {
      "additionalProperties": false,
      "properties": {
        "deltas": {
          "items": {
            "$ref": "#/$defs/MetricDelta"
          },
          "title": "Deltas",
          "type": "array"
        },
        "models": {
          "$ref": "#/$defs/OfflineModels"
        },
        "noise_band": {
          "maximum": 1,
          "minimum": 0,
          "title": "Noise Band",
          "type": "number"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "reasons": {
          "items": {
            "enum": [
              "below_production_overall",
              "language_slice_below_production",
              "below_base",
              "empty_test_split"
            ],
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        }
      },
      "required": [
        "models",
        "deltas",
        "noise_band",
        "passed",
        "reasons"
      ],
      "title": "OfflineEvalReport",
      "type": "object"
    },
    "OfflineModels": {
      "additionalProperties": false,
      "properties": {
        "base": {
          "$ref": "#/$defs/ModelMetricsBlock"
        },
        "finetuned": {
          "$ref": "#/$defs/ModelMetricsBlock"
        },
        "production": {
          "$ref": "#/$defs/ModelMetricsBlock"
        }
      },
      "required": [
        "base",
        "finetuned",
        "production"
      ],
      "title": "OfflineModels",
      "type": "object"
    },
    "ProbeSet": {
      "additionalProperties": false,
      "properties": {
        "document_prompt": {
          "maxLength": 1024,
          "title": "Document Prompt",
          "type": "string"
        },
        "query_prompt": {
          "maxLength": 1024,
          "title": "Query Prompt",
          "type": "string"
        },
        "texts": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Texts",
          "type": "array"
        },
        "vectors": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Vectors",
          "type": "array"
        }
      },
      "required": [
        "texts",
        "query_prompt",
        "document_prompt",
        "vectors"
      ],
      "title": "ProbeSet",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "anyOf": [
    {
      "properties": {
        "scope": {
          "const": "deployment"
        }
      },
      "required": [
        "scope"
      ],
      "type": "object"
    },
    {
      "properties": {
        "scope": {
          "const": "tenant"
        },
        "tenant_keys": {
          "maxItems": 1,
          "type": "array"
        }
      },
      "required": [
        "scope",
        "tenant_keys"
      ],
      "type": "object"
    }
  ],
  "properties": {
    "artifact_uri": {
      "maxLength": 2048,
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9+.-]*:[^@?#]+$",
      "title": "Artifact Uri",
      "type": "string"
    },
    "base_model": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}/[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
      "title": "Base Model",
      "type": "string"
    },
    "base_revision": {
      "pattern": "^[a-f0-9]{40}$",
      "title": "Base Revision",
      "type": "string"
    },
    "dataset_manifest_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Dataset Manifest Sha256",
      "type": "string"
    },
    "dims": {
      "const": 1024,
      "title": "Dims",
      "type": "integer"
    },
    "document_prompt": {
      "maxLength": 1024,
      "title": "Document Prompt",
      "type": "string"
    },
    "id": {
      "pattern": "^ft-[a-z0-9][a-z0-9.-]{2,58}$",
      "title": "Id",
      "type": "string"
    },
    "offline": {
      "$ref": "#/$defs/OfflineEvalReport"
    },
    "probe": {
      "$ref": "#/$defs/ProbeSet"
    },
    "query_prompt": {
      "maxLength": 1024,
      "title": "Query Prompt",
      "type": "string"
    },
    "scope": {
      "enum": [
        "deployment",
        "tenant"
      ],
      "title": "Scope",
      "type": "string"
    },
    "status": {
      "enum": [
        "candidate",
        "rejected_offline"
      ],
      "title": "Status",
      "type": "string"
    },
    "tenant_keys": {
      "items": {
        "pattern": "^(s:default|[uo]:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Tenant Keys",
      "type": "array"
    },
    "training_config_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Training Config Sha256",
      "type": "string"
    }
  },
  "required": [
    "id",
    "base_model",
    "base_revision",
    "dims",
    "scope",
    "tenant_keys",
    "dataset_manifest_sha256",
    "training_config_sha256",
    "query_prompt",
    "document_prompt",
    "offline",
    "status",
    "probe",
    "artifact_uri"
  ],
  "title": "ModelVersionCard",
  "type": "object"
}
