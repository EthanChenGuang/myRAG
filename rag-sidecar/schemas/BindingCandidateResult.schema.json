{
  "$defs": {
    "MetricValue": {
      "additionalProperties": false,
      "properties": {
        "n": {
          "minimum": 0,
          "title": "N",
          "type": "integer"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "value",
        "n"
      ],
      "title": "MetricValue",
      "type": "object"
    },
    "SliceMetrics": {
      "additionalProperties": false,
      "properties": {
        "correct_refusal_rate": {
          "$ref": "#/$defs/MetricValue"
        },
        "false_refusal_rate": {
          "$ref": "#/$defs/MetricValue"
        },
        "false_refusal_upper_95": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "False Refusal Upper 95"
        },
        "identifier_precision": {
          "$ref": "#/$defs/MetricValue"
        },
        "intent_coverage": {
          "$ref": "#/$defs/MetricValue"
        },
        "k_zero": {
          "$ref": "#/$defs/MetricValue"
        },
        "mrr": {
          "$ref": "#/$defs/MetricValue"
        },
        "ndcg_at_context_k": {
          "$ref": "#/$defs/MetricValue"
        },
        "near_miss_leakage": {
          "$ref": "#/$defs/MetricValue"
        },
        "recall_at_10": {
          "$ref": "#/$defs/MetricValue"
        },
        "recall_at_5": {
          "$ref": "#/$defs/MetricValue"
        },
        "topk_redundancy": {
          "$ref": "#/$defs/MetricValue"
        }
      },
      "required": [
        "recall_at_5",
        "recall_at_10",
        "mrr",
        "correct_refusal_rate",
        "false_refusal_rate"
      ],
      "title": "SliceMetrics",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "beats_baseline": {
      "title": "Beats Baseline",
      "type": "boolean"
    },
    "beats_control": {
      "title": "Beats Control",
      "type": "boolean"
    },
    "by_language": {
      "additionalProperties": {
        "$ref": "#/$defs/SliceMetrics"
      },
      "title": "By Language",
      "type": "object"
    },
    "deltas_vs_baseline": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "propertyNames": {
        "enum": [
          "recall_at_5",
          "recall_at_10",
          "mrr",
          "correct_refusal_rate",
          "false_refusal_rate"
        ]
      },
      "title": "Deltas Vs Baseline",
      "type": "object"
    },
    "deltas_vs_control": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "propertyNames": {
        "enum": [
          "recall_at_5",
          "recall_at_10",
          "mrr",
          "correct_refusal_rate",
          "false_refusal_rate"
        ]
      },
      "title": "Deltas Vs Control",
      "type": "object"
    },
    "doc_type_slice": {
      "$ref": "#/$defs/SliceMetrics"
    },
    "language_regressions": {
      "items": {
        "type": "string"
      },
      "title": "Language Regressions",
      "type": "array"
    },
    "latency_ms": {
      "additionalProperties": {
        "anyOf": [
          {
            "minimum": 0,
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Latency Ms",
      "type": "object"
    },
    "model": {
      "minLength": 1,
      "title": "Model",
      "type": "string"
    },
    "other_slice_regressions": {
      "items": {
        "type": "string"
      },
      "title": "Other Slice Regressions",
      "type": "array"
    },
    "pair_regressions": {
      "items": {
        "type": "string"
      },
      "title": "Pair Regressions",
      "type": "array"
    },
    "profile_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "title": "Profile Id",
      "type": "string"
    },
    "recommended": {
      "title": "Recommended",
      "type": "boolean"
    },
    "refusal_regressions": {
      "items": {
        "type": "string"
      },
      "title": "Refusal Regressions",
      "type": "array"
    },
    "report_path": {
      "minLength": 1,
      "title": "Report Path",
      "type": "string"
    },
    "supported_languages": {
      "items": {
        "type": "string"
      },
      "title": "Supported Languages",
      "type": "array"
    },
    "undeclared_languages": {
      "items": {
        "type": "string"
      },
      "title": "Undeclared Languages",
      "type": "array"
    }
  },
  "required": [
    "profile_id",
    "model",
    "report_path",
    "doc_type_slice",
    "by_language",
    "deltas_vs_baseline",
    "deltas_vs_control",
    "beats_baseline",
    "beats_control",
    "language_regressions",
    "pair_regressions",
    "other_slice_regressions",
    "refusal_regressions",
    "recommended"
  ],
  "title": "BindingCandidateResult",
  "type": "object"
}
