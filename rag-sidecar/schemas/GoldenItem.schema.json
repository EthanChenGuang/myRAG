{
  "$defs": {
    "AttackSpec": {
      "additionalProperties": false,
      "properties": {
        "canary": {
          "maxLength": 128,
          "minLength": 6,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Canary",
          "type": "string"
        },
        "forbidden_claims": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Forbidden Claims",
          "type": "array"
        },
        "injected_quotes": {
          "items": {
            "$ref": "#/$defs/GoldSpan"
          },
          "minItems": 1,
          "title": "Injected Quotes",
          "type": "array"
        }
      },
      "required": [
        "canary",
        "injected_quotes",
        "forbidden_claims"
      ],
      "title": "AttackSpec",
      "type": "object"
    },
    "ConversationTurn": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "role": {
          "enum": [
            "user",
            "assistant"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "title": "ConversationTurn",
      "type": "object"
    },
    "DateRangeFilter": {
      "additionalProperties": false,
      "properties": {
        "from": {
          "format": "date",
          "title": "From",
          "type": "string"
        },
        "include_undated": {
          "default": false,
          "title": "Include Undated",
          "type": "boolean"
        },
        "to": {
          "format": "date",
          "title": "To",
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "title": "DateRangeFilter",
      "type": "object"
    },
    "GoldSpan": {
      "additionalProperties": false,
      "properties": {
        "document": {
          "title": "Document",
          "type": "string"
        },
        "document_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Document Id",
          "type": "string"
        },
        "quote": {
          "minLength": 2,
          "title": "Quote",
          "type": "string"
        },
        "section": {
          "title": "Section",
          "type": "string"
        }
      },
      "required": [
        "document",
        "section",
        "quote"
      ],
      "title": "GoldSpan",
      "type": "object"
    },
    "InvoiceFilter": {
      "additionalProperties": false,
      "properties": {
        "amount_max": {
          "pattern": "^-?\\d+(\\.\\d{1,4})?$",
          "title": "Amount Max",
          "type": "string"
        },
        "amount_min": {
          "pattern": "^-?\\d+(\\.\\d{1,4})?$",
          "title": "Amount Min",
          "type": "string"
        },
        "currency": {
          "maxLength": 3,
          "minLength": 3,
          "title": "Currency",
          "type": "string"
        },
        "supplier": {
          "minLength": 1,
          "title": "Supplier",
          "type": "string"
        }
      },
      "required": [
        "supplier",
        "amount_min",
        "amount_max",
        "currency"
      ],
      "title": "InvoiceFilter",
      "type": "object"
    },
    "NativeReview": {
      "additionalProperties": false,
      "description": "Native-speaker review state of an item (D-45, XLG-02 delta); provenance is unchanged.",
      "properties": {
        "origin": {
          "enum": [
            "native",
            "machine_translated",
            "llm_drafted"
          ],
          "title": "Origin",
          "type": "string"
        },
        "reviewed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed At"
        },
        "reviewer": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer"
        },
        "status": {
          "enum": [
            "pending",
            "approved"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "origin",
        "status"
      ],
      "title": "NativeReview",
      "type": "object"
    },
    "OffTopicSpec": {
      "additionalProperties": false,
      "description": "D-53: neighbouring-subject spans an off_topic_context answer must not use, and where they score.",
      "properties": {
        "adjacent_quotes": {
          "items": {
            "$ref": "#/$defs/GoldSpan"
          },
          "minItems": 1,
          "title": "Adjacent Quotes",
          "type": "array"
        },
        "score_band": {
          "enum": [
            "below_threshold",
            "above_threshold"
          ],
          "title": "Score Band",
          "type": "string"
        }
      },
      "required": [
        "adjacent_quotes",
        "score_band"
      ],
      "title": "OffTopicSpec",
      "type": "object"
    },
    "PartialSpec": {
      "additionalProperties": false,
      "description": "D-53: what a partial_answer item's answer must use, what the documents leave open and what it must not claim.",
      "properties": {
        "covered": {
          "items": {
            "$ref": "#/$defs/GoldSpan"
          },
          "minItems": 1,
          "title": "Covered",
          "type": "array"
        },
        "forbidden_claims": {
          "items": {
            "maxLength": 200,
            "type": "string"
          },
          "title": "Forbidden Claims",
          "type": "array"
        },
        "uncovered_aspects": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Uncovered Aspects",
          "type": "array"
        }
      },
      "required": [
        "covered",
        "uncovered_aspects"
      ],
      "title": "PartialSpec",
      "type": "object"
    },
    "RetrievalFilters": {
      "additionalProperties": false,
      "properties": {
        "attributes": {
          "maxProperties": 30,
          "minProperties": 1,
          "patternProperties": {
            "^[a-z][a-z0-9_]{0,39}$": {
              "items": {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 50,
              "minItems": 1,
              "type": "array"
            }
          },
          "title": "Attributes",
          "type": "object"
        },
        "current_only": {
          "const": true,
          "default": true,
          "title": "Current Only",
          "type": "boolean"
        },
        "date_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/DateRangeFilter"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "doc_types": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "general",
                  "financial_report",
                  "contract_legal",
                  "invoice_receipt",
                  "product_technical",
                  "scanned_image"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doc Types"
        },
        "document_ids": {
          "anyOf": [
            {
              "items": {
                "format": "uuid",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Ids"
        },
        "include_untagged": {
          "title": "Include Untagged",
          "type": "boolean"
        },
        "invoice": {
          "anyOf": [
            {
              "$ref": "#/$defs/InvoiceFilter"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "languages": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "zh",
                  "en",
                  "it"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Languages"
        },
        "scopes": {
          "$ref": "#/$defs/ScopeFilter"
        },
        "sources": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sources"
        },
        "versions": {
          "anyOf": [
            {
              "enum": [
                "current",
                "all"
              ],
              "type": "string"
            },
            {
              "$ref": "#/$defs/VersionRange"
            }
          ],
          "title": "Versions"
        }
      },
      "title": "RetrievalFilters",
      "type": "object"
    },
    "ScopeFilter": {
      "additionalProperties": false,
      "description": "DATA-08 scope filter (D-39): OR within a dimension, AND across dimensions; only the three fixed dimensions.",
      "properties": {
        "department": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Department",
          "type": "array"
        },
        "legal_entity": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Legal Entity",
          "type": "array"
        },
        "region": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Region",
          "type": "array"
        }
      },
      "title": "ScopeFilter",
      "type": "object"
    },
    "TableAnswer": {
      "additionalProperties": false,
      "description": "The one cell a table_split item asks for, plus same-unit values from other cells (D-45).",
      "properties": {
        "column": {
          "minLength": 1,
          "title": "Column",
          "type": "string"
        },
        "distractor_values": {
          "items": {
            "type": "string"
          },
          "title": "Distractor Values",
          "type": "array"
        },
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value",
        "column"
      ],
      "title": "TableAnswer",
      "type": "object"
    },
    "VersionRange": {
      "additionalProperties": false,
      "description": "D-12: a version period; either bound may be left open, not both.",
      "properties": {
        "from": {
          "format": "date",
          "title": "From",
          "type": "string"
        },
        "to": {
          "format": "date",
          "title": "To",
          "type": "string"
        }
      },
      "title": "VersionRange",
      "type": "object"
    },
    "VersionedValue": {
      "additionalProperties": false,
      "description": "One version's evidence span, the value string it states and its version label (D-53).",
      "properties": {
        "span": {
          "$ref": "#/$defs/GoldSpan"
        },
        "value": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "version_label": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Version Label",
          "type": "string"
        }
      },
      "required": [
        "span",
        "value",
        "version_label"
      ],
      "title": "VersionedValue",
      "type": "object"
    },
    "VersionsSpec": {
      "additionalProperties": false,
      "description": "D-53: the current and the stale version of one rule; `historical` marks a question about the past.",
      "properties": {
        "current": {
          "$ref": "#/$defs/VersionedValue"
        },
        "historical": {
          "default": false,
          "title": "Historical",
          "type": "boolean"
        },
        "stale": {
          "$ref": "#/$defs/VersionedValue"
        }
      },
      "required": [
        "current",
        "stale"
      ],
      "title": "VersionsSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "answerable": {
      "title": "Answerable",
      "type": "boolean"
    },
    "attack": {
      "anyOf": [
        {
          "$ref": "#/$defs/AttackSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "category": {
      "enum": [
        "multi_turn",
        "compound",
        "exact_term",
        "table",
        "scanned",
        "no_answer",
        "general",
        "colloquial",
        "ambiguous",
        "typo",
        "cross_lingual",
        "selective_filter",
        "injection",
        "injection_evasive",
        "cache_paraphrase",
        "cache_near_miss",
        "small_talk",
        "table_split",
        "duplicate_flood",
        "identifier_near_miss",
        "templated_collection",
        "implicit_condition",
        "partial_answer",
        "stale_version",
        "off_topic_context"
      ],
      "title": "Category",
      "type": "string"
    },
    "conversation": {
      "items": {
        "$ref": "#/$defs/ConversationTurn"
      },
      "title": "Conversation",
      "type": "array"
    },
    "evidence_groups": {
      "items": {
        "items": {
          "minimum": 0,
          "type": "integer"
        },
        "type": "array"
      },
      "title": "Evidence Groups",
      "type": "array"
    },
    "evidence_language": {
      "anyOf": [
        {
          "enum": [
            "zh",
            "en",
            "it"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evidence Language"
    },
    "expected_answer": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Answer"
    },
    "gold_evidence": {
      "items": {
        "$ref": "#/$defs/GoldSpan"
      },
      "title": "Gold Evidence",
      "type": "array"
    },
    "id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Id",
      "type": "string"
    },
    "language": {
      "enum": [
        "zh",
        "en",
        "it"
      ],
      "title": "Language",
      "type": "string"
    },
    "native_review": {
      "$ref": "#/$defs/NativeReview"
    },
    "off_topic": {
      "$ref": "#/$defs/OffTopicSpec"
    },
    "pair_of": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pair Of"
    },
    "partial": {
      "$ref": "#/$defs/PartialSpec"
    },
    "provenance": {
      "enum": [
        "synthetic_fixture",
        "claude_draft",
        "ragas_generated",
        "human",
        "production",
        "historical",
        "paraphrased"
      ],
      "title": "Provenance",
      "type": "string"
    },
    "question": {
      "title": "Question",
      "type": "string"
    },
    "retrieval_filters": {
      "anyOf": [
        {
          "$ref": "#/$defs/RetrievalFilters"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "review_status": {
      "enum": [
        "draft",
        "approved",
        "rejected"
      ],
      "title": "Review Status",
      "type": "string"
    },
    "split": {
      "enum": [
        "dev",
        "test"
      ],
      "title": "Split",
      "type": "string"
    },
    "table_answer": {
      "$ref": "#/$defs/TableAnswer"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "versions": {
      "$ref": "#/$defs/VersionsSpec"
    }
  },
  "required": [
    "id",
    "question",
    "language",
    "category",
    "answerable",
    "review_status",
    "provenance",
    "split"
  ],
  "title": "GoldenItem",
  "type": "object"
}
