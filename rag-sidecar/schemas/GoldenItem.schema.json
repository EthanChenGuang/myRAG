{
  "$defs": {
    "AttackSpec": {
      "additionalProperties": false,
      "properties": {
        "canary": {
          "maxLength": 128,
          "minLength": 6,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Canary",
          "type": "string"
        },
        "forbidden_claims": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Forbidden Claims",
          "type": "array"
        },
        "injected_quotes": {
          "items": {
            "$ref": "#/$defs/GoldSpan"
          },
          "minItems": 1,
          "title": "Injected Quotes",
          "type": "array"
        }
      },
      "required": [
        "canary",
        "injected_quotes",
        "forbidden_claims"
      ],
      "title": "AttackSpec",
      "type": "object"
    },
    "ConversationTurn": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "role": {
          "enum": [
            "user",
            "assistant"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "title": "ConversationTurn",
      "type": "object"
    },
    "DateRangeFilter": {
      "additionalProperties": false,
      "properties": {
        "from": {
          "format": "date",
          "title": "From",
          "type": "string"
        },
        "include_undated": {
          "default": false,
          "title": "Include Undated",
          "type": "boolean"
        },
        "to": {
          "format": "date",
          "title": "To",
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "title": "DateRangeFilter",
      "type": "object"
    },
    "GoldSpan": {
      "additionalProperties": false,
      "properties": {
        "document": {
          "title": "Document",
          "type": "string"
        },
        "quote": {
          "minLength": 2,
          "title": "Quote",
          "type": "string"
        },
        "section": {
          "title": "Section",
          "type": "string"
        }
      },
      "required": [
        "document",
        "section",
        "quote"
      ],
      "title": "GoldSpan",
      "type": "object"
    },
    "InvoiceFilter": {
      "additionalProperties": false,
      "properties": {
        "amount_max": {
          "pattern": "^-?\\d+(\\.\\d{1,4})?$",
          "title": "Amount Max",
          "type": "string"
        },
        "amount_min": {
          "pattern": "^-?\\d+(\\.\\d{1,4})?$",
          "title": "Amount Min",
          "type": "string"
        },
        "currency": {
          "maxLength": 3,
          "minLength": 3,
          "title": "Currency",
          "type": "string"
        },
        "supplier": {
          "minLength": 1,
          "title": "Supplier",
          "type": "string"
        }
      },
      "required": [
        "supplier",
        "amount_min",
        "amount_max",
        "currency"
      ],
      "title": "InvoiceFilter",
      "type": "object"
    },
    "RetrievalFilters": {
      "additionalProperties": false,
      "properties": {
        "current_only": {
          "const": true,
          "default": true,
          "title": "Current Only",
          "type": "boolean"
        },
        "date_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/DateRangeFilter"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "doc_types": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "general",
                  "financial_report",
                  "contract_legal",
                  "invoice_receipt",
                  "product_technical",
                  "scanned_image"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doc Types"
        },
        "document_ids": {
          "anyOf": [
            {
              "items": {
                "format": "uuid",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Ids"
        },
        "include_untagged": {
          "title": "Include Untagged",
          "type": "boolean"
        },
        "invoice": {
          "anyOf": [
            {
              "$ref": "#/$defs/InvoiceFilter"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "languages": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "zh",
                  "en",
                  "it"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Languages"
        },
        "scopes": {
          "$ref": "#/$defs/ScopeFilter"
        },
        "sources": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sources"
        }
      },
      "title": "RetrievalFilters",
      "type": "object"
    },
    "ScopeFilter": {
      "additionalProperties": false,
      "description": "DATA-08 scope filter (D-39): OR within a dimension, AND across dimensions; only the three fixed dimensions.",
      "properties": {
        "department": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Department",
          "type": "array"
        },
        "legal_entity": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Legal Entity",
          "type": "array"
        },
        "region": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Region",
          "type": "array"
        }
      },
      "title": "ScopeFilter",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "answerable": {
      "title": "Answerable",
      "type": "boolean"
    },
    "attack": {
      "anyOf": [
        {
          "$ref": "#/$defs/AttackSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "category": {
      "enum": [
        "multi_turn",
        "compound",
        "exact_term",
        "table",
        "scanned",
        "no_answer",
        "general",
        "colloquial",
        "ambiguous",
        "typo",
        "cross_lingual",
        "selective_filter",
        "injection",
        "injection_evasive",
        "cache_paraphrase",
        "cache_near_miss",
        "small_talk"
      ],
      "title": "Category",
      "type": "string"
    },
    "conversation": {
      "items": {
        "$ref": "#/$defs/ConversationTurn"
      },
      "title": "Conversation",
      "type": "array"
    },
    "evidence_language": {
      "anyOf": [
        {
          "enum": [
            "zh",
            "en",
            "it"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evidence Language"
    },
    "expected_answer": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Answer"
    },
    "gold_evidence": {
      "items": {
        "$ref": "#/$defs/GoldSpan"
      },
      "title": "Gold Evidence",
      "type": "array"
    },
    "id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Id",
      "type": "string"
    },
    "language": {
      "enum": [
        "zh",
        "en",
        "it"
      ],
      "title": "Language",
      "type": "string"
    },
    "pair_of": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pair Of"
    },
    "provenance": {
      "enum": [
        "synthetic_fixture",
        "claude_draft",
        "ragas_generated",
        "human",
        "production"
      ],
      "title": "Provenance",
      "type": "string"
    },
    "question": {
      "title": "Question",
      "type": "string"
    },
    "retrieval_filters": {
      "anyOf": [
        {
          "$ref": "#/$defs/RetrievalFilters"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "review_status": {
      "enum": [
        "draft",
        "approved",
        "rejected"
      ],
      "title": "Review Status",
      "type": "string"
    },
    "split": {
      "enum": [
        "dev",
        "test"
      ],
      "title": "Split",
      "type": "string"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    }
  },
  "required": [
    "id",
    "question",
    "language",
    "category",
    "answerable",
    "review_status",
    "provenance",
    "split"
  ],
  "title": "GoldenItem",
  "type": "object"
}
