{
  "$defs": {
    "ConversationTurn": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "role": {
          "enum": [
            "user",
            "assistant"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "title": "ConversationTurn",
      "type": "object"
    },
    "DateRangeFilter": {
      "additionalProperties": false,
      "properties": {
        "from": {
          "format": "date",
          "title": "From",
          "type": "string"
        },
        "to": {
          "format": "date",
          "title": "To",
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "title": "DateRangeFilter",
      "type": "object"
    },
    "InvoiceFilter": {
      "additionalProperties": false,
      "properties": {
        "amount_max": {
          "pattern": "^-?\\d+(\\.\\d{1,4})?$",
          "title": "Amount Max",
          "type": "string"
        },
        "amount_min": {
          "pattern": "^-?\\d+(\\.\\d{1,4})?$",
          "title": "Amount Min",
          "type": "string"
        },
        "currency": {
          "maxLength": 3,
          "minLength": 3,
          "title": "Currency",
          "type": "string"
        },
        "supplier": {
          "minLength": 1,
          "title": "Supplier",
          "type": "string"
        }
      },
      "required": [
        "supplier",
        "amount_min",
        "amount_max",
        "currency"
      ],
      "title": "InvoiceFilter",
      "type": "object"
    },
    "RagRunOptions": {
      "additionalProperties": false,
      "properties": {
        "degrade": {
          "anyOf": [
            {
              "const": "drop_top_candidate",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Degrade"
        },
        "disabled_stages": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "refs",
                  "analyze",
                  "embed",
                  "search",
                  "legacy_rank",
                  "post_filter",
                  "assemble",
                  "voice_keyword_fallback",
                  "local_rerank"
                ],
                "type": "string"
              },
              "maxItems": 9,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Disabled Stages"
        },
        "embedding_profile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Embedding Profile"
        },
        "generator_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generator Model"
        },
        "max_results": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Results"
        },
        "organization_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Organization Id"
        },
        "retrieval_filters": {
          "anyOf": [
            {
              "$ref": "#/$defs/RetrievalFilters"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "retrieval_overrides": {
          "anyOf": [
            {
              "$ref": "#/$defs/RetrievalOverrides"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "stage_timeouts_ms": {
          "anyOf": [
            {
              "$ref": "#/$defs/StageTimeoutsMs"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "user_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User Id"
        }
      },
      "title": "RagRunOptions",
      "type": "object"
    },
    "RetrievalFilters": {
      "additionalProperties": false,
      "properties": {
        "current_only": {
          "const": true,
          "default": true,
          "title": "Current Only",
          "type": "boolean"
        },
        "date_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/DateRangeFilter"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "doc_types": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "general",
                  "financial_report",
                  "contract_legal",
                  "invoice_receipt",
                  "product_technical",
                  "scanned_image"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doc Types"
        },
        "document_ids": {
          "anyOf": [
            {
              "items": {
                "format": "uuid",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Ids"
        },
        "invoice": {
          "anyOf": [
            {
              "$ref": "#/$defs/InvoiceFilter"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "languages": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "zh",
                  "en",
                  "it"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Languages"
        },
        "sources": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sources"
        }
      },
      "title": "RetrievalFilters",
      "type": "object"
    },
    "RetrievalLegWeights": {
      "additionalProperties": false,
      "properties": {
        "dense": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Dense",
          "type": "number"
        },
        "exact_id": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Exact Id",
          "type": "number"
        },
        "lexical": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Lexical",
          "type": "number"
        }
      },
      "title": "RetrievalLegWeights",
      "type": "object"
    },
    "RetrievalOverrides": {
      "additionalProperties": false,
      "properties": {
        "candidate_pool_size": {
          "anyOf": [
            {
              "maximum": 200,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Pool Size"
        },
        "final_top_k": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Final Top K"
        },
        "leg_weights": {
          "anyOf": [
            {
              "$ref": "#/$defs/RetrievalLegWeights"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rerank_input_cap": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 50,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rerank Input Cap"
        },
        "rerank_model": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rerank Model"
        },
        "rrf_k": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rrf K"
        }
      },
      "title": "RetrievalOverrides",
      "type": "object"
    },
    "StageTimeoutsMs": {
      "additionalProperties": false,
      "properties": {
        "analyze": {
          "anyOf": [
            {
              "maximum": 60000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Analyze"
        },
        "assemble": {
          "anyOf": [
            {
              "maximum": 60000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assemble"
        },
        "embed": {
          "anyOf": [
            {
              "maximum": 60000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Embed"
        },
        "legacy_rank": {
          "anyOf": [
            {
              "maximum": 60000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Legacy Rank"
        },
        "local_rerank": {
          "anyOf": [
            {
              "maximum": 60000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Local Rerank"
        },
        "post_filter": {
          "anyOf": [
            {
              "maximum": 60000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Post Filter"
        },
        "refs": {
          "anyOf": [
            {
              "maximum": 60000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Refs"
        },
        "search": {
          "anyOf": [
            {
              "maximum": 60000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Search"
        },
        "voice_keyword_fallback": {
          "anyOf": [
            {
              "maximum": 60000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Voice Keyword Fallback"
        }
      },
      "title": "StageTimeoutsMs",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "conversation": {
      "items": {
        "$ref": "#/$defs/ConversationTurn"
      },
      "title": "Conversation",
      "type": "array"
    },
    "include_answer": {
      "default": false,
      "title": "Include Answer",
      "type": "boolean"
    },
    "item_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Item Id"
    },
    "options": {
      "$ref": "#/$defs/RagRunOptions"
    },
    "query": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Query",
      "type": "string"
    },
    "rag_mode": {
      "default": "strict",
      "enum": [
        "strict",
        "balanced",
        "flexible"
      ],
      "title": "Rag Mode",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "web_search": {
      "const": false,
      "default": false,
      "title": "Web Search",
      "type": "boolean"
    }
  },
  "required": [
    "query"
  ],
  "title": "RagRunRequest",
  "type": "object"
}
