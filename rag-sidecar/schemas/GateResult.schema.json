{
  "$defs": {
    "GateOffender": {
      "additionalProperties": false,
      "properties": {
        "baseline_mean": {
          "title": "Baseline Mean",
          "type": "number"
        },
        "direction": {
          "enum": [
            "higher",
            "lower"
          ],
          "title": "Direction",
          "type": "string"
        },
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "observed": {
          "title": "Observed",
          "type": "number"
        },
        "slice": {
          "title": "Slice",
          "type": "string"
        },
        "threshold": {
          "title": "Threshold",
          "type": "number"
        }
      },
      "required": [
        "slice",
        "metric",
        "baseline_mean",
        "threshold",
        "observed",
        "direction"
      ],
      "title": "GateOffender",
      "type": "object"
    },
    "PairedReport": {
      "additionalProperties": false,
      "properties": {
        "all_zero": {
          "title": "All Zero",
          "type": "boolean"
        },
        "resamples": {
          "minimum": 1,
          "title": "Resamples",
          "type": "integer"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "slices": {
          "additionalProperties": {
            "additionalProperties": {
              "$ref": "#/$defs/PairedStat"
            },
            "type": "object"
          },
          "title": "Slices",
          "type": "object"
        }
      },
      "required": [
        "seed",
        "resamples",
        "all_zero",
        "slices"
      ],
      "title": "PairedReport",
      "type": "object"
    },
    "PairedStat": {
      "additionalProperties": false,
      "properties": {
        "ci_high": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ci High"
        },
        "ci_low": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ci Low"
        },
        "mean_d": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mean D"
        },
        "n": {
          "minimum": 0,
          "title": "N",
          "type": "integer"
        },
        "n_nonzero": {
          "minimum": 0,
          "title": "N Nonzero",
          "type": "integer"
        }
      },
      "required": [
        "n",
        "n_nonzero",
        "mean_d",
        "ci_low",
        "ci_high"
      ],
      "title": "PairedStat",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "mismatches": {
      "items": {
        "type": "string"
      },
      "title": "Mismatches",
      "type": "array"
    },
    "offenders": {
      "items": {
        "$ref": "#/$defs/GateOffender"
      },
      "title": "Offenders",
      "type": "array"
    },
    "paired": {
      "anyOf": [
        {
          "$ref": "#/$defs/PairedReport"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "passed": {
      "title": "Passed",
      "type": "boolean"
    },
    "skipped": {
      "items": {
        "type": "string"
      },
      "title": "Skipped",
      "type": "array"
    }
  },
  "required": [
    "passed",
    "offenders",
    "skipped",
    "mismatches"
  ],
  "title": "GateResult",
  "type": "object"
}
