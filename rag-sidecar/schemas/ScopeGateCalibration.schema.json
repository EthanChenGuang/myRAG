          "type": "string"
        },
        "false_refusal_n": {
          "minimum": 0,
          "title": "False Refusal N",
          "type": "integer"
        },
        "false_refusal_rate": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "False Refusal Rate"
        },
        "false_refusal_upper_95": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "False Refusal Upper 95"
