          "type": "string"
        },
        "status": {
          "enum": [
            "calibrated",
            "uncalibrated"
          ],
          "title": "Status",
          "type": "string"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Threshold"
        }
      },
      "required": [
        "embedding_profile_id",
        "rag_mode",
        "threshold",
        "margin",
        "false_refusal_rate",
        "false_refusal_n",
        "correct_refusal_rate",
        "correct_refusal_n",
        "status"
      ],
      "title": "ScopeGateCalibrationCell",
      "type": "object"
    }
  },
  "additionalProperties": false,
