{
  "$defs": {
    "GoldenFilter": {
      "additionalProperties": false,
      "properties": {
        "gate_split": {
          "const": "dev",
          "title": "Gate Split",
          "type": "string"
        },
        "review_statuses": {
          "items": {
            "enum": [
              "approved",
              "draft"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Review Statuses",
          "type": "array"
        }
      },
      "required": [
        "review_statuses",
        "gate_split"
      ],
      "title": "GoldenFilter",
      "type": "object"
    },
    "ItemResult": {
      "additionalProperties": false,
      "properties": {
        "answerable": {
          "title": "Answerable",
          "type": "boolean"
        },
        "category": {
          "enum": [
            "multi_turn",
            "compound",
            "exact_term",
            "table",
            "scanned",
            "no_answer",
            "general"
          ],
          "title": "Category",
          "type": "string"
        },
        "first_hit_rank": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Hit Rank"
        },
        "item_id": {
          "title": "Item Id",
          "type": "string"
        },
        "language": {
          "enum": [
            "zh",
            "en",
            "it"
          ],
          "title": "Language",
          "type": "string"
        },
        "refused": {
          "title": "Refused",
          "type": "boolean"
        },
        "span_count": {
          "minimum": 0,
          "title": "Span Count",
          "type": "integer"
        },
        "spans_hit_at_10": {
          "minimum": 0,
          "title": "Spans Hit At 10",
          "type": "integer"
        },
        "spans_hit_at_5": {
          "minimum": 0,
          "title": "Spans Hit At 5",
          "type": "integer"
        },
        "split": {
          "enum": [
            "dev",
            "test"
          ],
          "title": "Split",
          "type": "string"
        }
      },
      "required": [
        "item_id",
        "language",
        "category",
        "split",
        "answerable",
        "refused",
        "span_count",
        "spans_hit_at_5",
        "spans_hit_at_10"
      ],
      "title": "ItemResult",
      "type": "object"
    },
    "MetricValue": {
      "additionalProperties": false,
      "properties": {
        "n": {
          "minimum": 0,
          "title": "N",
          "type": "integer"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "value",
        "n"
      ],
      "title": "MetricValue",
      "type": "object"
    },
    "RagRunOptions": {
      "additionalProperties": false,
      "properties": {
        "degrade": {
          "anyOf": [
            {
              "const": "drop_top_candidate",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Degrade"
        },
        "generator_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generator Model"
        },
        "max_results": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Results"
        },
        "organization_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Organization Id"
        },
        "user_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User Id"
        }
      },
      "title": "RagRunOptions",
      "type": "object"
    },
    "SliceMetrics": {
      "additionalProperties": false,
      "properties": {
        "correct_refusal_rate": {
          "$ref": "#/$defs/MetricValue"
        },
        "false_refusal_rate": {
          "$ref": "#/$defs/MetricValue"
        },
        "mrr": {
          "$ref": "#/$defs/MetricValue"
        },
        "recall_at_10": {
          "$ref": "#/$defs/MetricValue"
        },
        "recall_at_5": {
          "$ref": "#/$defs/MetricValue"
        }
      },
      "required": [
        "recall_at_5",
        "recall_at_10",
        "mrr",
        "correct_refusal_rate",
        "false_refusal_rate"
      ],
      "title": "SliceMetrics",
      "type": "object"
    },
    "StageLatency": {
      "additionalProperties": false,
      "properties": {
        "n": {
          "minimum": 0,
          "title": "N",
          "type": "integer"
        },
        "p50_ms": {
          "minimum": 0,
          "title": "P50 Ms",
          "type": "number"
        },
        "p95_ms": {
          "minimum": 0,
          "title": "P95 Ms",
          "type": "number"
        }
      },
      "required": [
        "p50_ms",
        "p95_ms",
        "n"
      ],
      "title": "StageLatency",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "by_category": {
      "additionalProperties": {
        "$ref": "#/$defs/SliceMetrics"
      },
      "title": "By Category",
      "type": "object"
    },
    "by_language": {
      "additionalProperties": {
        "$ref": "#/$defs/SliceMetrics"
      },
      "title": "By Language",
      "type": "object"
    },
    "by_language_category": {
      "additionalProperties": {
        "$ref": "#/$defs/SliceMetrics"
      },
      "title": "By Language Category",
      "type": "object"
    },
    "by_split": {
      "additionalProperties": {
        "$ref": "#/$defs/SliceMetrics"
      },
      "title": "By Split",
      "type": "object"
    },
    "corpus_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Corpus Sha256"
    },
    "deployment_mode": {
      "title": "Deployment Mode",
      "type": "string"
    },
    "embedder_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Embedder Id"
    },
    "embedder_source_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Embedder Source Sha256"
    },
    "embedder_version": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Embedder Version"
    },
    "golden_filter": {
      "$ref": "#/$defs/GoldenFilter"
    },
    "golden_sha256": {
      "title": "Golden Sha256",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/ItemResult"
      },
      "title": "Items",
      "type": "array"
    },
    "k_values": {
      "items": {
        "type": "integer"
      },
      "title": "K Values",
      "type": "array"
    },
    "latency": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/StageLatency"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latency"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "overall": {
      "$ref": "#/$defs/SliceMetrics"
    },
    "request_options": {
      "$ref": "#/$defs/RagRunOptions"
    },
    "run_config_hash": {
      "title": "Run Config Hash",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "tier": {
      "enum": [
        "smoke",
        "nightly",
        "live"
      ],
      "title": "Tier",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "tier",
    "run_config_hash",
    "golden_sha256",
    "golden_filter",
    "deployment_mode",
    "request_options",
    "k_values",
    "overall",
    "by_language",
    "by_category",
    "by_language_category",
    "by_split",
    "items"
  ],
  "title": "EvalReport",
  "type": "object"
}
