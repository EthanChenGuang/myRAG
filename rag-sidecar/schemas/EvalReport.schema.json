{
  "$defs": {
    "DateRangeFilter": {
      "additionalProperties": false,
      "properties": {
        "from": {
          "format": "date",
          "title": "From",
          "type": "string"
        },
        "to": {
          "format": "date",
          "title": "To",
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "title": "DateRangeFilter",
      "type": "object"
    },
    "GoldenFilter": {
      "additionalProperties": false,
      "properties": {
        "gate_split": {
          "const": "dev",
          "title": "Gate Split",
          "type": "string"
        },
        "review_statuses": {
          "items": {
            "enum": [
              "approved",
              "draft"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Review Statuses",
          "type": "array"
        }
      },
      "required": [
        "review_statuses",
        "gate_split"
      ],
      "title": "GoldenFilter",
      "type": "object"
    },
    "InvoiceFilter": {
      "additionalProperties": false,
      "properties": {
        "amount_max": {
          "pattern": "^-?\\d+(\\.\\d{1,4})?$",
          "title": "Amount Max",
          "type": "string"
        },
        "amount_min": {
          "pattern": "^-?\\d+(\\.\\d{1,4})?$",
          "title": "Amount Min",
          "type": "string"
        },
        "currency": {
          "maxLength": 3,
          "minLength": 3,
          "title": "Currency",
          "type": "string"
        },
        "supplier": {
          "minLength": 1,
          "title": "Supplier",
          "type": "string"
        }
      },
      "required": [
        "supplier",
        "amount_min",
        "amount_max",
        "currency"
      ],
      "title": "InvoiceFilter",
      "type": "object"
    },
    "ItemResult": {
      "additionalProperties": false,
      "properties": {
        "answerable": {
          "title": "Answerable",
          "type": "boolean"
        },
        "category": {
          "enum": [
            "multi_turn",
            "compound",
            "exact_term",
            "table",
            "scanned",
            "no_answer",
            "general",
            "colloquial",
            "ambiguous",
            "typo",
            "cross_lingual",
            "selective_filter"
          ],
          "title": "Category",
          "type": "string"
        },
        "evidence_language": {
          "anyOf": [
            {
              "enum": [
                "zh",
                "en",
                "it"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Language"
        },
        "first_hit_rank": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Hit Rank"
        },
        "item_id": {
          "title": "Item Id",
          "type": "string"
        },
        "language": {
          "enum": [
            "zh",
            "en",
            "it"
          ],
          "title": "Language",
          "type": "string"
        },
        "provenance": {
          "enum": [
            "synthetic_fixture",
            "claude_draft",
            "ragas_generated",
            "human",
            "production"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "refused": {
          "title": "Refused",
          "type": "boolean"
        },
        "span_count": {
          "minimum": 0,
          "title": "Span Count",
          "type": "integer"
        },
        "spans_hit_at_10": {
          "minimum": 0,
          "title": "Spans Hit At 10",
          "type": "integer"
        },
        "spans_hit_at_5": {
          "minimum": 0,
          "title": "Spans Hit At 5",
          "type": "integer"
        },
        "split": {
          "enum": [
            "dev",
            "test"
          ],
          "title": "Split",
          "type": "string"
        }
      },
      "required": [
        "item_id",
        "language",
        "category",
        "split",
        "provenance",
        "answerable",
        "refused",
        "span_count",
        "spans_hit_at_5",
        "spans_hit_at_10"
      ],
      "title": "ItemResult",
      "type": "object"
    },
    "MetricValue": {
      "additionalProperties": false,
      "properties": {
        "n": {
          "minimum": 0,
          "title": "N",
          "type": "integer"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "value",
        "n"
      ],
      "title": "MetricValue",
      "type": "object"
    },
    "RagRunOptions": {
      "additionalProperties": false,
      "properties": {
        "degrade": {
          "anyOf": [
            {
              "const": "drop_top_candidate",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Degrade"
        },
        "disabled_stages": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "refs",
                  "analyze",
                  "embed",
                  "search",
                  "legacy_rank",
                  "post_filter",
                  "assemble",
                  "voice_keyword_fallback",
                  "local_rerank"
                ],
                "type": "string"
              },
              "maxItems": 9,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Disabled Stages"
        },
        "embedding_profile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Embedding Profile"
        },
        "generator_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generator Model"
        },
        "max_results": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Results"
        },
        "organization_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Organization Id"
        },
        "retrieval_filters": {
          "anyOf": [
            {
              "$ref": "#/$defs/RetrievalFilters"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "retrieval_overrides": {
          "anyOf": [
            {
              "$ref": "#/$defs/RetrievalOverrides"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "stage_timeouts_ms": {
          "anyOf": [
            {
              "$ref": "#/$defs/StageTimeoutsMs"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "user_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User Id"
        }
      },
      "title": "RagRunOptions",
      "type": "object"
    },
    "RetrievalFilters": {
      "additionalProperties": false,
      "properties": {
        "current_only": {
          "const": true,
          "default": true,
          "title": "Current Only",
          "type": "boolean"
        },
        "date_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/DateRangeFilter"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "doc_types": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "general",
                  "financial_report",
                  "contract_legal",
                  "invoice_receipt",
                  "product_technical",
                  "scanned_image"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doc Types"
        },
        "document_ids": {
          "anyOf": [
            {
              "items": {
                "format": "uuid",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Ids"
        },
        "invoice": {
          "anyOf": [
            {
              "$ref": "#/$defs/InvoiceFilter"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "languages": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "zh",
                  "en",
                  "it"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Languages"
        },
        "sources": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sources"
        }
      },
      "title": "RetrievalFilters",
      "type": "object"
    },
    "RetrievalLegWeights": {
      "additionalProperties": false,
      "properties": {
        "dense": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Dense",
          "type": "number"
        },
        "exact_id": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Exact Id",
          "type": "number"
        },
        "lexical": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Lexical",
          "type": "number"
        }
      },
      "title": "RetrievalLegWeights",
      "type": "object"
    },
    "RetrievalOverrides": {
      "additionalProperties": false,
      "properties": {
        "candidate_pool_size": {
          "anyOf": [
            {
              "maximum": 200,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Pool Size"
        },
        "final_top_k": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Final Top K"
        },
        "leg_weights": {
          "anyOf": [
            {
              "$ref": "#/$defs/RetrievalLegWeights"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rerank_input_cap": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 50,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rerank Input Cap"
        },
        "rrf_k": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rrf K"
        }
      },
      "title": "RetrievalOverrides",
      "type": "object"
    },
    "SliceMetrics": {
      "additionalProperties": false,
      "properties": {
        "correct_refusal_rate": {
          "$ref": "#/$defs/MetricValue"
        },
        "false_refusal_rate": {
          "$ref": "#/$defs/MetricValue"
        },
        "mrr": {
          "$ref": "#/$defs/MetricValue"
        },
        "recall_at_10": {
          "$ref": "#/$defs/MetricValue"
        },
        "recall_at_5": {
          "$ref": "#/$defs/MetricValue"
        }
      },
      "required": [
        "recall_at_5",
        "recall_at_10",
        "mrr",
        "correct_refusal_rate",
        "false_refusal_rate"
      ],
      "title": "SliceMetrics",
      "type": "object"
    },
    "StageLatency": {
      "additionalProperties": false,
      "properties": {
        "n": {
          "minimum": 0,
          "title": "N",
          "type": "integer"
        },
        "p50_ms": {
          "minimum": 0,
          "title": "P50 Ms",
          "type": "number"
        },
        "p95_ms": {
          "minimum": 0,
          "title": "P95 Ms",
          "type": "number"
        }
      },
      "required": [
        "p50_ms",
        "p95_ms",
        "n"
      ],
      "title": "StageLatency",
      "type": "object"
    },
    "StageTimeoutsMs": {
      "additionalProperties": false,
      "properties": {
        "analyze": {
          "anyOf": [
            {
              "maximum": 60000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Analyze"
        },
        "assemble": {
          "anyOf": [
            {
              "maximum": 60000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assemble"
        },
        "embed": {
          "anyOf": [
            {
              "maximum": 60000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Embed"
        },
        "legacy_rank": {
          "anyOf": [
            {
              "maximum": 60000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Legacy Rank"
        },
        "local_rerank": {
          "anyOf": [
            {
              "maximum": 60000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Local Rerank"
        },
        "post_filter": {
          "anyOf": [
            {
              "maximum": 60000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Post Filter"
        },
        "refs": {
          "anyOf": [
            {
              "maximum": 60000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Refs"
        },
        "search": {
          "anyOf": [
            {
              "maximum": 60000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Search"
        },
        "voice_keyword_fallback": {
          "anyOf": [
            {
              "maximum": 60000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Voice Keyword Fallback"
        }
      },
      "title": "StageTimeoutsMs",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "by_category": {
      "additionalProperties": {
        "$ref": "#/$defs/SliceMetrics"
      },
      "title": "By Category",
      "type": "object"
    },
    "by_language": {
      "additionalProperties": {
        "$ref": "#/$defs/SliceMetrics"
      },
      "title": "By Language",
      "type": "object"
    },
    "by_language_category": {
      "additionalProperties": {
        "$ref": "#/$defs/SliceMetrics"
      },
      "title": "By Language Category",
      "type": "object"
    },
    "by_language_pair": {
      "additionalProperties": {
        "$ref": "#/$defs/SliceMetrics"
      },
      "title": "By Language Pair",
      "type": "object"
    },
    "by_provenance": {
      "additionalProperties": {
        "$ref": "#/$defs/SliceMetrics"
      },
      "title": "By Provenance",
      "type": "object"
    },
    "by_provenance_category": {
      "additionalProperties": {
        "$ref": "#/$defs/SliceMetrics"
      },
      "title": "By Provenance Category",
      "type": "object"
    },
    "by_split": {
      "additionalProperties": {
        "$ref": "#/$defs/SliceMetrics"
      },
      "title": "By Split",
      "type": "object"
    },
    "corpus_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Corpus Sha256"
    },
    "deployment_mode": {
      "title": "Deployment Mode",
      "type": "string"
    },
    "embedder_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Embedder Id"
    },
    "embedder_source_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Embedder Source Sha256"
    },
    "embedder_version": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Embedder Version"
    },
    "gate_population": {
      "default": "all",
      "enum": [
        "all",
        "production"
      ],
      "title": "Gate Population",
      "type": "string"
    },
    "golden_filter": {
      "$ref": "#/$defs/GoldenFilter"
    },
    "golden_sha256": {
      "title": "Golden Sha256",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/ItemResult"
      },
      "title": "Items",
      "type": "array"
    },
    "k_values": {
      "items": {
        "type": "integer"
      },
      "title": "K Values",
      "type": "array"
    },
    "latency": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/StageLatency"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latency"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "overall": {
      "$ref": "#/$defs/SliceMetrics"
    },
    "request_options": {
      "$ref": "#/$defs/RagRunOptions"
    },
    "run_config_hash": {
      "title": "Run Config Hash",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "tier": {
      "enum": [
        "smoke",
        "nightly",
        "live"
      ],
      "title": "Tier",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "tier",
    "run_config_hash",
    "golden_sha256",
    "golden_filter",
    "deployment_mode",
    "request_options",
    "k_values",
    "overall",
    "by_language",
    "by_category",
    "by_language_category",
    "by_split",
    "items"
  ],
  "title": "EvalReport",
  "type": "object"
}
