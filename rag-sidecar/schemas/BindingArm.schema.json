          "$ref": "#/$defs/MetricValue"
        },
        "mrr": {
          "$ref": "#/$defs/MetricValue"
        },
        "named_document_recall": {
          "$ref": "#/$defs/MetricValue"
        },
        "ndcg_at_context_k": {
          "$ref": "#/$defs/MetricValue"
        },
        "near_miss_leakage": {
          "$ref": "#/$defs/MetricValue"
        },
        "quantity_match_rate": {
          "$ref": "#/$defs/MetricValue"
        },
        "recall_at_10": {
          "$ref": "#/$defs/MetricValue"
        },
        "recall_at_5": {
          "$ref": "#/$defs/MetricValue"
