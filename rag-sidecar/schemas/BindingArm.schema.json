    "MetricValue": {
      "additionalProperties": false,
      "properties": {
        "n": {
          "minimum": 0,
          "title": "N",
          "type": "integer"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "value",
        "n"
      ],
      "title": "MetricValue",
      "type": "object"
    },
