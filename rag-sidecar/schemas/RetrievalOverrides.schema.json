{
  "$defs": {
    "DiversityParams": {
      "additionalProperties": false,
      "description": "D-21, D-48: MMR over the reranked list; lambda 0.7 until a live sweep sets the shipped value.",
      "properties": {
        "mmr_lambda": {
          "default": 0.7,
          "maximum": 1,
          "minimum": 0,
          "title": "Mmr Lambda",
          "type": "number"
        },
        "mmr_window_factor": {
          "default": 3,
          "maximum": 10,
          "minimum": 1,
          "title": "Mmr Window Factor",
          "type": "integer"
        }
      },
      "title": "DiversityParams",
      "type": "object"
    },
    "DupClusterParams": {
      "additionalProperties": false,
      "properties": {
        "by_profile": {
          "additionalProperties": {
            "$ref": "#/$defs/DupClusterProfileEntry"
          },
          "propertyNames": {
            "maxLength": 128,
            "minLength": 1
          },
          "title": "By Profile",
          "type": "object"
        },
        "threshold": {
          "default": 0.95,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Threshold",
          "type": "number"
        }
      },
      "title": "DupClusterParams",
      "type": "object"
    },
    "DupClusterProfileEntry": {
      "additionalProperties": false,
      "description": "D-49: a duplicate threshold for one embedding profile; a fixture-fitted value applies in eval only.",
      "properties": {
        "source": {
          "enum": [
            "fixture",
            "live"
          ],
          "title": "Source",
          "type": "string"
        },
        "threshold": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Threshold",
          "type": "number"
        }
      },
      "required": [
        "threshold",
        "source"
      ],
      "title": "DupClusterProfileEntry",
      "type": "object"
    },
    "RetrievalLegWeights": {
      "additionalProperties": false,
      "properties": {
        "dense": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Dense",
          "type": "number"
        },
        "domain": {
          "exclusiveMinimum": 0,
          "title": "Domain",
          "type": "number"
        },
        "exact_id": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Exact Id",
          "type": "number"
        },
        "lexical": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Lexical",
          "type": "number"
        },
        "translation": {
          "exclusiveMinimum": 0,
          "title": "Translation",
          "type": "number"
        }
      },
      "title": "RetrievalLegWeights",
      "type": "object"
    },
    "TableLookupParams": {
      "additionalProperties": false,
      "description": "D-15, D-16: the structured table leg; a row matches when at least min_cells distinct cells match.",
      "properties": {
        "limit": {
          "default": 10,
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "min_cells": {
          "default": 2,
          "maximum": 20,
          "minimum": 1,
          "title": "Min Cells",
          "type": "integer"
        },
        "weight": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Weight",
          "type": "number"
        }
      },
      "title": "TableLookupParams",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "backend": {
      "enum": [
        "pgvector",
        "weaviate",
        "qdrant"
      ],
      "title": "Backend",
      "type": "string"
    },
    "candidate_pool_size": {
      "anyOf": [
        {
          "maximum": 200,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Candidate Pool Size"
    },
    "chunking_profile_by_doc_type": {
      "additionalProperties": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "propertyNames": {
        "enum": [
          "general",
          "financial_report",
          "contract_legal",
          "invoice_receipt",
          "product_technical",
          "scanned_image"
        ]
      },
      "title": "Chunking Profile By Doc Type",
      "type": "object"
    },
    "diversity": {
      "$ref": "#/$defs/DiversityParams"
    },
    "dup_cluster": {
      "$ref": "#/$defs/DupClusterParams"
    },
    "final_top_k": {
      "anyOf": [
        {
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Final Top K"
    },
    "leg_weights": {
      "anyOf": [
        {
          "$ref": "#/$defs/RetrievalLegWeights"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "rerank_input_cap": {
      "anyOf": [
        {
          "maximum": 100,
          "minimum": 25,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rerank Input Cap"
    },
    "rerank_model": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rerank Model"
    },
    "rrf_k": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rrf K"
    },
    "table_lookup": {
      "$ref": "#/$defs/TableLookupParams"
    }
  },
  "title": "RetrievalOverrides",
  "type": "object"
}
