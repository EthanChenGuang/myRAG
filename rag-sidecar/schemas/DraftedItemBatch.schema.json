            "compound",
            "exact_term",
            "table",
            "scanned",
            "no_answer",
            "general",
            "colloquial",
            "ambiguous",
            "typo",
            "cross_lingual",
            "selective_filter",
            "injection",
            "injection_evasive",
            "cache_paraphrase",
            "cache_near_miss",
            "small_talk",
            "table_split"
