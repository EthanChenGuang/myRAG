{
  "$defs": {
    "DateRangeFilter": {
      "additionalProperties": false,
      "properties": {
        "from": {
          "format": "date",
          "title": "From",
          "type": "string"
        },
        "include_undated": {
          "default": false,
          "title": "Include Undated",
          "type": "boolean"
        },
        "to": {
          "format": "date",
          "title": "To",
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "title": "DateRangeFilter",
      "type": "object"
    },
    "InvoiceFilter": {
      "additionalProperties": false,
      "properties": {
        "amount_max": {
          "pattern": "^-?\\d+(\\.\\d{1,4})?$",
          "title": "Amount Max",
          "type": "string"
        },
        "amount_min": {
          "pattern": "^-?\\d+(\\.\\d{1,4})?$",
          "title": "Amount Min",
          "type": "string"
        },
        "currency": {
          "maxLength": 3,
          "minLength": 3,
          "title": "Currency",
          "type": "string"
        },
        "supplier": {
          "minLength": 1,
          "title": "Supplier",
          "type": "string"
        }
      },
      "required": [
        "supplier",
        "amount_min",
        "amount_max",
        "currency"
      ],
      "title": "InvoiceFilter",
      "type": "object"
    },
    "ScopeFilter": {
      "additionalProperties": false,
      "description": "DATA-08 scope filter (D-39): OR within a dimension, AND across dimensions; only the three fixed dimensions.",
      "properties": {
        "department": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Department",
          "type": "array"
        },
        "legal_entity": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Legal Entity",
          "type": "array"
        },
        "region": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Region",
          "type": "array"
        }
      },
      "title": "ScopeFilter",
      "type": "object"
    },
    "VersionRange": {
      "additionalProperties": false,
      "description": "D-12: a version period; either bound may be left open, not both.",
      "properties": {
        "from": {
          "format": "date",
          "title": "From",
          "type": "string"
        },
        "to": {
          "format": "date",
          "title": "To",
          "type": "string"
        }
      },
      "title": "VersionRange",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attributes": {
      "maxProperties": 30,
      "minProperties": 1,
      "patternProperties": {
        "^[a-z][a-z0-9_]{0,39}$": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "type": "array"
        }
      },
      "title": "Attributes",
      "type": "object"
    },
    "current_only": {
      "const": true,
      "default": true,
      "title": "Current Only",
      "type": "boolean"
    },
    "date_range": {
      "anyOf": [
        {
          "$ref": "#/$defs/DateRangeFilter"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "doc_types": {
      "anyOf": [
        {
          "items": {
            "enum": [
              "general",
              "financial_report",
              "contract_legal",
              "invoice_receipt",
              "product_technical",
              "scanned_image"
            ],
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Doc Types"
    },
    "document_ids": {
      "anyOf": [
        {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Document Ids"
    },
    "include_untagged": {
      "title": "Include Untagged",
      "type": "boolean"
    },
    "invoice": {
      "anyOf": [
        {
          "$ref": "#/$defs/InvoiceFilter"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "languages": {
      "anyOf": [
        {
          "items": {
            "enum": [
              "zh",
              "en",
              "it"
            ],
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Languages"
    },
    "scopes": {
      "$ref": "#/$defs/ScopeFilter"
    },
    "sources": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sources"
    },
    "versions": {
      "anyOf": [
        {
          "enum": [
            "current",
            "all"
          ],
          "type": "string"
        },
        {
          "$ref": "#/$defs/VersionRange"
        }
      ],
      "title": "Versions"
    }
  },
  "title": "RetrievalFilters",
  "type": "object"
}
