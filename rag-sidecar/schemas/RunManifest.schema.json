                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Languages"
        },
        "scopes": {
          "$ref": "#/$defs/ScopeFilter"
        },
        "sources": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sources"
        },
        "versions": {
          "anyOf": [
            {
              "enum": [
                "current",
                "all"
              ],
              "type": "string"
            },
            {
              "$ref": "#/$defs/VersionRange"
            }
          ],
          "title": "Versions"
        }
      },
      "title": "RetrievalFilters",
      "type": "object"
    },
