{
  "$defs": {
    "GoldenFilter": {
      "additionalProperties": false,
      "properties": {
        "gate_split": {
          "const": "dev",
          "title": "Gate Split",
          "type": "string"
        },
        "review_statuses": {
          "items": {
            "enum": [
              "approved",
              "draft"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Review Statuses",
          "type": "array"
        }
      },
      "required": [
        "review_statuses",
        "gate_split"
      ],
      "title": "GoldenFilter",
      "type": "object"
    },
    "RagRunOptions": {
      "additionalProperties": false,
      "properties": {
        "degrade": {
          "anyOf": [
            {
              "const": "drop_top_candidate",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Degrade"
        },
        "disabled_stages": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "refs",
                  "analyze",
                  "embed",
                  "search",
                  "legacy_rank",
                  "post_filter",
                  "assemble",
                  "voice_keyword_fallback",
                  "local_rerank"
                ],
                "type": "string"
              },
              "maxItems": 9,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Disabled Stages"
        },
        "generator_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generator Model"
        },
        "max_results": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Results"
        },
        "organization_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Organization Id"
        },
        "stage_timeouts_ms": {
          "anyOf": [
            {
              "$ref": "#/$defs/StageTimeoutsMs"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "user_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User Id"
        }
      },
      "title": "RagRunOptions",
      "type": "object"
    },
    "RunEmbedder": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "source_sha256": {
          "title": "Source Sha256",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "source_sha256"
      ],
      "title": "RunEmbedder",
      "type": "object"
    },
    "StageTimeoutsMs": {
      "additionalProperties": false,
      "properties": {
        "analyze": {
          "anyOf": [
            {
              "maximum": 60000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Analyze"
        },
        "assemble": {
          "anyOf": [
            {
              "maximum": 60000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assemble"
        },
        "embed": {
          "anyOf": [
            {
              "maximum": 60000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Embed"
        },
        "legacy_rank": {
          "anyOf": [
            {
              "maximum": 60000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Legacy Rank"
        },
        "local_rerank": {
          "anyOf": [
            {
              "maximum": 60000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Local Rerank"
        },
        "post_filter": {
          "anyOf": [
            {
              "maximum": 60000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Post Filter"
        },
        "refs": {
          "anyOf": [
            {
              "maximum": 60000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Refs"
        },
        "search": {
          "anyOf": [
            {
              "maximum": 60000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Search"
        },
        "voice_keyword_fallback": {
          "anyOf": [
            {
              "maximum": 60000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Voice Keyword Fallback"
        }
      },
      "title": "StageTimeoutsMs",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "corpus_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Corpus Sha256"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "deployment_mode": {
      "title": "Deployment Mode",
      "type": "string"
    },
    "edge_errors": {
      "minimum": 0,
      "title": "Edge Errors",
      "type": "integer"
    },
    "effective_config_hash": {
      "title": "Effective Config Hash",
      "type": "string"
    },
    "embedder": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunEmbedder"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "git_sha": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Git Sha"
    },
    "golden_filter": {
      "$ref": "#/$defs/GoldenFilter"
    },
    "golden_path": {
      "title": "Golden Path",
      "type": "string"
    },
    "golden_sha256": {
      "title": "Golden Sha256",
      "type": "string"
    },
    "item_count": {
      "minimum": 0,
      "title": "Item Count",
      "type": "integer"
    },
    "request_options": {
      "$ref": "#/$defs/RagRunOptions"
    },
    "run_config_hash": {
      "title": "Run Config Hash",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sql_sha256": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Sql Sha256",
      "type": "object"
    },
    "tier": {
      "enum": [
        "smoke",
        "nightly",
        "live"
      ],
      "title": "Tier",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "tier",
    "created_at",
    "deployment_mode",
    "golden_path",
    "golden_sha256",
    "golden_filter",
    "sql_sha256",
    "request_options",
    "effective_config_hash",
    "run_config_hash",
    "item_count",
    "edge_errors"
  ],
  "title": "RunManifest",
  "type": "object"
}
