{
  "$defs": {
    "ChunkingProfile": {
      "additionalProperties": false,
      "properties": {
        "child_tokens": {
          "minimum": 1,
          "title": "Child Tokens",
          "type": "integer"
        },
        "doc_type": {
          "enum": [
            "general",
            "financial_report",
            "contract_legal",
            "invoice_receipt",
            "product_technical",
            "scanned_image"
          ],
          "title": "Doc Type",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "parent_mode": {
          "enum": [
            "none",
            "structure",
            "fixed"
          ],
          "title": "Parent Mode",
          "type": "string"
        },
        "parent_tokens": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Tokens"
        },
        "preset": {
          "enum": [
            "128/512",
            "256/1024",
            "256/2048",
            "custom"
          ],
          "title": "Preset",
          "type": "string"
        },
        "status": {
          "enum": [
            "building",
            "ready",
            "active",
            "retired"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "doc_type",
        "child_tokens",
        "parent_mode",
        "status",
        "preset"
      ],
      "title": "ChunkingProfile",
      "type": "object"
    },
    "DateRangeFilter": {
      "additionalProperties": false,
      "properties": {
        "from": {
          "format": "date",
          "title": "From",
          "type": "string"
        },
        "include_undated": {
          "default": false,
          "title": "Include Undated",
          "type": "boolean"
        },
        "to": {
          "format": "date",
          "title": "To",
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "title": "DateRangeFilter",
      "type": "object"
    },
    "DiversityParams": {
      "additionalProperties": false,
      "description": "D-21, D-48: MMR over the reranked list; lambda 0.7 until a live sweep sets the shipped value.",
      "properties": {
        "mmr_lambda": {
          "default": 0.7,
          "maximum": 1,
          "minimum": 0,
          "title": "Mmr Lambda",
          "type": "number"
        },
        "mmr_window_factor": {
          "default": 3,
          "maximum": 10,
          "minimum": 1,
          "title": "Mmr Window Factor",
          "type": "integer"
        }
      },
      "title": "DiversityParams",
      "type": "object"
    },
    "DupClusterParams": {
      "additionalProperties": false,
      "properties": {
        "by_profile": {
          "additionalProperties": {
            "$ref": "#/$defs/DupClusterProfileEntry"
          },
          "propertyNames": {
            "maxLength": 128,
            "minLength": 1
          },
          "title": "By Profile",
          "type": "object"
        },
        "threshold": {
          "default": 0.95,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Threshold",
          "type": "number"
        }
      },
      "title": "DupClusterParams",
      "type": "object"
    },
    "DupClusterProfileEntry": {
      "additionalProperties": false,
      "description": "D-49: a duplicate threshold for one embedding profile; a fixture-fitted value applies in eval only.",
      "properties": {
        "source": {
          "enum": [
            "fixture",
            "live"
          ],
          "title": "Source",
          "type": "string"
        },
        "threshold": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Threshold",
          "type": "number"
        }
      },
      "required": [
        "threshold",
        "source"
      ],
      "title": "DupClusterProfileEntry",
      "type": "object"
    },
    "GoldenFilter": {
      "additionalProperties": false,
      "properties": {
        "gate_split": {
          "const": "dev",
          "title": "Gate Split",
          "type": "string"
        },
        "review_statuses": {
          "items": {
            "enum": [
              "approved",
              "draft"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Review Statuses",
          "type": "array"
        }
      },
      "required": [
        "review_statuses",
        "gate_split"
      ],
      "title": "GoldenFilter",
      "type": "object"
    },
    "InvoiceFilter": {
      "additionalProperties": false,
      "properties": {
        "amount_max": {
          "pattern": "^-?\\d+(\\.\\d{1,4})?$",
          "title": "Amount Max",
          "type": "string"
        },
        "amount_min": {
          "pattern": "^-?\\d+(\\.\\d{1,4})?$",
          "title": "Amount Min",
          "type": "string"
        },
        "currency": {
          "maxLength": 3,
          "minLength": 3,
          "title": "Currency",
          "type": "string"
        },
        "supplier": {
          "minLength": 1,
          "title": "Supplier",
          "type": "string"
        }
      },
      "required": [
        "supplier",
        "amount_min",
        "amount_max",
        "currency"
      ],
      "title": "InvoiceFilter",
      "type": "object"
    },
    "QueryBudgetMsOverride": {
      "additionalProperties": false,
      "properties": {
        "chat": {
          "anyOf": [
            {
              "maximum": 60000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chat"
        },
        "embed": {
          "anyOf": [
            {
              "maximum": 60000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Embed"
        },
        "voice": {
          "anyOf": [
            {
              "maximum": 60000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Voice"
        }
      },
      "title": "QueryBudgetMsOverride",
      "type": "object"
    },
    "QueryParamsOverride": {
      "additionalProperties": false,
      "properties": {
        "group_deadline_ms": {
          "anyOf": [
            {
              "maximum": 60000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group Deadline Ms"
        },
        "history_turn_chars": {
          "anyOf": [
            {
              "maximum": 4000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "History Turn Chars"
        },
        "history_turns": {
          "anyOf": [
            {
              "maximum": 20,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "History Turns"
        },
        "max_llm_variants": {
          "anyOf": [
            {
              "maximum": 2,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Llm Variants"
        },
        "max_searches": {
          "anyOf": [
            {
              "maximum": 8,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Searches"
        },
        "max_sub_questions": {
          "anyOf": [
            {
              "maximum": 4,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Sub Questions"
        },
        "max_translations": {
          "anyOf": [
            {
              "maximum": 2,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Translations"
        },
        "query_budget_ms": {
          "anyOf": [
            {
              "$ref": "#/$defs/QueryBudgetMsOverride"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "variant_max_chars": {
          "anyOf": [
            {
              "maximum": 4000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Variant Max Chars"
        },
        "variant_max_ratio": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 20,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Variant Max Ratio"
        }
      },
      "title": "QueryParamsOverride",
      "type": "object"
    },
    "QueryTransformToggles": {
      "additionalProperties": false,
      "properties": {
        "condense": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
