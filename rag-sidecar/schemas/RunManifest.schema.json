        },
        "translate": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Translate"
        }
      },
      "title": "QueryTransformToggles",
      "type": "object"
    },
    "RagRunOptions": {
      "additionalProperties": false,
      "properties": {
        "cache_seed_answer": {
          "anyOf": [
            {
              "maxLength": 4000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Seed Answer"
        },
        "citations": {
          "default": false,
          "title": "Citations",
          "type": "boolean"
        },
        "degrade": {
          "anyOf": [
            {
              "const": "drop_top_candidate",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Degrade"
        },
        "disabled_stages": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "refs",
                  "analyze",
                  "embed",
                  "search",
                  "legacy_rank",
                  "post_filter",
                  "assemble",
                  "voice_keyword_fallback",
                  "local_rerank",
                  "injection_check",
                  "query_gate",
                  "condense",
                  "normalize_dates",
                  "expand",
                  "hyde",
                  "decompose",
                  "terminology",
                  "semantic_cache"
                ],
                "type": "string"
              },
              "maxItems": 18,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Disabled Stages"
        },
        "domain_control_leg": {
          "anyOf": [
            {
              "enum": [
                "general",
                "financial_report",
                "contract_legal",
                "invoice_receipt",
                "product_technical",
                "scanned_image"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Domain Control Leg"
        },
        "embedding_bindings": {
          "anyOf": [
            {
              "additionalProperties": {
                "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
                "type": "string"
              },
              "maxProperties": 6,
              "propertyNames": {
                "enum": [
                  "general",
                  "financial_report",
                  "contract_legal",
                  "invoice_receipt",
                  "product_technical",
                  "scanned_image"
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Embedding Bindings"
        },
        "embedding_profile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Embedding Profile"
        },
        "generator_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generator Model"
        },
        "groundedness": {
          "default": false,
          "title": "Groundedness",
          "type": "boolean"
        },
        "max_results": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Results"
        },
        "organization_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Organization Id"
        },
        "query_framework": {
          "anyOf": [
            {
              "enum": [
                "llamaindex",
                "langchain"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query Framework"
        },
        "query_layer": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query Layer"
        },
        "query_params": {
          "anyOf": [
            {
              "$ref": "#/$defs/QueryParamsOverride"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "query_transforms": {
          "anyOf": [
            {
              "$ref": "#/$defs/QueryTransformToggles"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "retrieval_filters": {
          "anyOf": [
            {
              "$ref": "#/$defs/RetrievalFilters"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "retrieval_overrides": {
          "anyOf": [
            {
              "$ref": "#/$defs/RetrievalOverrides"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "semantic_cache": {
          "anyOf": [
            {
              "enum": [
                "off",
                "pgvector",
                "redisvl"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Semantic Cache"
        },
        "stage_timeouts_ms": {
          "anyOf": [
            {
              "$ref": "#/$defs/StageTimeoutsMs"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "user_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User Id"
        }
      },
      "title": "RagRunOptions",
      "type": "object"
    },
    "RetrievalFilters": {
      "additionalProperties": false,
      "properties": {
        "current_only": {
          "const": true,
          "default": true,
          "title": "Current Only",
          "type": "boolean"
        },
        "date_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/DateRangeFilter"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "doc_types": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "general",
                  "financial_report",
                  "contract_legal",
                  "invoice_receipt",
                  "product_technical",
                  "scanned_image"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doc Types"
        },
        "document_ids": {
          "anyOf": [
            {
              "items": {
                "format": "uuid",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Ids"
        },
        "include_untagged": {
          "title": "Include Untagged",
          "type": "boolean"
        },
        "invoice": {
          "anyOf": [
            {
              "$ref": "#/$defs/InvoiceFilter"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "languages": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "zh",
                  "en",
                  "it"
