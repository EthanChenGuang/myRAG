{
  "$defs": {
    "ChunkingProfile": {
      "additionalProperties": false,
      "properties": {
        "child_tokens": {
          "minimum": 1,
          "title": "Child Tokens",
          "type": "integer"
        },
        "doc_type": {
          "enum": [
            "general",
            "financial_report",
            "contract_legal",
            "invoice_receipt",
            "product_technical",
            "scanned_image"
          ],
          "title": "Doc Type",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "parent_mode": {
          "enum": [
            "none",
            "structure",
            "fixed"
          ],
          "title": "Parent Mode",
          "type": "string"
        },
        "parent_tokens": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Tokens"
        },
        "preset": {
          "enum": [
            "128/512",
            "256/1024",
            "256/2048",
            "custom"
          ],
          "title": "Preset",
          "type": "string"
        },
        "status": {
          "enum": [
            "building",
            "ready",
            "active",
            "retired"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "doc_type",
        "child_tokens",
        "parent_mode",
        "status",
        "preset"
      ],
      "title": "ChunkingProfile",
      "type": "object"
    },
    "DateRangeFilter": {
      "additionalProperties": false,
      "properties": {
        "from": {
          "format": "date",
          "title": "From",
          "type": "string"
        },
        "to": {
          "format": "date",
          "title": "To",
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "title": "DateRangeFilter",
      "type": "object"
    },
    "GoldenFilter": {
      "additionalProperties": false,
      "properties": {
        "gate_split": {
          "const": "dev",
          "title": "Gate Split",
          "type": "string"
        },
        "review_statuses": {
          "items": {
            "enum": [
              "approved",
              "draft"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Review Statuses",
          "type": "array"
        }
      },
      "required": [
        "review_statuses",
        "gate_split"
      ],
      "title": "GoldenFilter",
      "type": "object"
    },
    "InvoiceFilter": {
      "additionalProperties": false,
      "properties": {
        "amount_max": {
          "pattern": "^-?\\d+(\\.\\d{1,4})?$",
          "title": "Amount Max",
          "type": "string"
        },
        "amount_min": {
          "pattern": "^-?\\d+(\\.\\d{1,4})?$",
          "title": "Amount Min",
          "type": "string"
        },
        "currency": {
          "maxLength": 3,
          "minLength": 3,
          "title": "Currency",
          "type": "string"
        },
        "supplier": {
          "minLength": 1,
          "title": "Supplier",
          "type": "string"
        }
      },
      "required": [
        "supplier",
        "amount_min",
        "amount_max",
        "currency"
      ],
      "title": "InvoiceFilter",
      "type": "object"
    },
    "RagRunOptions": {
      "additionalProperties": false,
      "properties": {
        "citations": {
          "default": false,
          "title": "Citations",
          "type": "boolean"
        },
        "degrade": {
          "anyOf": [
            {
              "const": "drop_top_candidate",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Degrade"
        },
        "disabled_stages": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "refs",
                  "analyze",
                  "embed",
                  "search",
                  "legacy_rank",
                  "post_filter",
                  "assemble",
                  "voice_keyword_fallback",
                  "local_rerank"
                ],
                "type": "string"
              },
              "maxItems": 9,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Disabled Stages"
        },
        "embedding_profile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Embedding Profile"
        },
        "generator_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generator Model"
        },
        "groundedness": {
          "default": false,
          "title": "Groundedness",
          "type": "boolean"
        },
        "max_results": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Results"
        },
        "organization_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Organization Id"
        },
        "retrieval_filters": {
          "anyOf": [
            {
              "$ref": "#/$defs/RetrievalFilters"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "retrieval_overrides": {
          "anyOf": [
            {
              "$ref": "#/$defs/RetrievalOverrides"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "stage_timeouts_ms": {
          "anyOf": [
            {
              "$ref": "#/$defs/StageTimeoutsMs"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "user_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User Id"
        }
      },
      "title": "RagRunOptions",
      "type": "object"
    },
    "RetrievalFilters": {
      "additionalProperties": false,
      "properties": {
        "current_only": {
          "const": true,
          "default": true,
          "title": "Current Only",
          "type": "boolean"
        },
        "date_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/DateRangeFilter"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "doc_types": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "general",
                  "financial_report",
                  "contract_legal",
                  "invoice_receipt",
                  "product_technical",
                  "scanned_image"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doc Types"
        },
        "document_ids": {
          "anyOf": [
            {
              "items": {
                "format": "uuid",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Ids"
        },
        "invoice": {
          "anyOf": [
            {
              "$ref": "#/$defs/InvoiceFilter"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "languages": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "zh",
                  "en",
                  "it"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Languages"
        },
        "sources": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sources"
        }
      },
      "title": "RetrievalFilters",
      "type": "object"
    },
    "RetrievalLegWeights": {
      "additionalProperties": false,
      "properties": {
        "dense": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Dense",
          "type": "number"
        },
        "exact_id": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Exact Id",
          "type": "number"
        },
        "lexical": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Lexical",
          "type": "number"
        }
      },
      "title": "RetrievalLegWeights",
      "type": "object"
    },
    "RetrievalOverrides": {
      "additionalProperties": false,
      "properties": {
        "candidate_pool_size": {
          "anyOf": [
            {
              "maximum": 200,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Pool Size"
        },
        "chunking_profile_by_doc_type": {
          "additionalProperties": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "propertyNames": {
            "enum": [
              "general",
              "financial_report",
              "contract_legal",
              "invoice_receipt",
              "product_technical",
              "scanned_image"
            ]
          },
          "title": "Chunking Profile By Doc Type",
          "type": "object"
        },
        "final_top_k": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Final Top K"
        },
        "leg_weights": {
          "anyOf": [
            {
              "$ref": "#/$defs/RetrievalLegWeights"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rerank_input_cap": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 50,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rerank Input Cap"
        },
        "rerank_model": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rerank Model"
        },
        "rrf_k": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rrf K"
        }
      },
      "title": "RetrievalOverrides",
      "type": "object"
    },
    "RunConfigRecord": {
      "additionalProperties": false,
      "properties": {
        "chunking_profiles": {
          "items": {
            "$ref": "#/$defs/ChunkingProfile"
          },
          "title": "Chunking Profiles",
          "type": "array"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Env",
          "type": "object"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "overrides": {
          "anyOf": [
            {
              "$ref": "#/$defs/RetrievalOverrides"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "name"
      ],
      "title": "RunConfigRecord",
      "type": "object"
    },
    "RunEmbedder": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "source_sha256": {
          "title": "Source Sha256",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "source_sha256"
      ],
      "title": "RunEmbedder",
      "type": "object"
    },
    "StageTimeoutsMs": {
      "additionalProperties": false,
      "properties": {
        "analyze": {
          "anyOf": [
            {
              "maximum": 60000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Analyze"
        },
        "assemble": {
          "anyOf": [
            {
              "maximum": 60000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assemble"
        },
        "embed": {
          "anyOf": [
            {
              "maximum": 60000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Embed"
        },
        "legacy_rank": {
          "anyOf": [
            {
              "maximum": 60000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Legacy Rank"
        },
        "local_rerank": {
          "anyOf": [
            {
              "maximum": 60000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Local Rerank"
        },
        "post_filter": {
          "anyOf": [
            {
              "maximum": 60000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Post Filter"
        },
        "refs": {
          "anyOf": [
            {
              "maximum": 60000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Refs"
        },
        "search": {
          "anyOf": [
            {
              "maximum": 60000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Search"
        },
        "voice_keyword_fallback": {
          "anyOf": [
            {
              "maximum": 60000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Voice Keyword Fallback"
        }
      },
      "title": "StageTimeoutsMs",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "corpus_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Corpus Sha256"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "deployment_mode": {
      "title": "Deployment Mode",
      "type": "string"
    },
    "edge_errors": {
      "minimum": 0,
      "title": "Edge Errors",
      "type": "integer"
    },
    "effective_config_hash": {
      "title": "Effective Config Hash",
      "type": "string"
    },
    "embedder": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunEmbedder"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "embedding_profile": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Embedding Profile"
    },
    "git_sha": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Git Sha"
    },
    "golden_filter": {
      "$ref": "#/$defs/GoldenFilter"
    },
    "golden_path": {
      "title": "Golden Path",
      "type": "string"
    },
    "golden_sha256": {
      "title": "Golden Sha256",
      "type": "string"
    },
    "item_count": {
      "minimum": 0,
      "title": "Item Count",
      "type": "integer"
    },
    "request_options": {
      "$ref": "#/$defs/RagRunOptions"
    },
    "run_config": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunConfigRecord"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "run_config_hash": {
      "title": "Run Config Hash",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sql_sha256": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Sql Sha256",
      "type": "object"
    },
    "tier": {
      "enum": [
        "smoke",
        "nightly",
        "live"
      ],
      "title": "Tier",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "tier",
    "created_at",
    "deployment_mode",
    "golden_path",
    "golden_sha256",
    "golden_filter",
    "sql_sha256",
    "request_options",
    "effective_config_hash",
    "run_config_hash",
    "item_count",
    "edge_errors"
  ],
  "title": "RunManifest",
  "type": "object"
}
