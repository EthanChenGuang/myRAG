        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lease Until"
    },
    "lineage_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lineage Id"
    },
    "locked_by": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Locked By"
    },
    "max_retries": {
      "default": 3,
      "minimum": 0,
      "title": "Max Retries",
      "type": "integer"
    },
    "mime_type": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mime Type"
    },
    "needs_review_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Needs Review Reason"
    },
    "original_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/OriginalRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "page_ranges": {
      "items": {
        "$ref": "#/$defs/PageRange"
      },
      "title": "Page Ranges",
      "type": "array"
    },
    "pages": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pages"
    },
    "parser_used": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parser Used"
    },
    "parser_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parser Version"
    },
    "preflight_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Preflight Ref"
    },
    "priority": {
      "default": 100,
      "minimum": 0,
      "title": "Priority",
      "type": "integer"
    },
    "provisional_published_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provisional Published At"
    },
    "retries": {
      "default": 0,
      "minimum": 0,
      "title": "Retries",
      "type": "integer"
    },
    "routing_note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Routing Note"
    },
    "run_after": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run After"
    },
    "runner": {
      "anyOf": [
        {
          "enum": [
            "worker",
            "ray"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Runner"
    },
    "settings": {
      "$ref": "#/$defs/JobSettingsSnapshot"
    },
    "source": {
      "title": "Source",
      "type": "string"
    },
    "source_key": {
      "title": "Source Key",
      "type": "string"
    },
    "stage": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stage"
    },
    "stage_state": {
      "additionalProperties": true,
      "title": "Stage State",
      "type": "object"
    },
    "status": {
      "enum": [
        "queued",
        "preflight",
        "parsing",
        "checking",
        "chunking",
        "embedding",
        "ready",
        "failed",
        "quarantined",
        "needs_review",
        "skipped_duplicate"
      ],
      "title": "Status",
      "type": "string"
    },
    "tenant_key": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Tenant Key",
      "type": "string"
    },
    "tier": {
      "anyOf": [
        {
          "enum": [
            "native",
            "fast",
            "structured",
            "premium"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tier"
    },
    "tier_page_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Tier Page Counts",
      "type": "object"
    },
    "timings": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Timings",
      "type": "object"
    },
    "trace_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
