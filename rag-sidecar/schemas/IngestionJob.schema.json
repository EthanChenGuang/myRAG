      "type": "string"
    },
    "kind": {
      "enum": [
        "ingest",
        "dry_run",
        "delete"
      ],
      "title": "Kind",
      "type": "string"
    },
    "lease_until": {
      "anyOf": [
        {
          "format": "date-time",
