{
  "$defs": {
    "DictionaryTerm": {
      "additionalProperties": false,
      "properties": {
        "canonical_language": {
          "anyOf": [
            {
              "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Target language of canonical_term; required when relation is translation.",
          "title": "Canonical Language"
        },
        "canonical_term": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Canonical Term",
          "type": "string"
        },
        "observed_term": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Observed Term",
          "type": "string"
        },
        "relation": {
          "enum": [
            "synonym",
            "abbreviation",
            "translation",
            "misspelling"
          ],
          "title": "Relation",
          "type": "string"
        }
      },
      "required": [
        "observed_term",
        "canonical_term",
        "relation"
      ],
      "title": "DictionaryTerm",
      "type": "object"
    },
    "ExpertEvidenceSpan": {
      "additionalProperties": false,
      "properties": {
        "chunk_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Chunk Id",
          "type": "string"
        },
        "document_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Document Id",
          "type": "string"
        },
        "document_name": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Document Name",
          "type": "string"
        },
        "quote": {
          "maxLength": 2000,
          "minLength": 2,
          "title": "Quote",
          "type": "string"
        },
        "section": {
          "maxLength": 512,
          "title": "Section",
          "type": "string"
        }
      },
      "required": [
        "chunk_id",
        "document_id",
        "document_name",
        "section",
        "quote"
      ],
      "title": "ExpertEvidenceSpan",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "D-18 label. A later contract version may add optional fields with defaults; unknown keys stay forbidden.",
  "properties": {
    "answerable": {
      "title": "Answerable",
      "type": "boolean"
    },
    "category": {
      "enum": [
        "multi_turn",
        "compound",
        "exact_term",
        "table",
        "scanned",
        "no_answer",
        "general",
        "colloquial",
        "ambiguous",
        "typo",
        "cross_lingual",
        "selective_filter",
        "injection",
        "injection_evasive",
        "cache_paraphrase",
        "cache_near_miss",
        "small_talk",
        "table_split",
        "duplicate_flood",
        "identifier_near_miss",
        "implicit_condition"
      ],
      "title": "Category",
      "type": "string"
    },
    "confirm_near_duplicate_of": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confirm Near Duplicate Of"
    },
    "dictionary_terms": {
      "items": {
        "$ref": "#/$defs/DictionaryTerm"
      },
      "maxItems": 20,
      "title": "Dictionary Terms",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/ExpertEvidenceSpan"
      },
      "maxItems": 20,
      "title": "Evidence",
      "type": "array"
    },
    "expected_answer": {
      "anyOf": [
        {
          "maxLength": 4000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Answer"
    },
    "language": {
      "enum": [
        "zh",
        "en",
        "it"
      ],
      "title": "Language",
      "type": "string"
    },
    "not_relevant_chunk_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 50,
      "title": "Not Relevant Chunk Ids",
      "type": "array",
      "uniqueItems": true
    },
    "paraphrased_question": {
      "anyOf": [
        {
          "maxLength": 1000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Paraphrased Question"
    },
    "pii_checked": {
      "default": false,
      "title": "Pii Checked",
      "type": "boolean"
    },
    "triage": {
      "items": {
        "enum": [
          "dictionary",
          "training",
          "golden",
          "kb_gap",
          "not_a_failure"
        ],
        "type": "string"
      },
      "minItems": 1,
      "title": "Triage",
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "answerable",
    "category",
    "language",
    "triage"
  ],
  "title": "ExpertLabel",
  "type": "object"
}
