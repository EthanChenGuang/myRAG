    },
    "tenant_key": {
      "minLength": 1,
      "title": "Tenant Key",
      "type": "string"
    },
    "trace_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Trace Id"
    },
    "uploader_id": {
      "anyOf": [
        {
          "format": "uuid",
