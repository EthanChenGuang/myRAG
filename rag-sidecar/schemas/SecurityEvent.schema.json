        "detected",
        "quarantined",
        "dropped",
        "downweighted",
        "removed",
        "blocked",
        "warned"
      ],
      "title": "Action",
      "type": "string"
    },
    "chunk_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Chunk Id"
    },
    "created_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Created At"
    },
    "detector": {
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "title": "Detector",
      "type": "string"
    },
    "document_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Document Id"
    },
    "id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
