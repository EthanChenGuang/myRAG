{
  "$defs": {
    "ComparisonSliceBlock": {
      "additionalProperties": false,
      "properties": {
        "by_category": {
          "additionalProperties": {
            "$ref": "#/$defs/SliceMetrics"
          },
          "title": "By Category",
          "type": "object"
        },
        "by_language": {
          "additionalProperties": {
            "$ref": "#/$defs/SliceMetrics"
          },
          "title": "By Language",
          "type": "object"
        },
        "by_language_pair": {
          "additionalProperties": {
            "$ref": "#/$defs/SliceMetrics"
          },
          "title": "By Language Pair",
          "type": "object"
        },
        "overall": {
          "$ref": "#/$defs/SliceMetrics"
        }
      },
      "required": [
        "overall",
        "by_language",
        "by_category",
        "by_language_pair"
      ],
      "title": "ComparisonSliceBlock",
      "type": "object"
    },
    "MetricValue": {
      "additionalProperties": false,
      "properties": {
        "n": {
          "minimum": 0,
          "title": "N",
          "type": "integer"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "value",
        "n"
      ],
      "title": "MetricValue",
      "type": "object"
    },
    "PreMigrationSlice": {
      "additionalProperties": false,
      "properties": {
        "mrr": {
          "$ref": "#/$defs/MetricValue"
        },
        "n": {
          "minimum": 0,
          "title": "N",
          "type": "integer"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "recall_at_10": {
          "$ref": "#/$defs/MetricValue"
        },
        "recall_at_5": {
          "$ref": "#/$defs/MetricValue"
        }
      },
      "required": [
        "n",
        "passed",
        "recall_at_5",
        "recall_at_10",
        "mrr"
      ],
      "title": "PreMigrationSlice",
      "type": "object"
    },
    "ProfileComparisonEntry": {
      "additionalProperties": false,
      "properties": {
        "default_candidate": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default Candidate"
        },
        "default_candidate_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default Candidate Note"
        },
        "metrics": {
          "$ref": "#/$defs/ProfileMetricBlocks"
        },
        "profile_id": {
          "title": "Profile Id",
          "type": "string"
        }
      },
      "required": [
        "profile_id",
        "metrics"
      ],
      "title": "ProfileComparisonEntry",
      "type": "object"
    },
    "ProfileMetricBlocks": {
      "additionalProperties": false,
      "properties": {
        "candidates": {
          "$ref": "#/$defs/ComparisonSliceBlock"
        },
        "gated": {
          "$ref": "#/$defs/ComparisonSliceBlock"
        }
      },
      "required": [
        "gated",
        "candidates"
      ],
      "title": "ProfileMetricBlocks",
      "type": "object"
    },
    "SliceMetrics": {
      "additionalProperties": false,
      "properties": {
        "attribute_filter_fallback_rate": {
          "$ref": "#/$defs/MetricValue"
        },
        "boilerplate_token_share": {
          "$ref": "#/$defs/MetricValue"
        },
        "conversational_rate": {
          "$ref": "#/$defs/MetricValue"
        },
        "correct_refusal_rate": {
          "$ref": "#/$defs/MetricValue"
        },
        "false_refusal_rate": {
          "$ref": "#/$defs/MetricValue"
        },
        "false_refusal_upper_95": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "False Refusal Upper 95"
        },
        "identifier_precision": {
          "$ref": "#/$defs/MetricValue"
        },
        "intent_coverage": {
          "$ref": "#/$defs/MetricValue"
        },
        "k_zero": {
          "$ref": "#/$defs/MetricValue"
        },
        "mrr": {
          "$ref": "#/$defs/MetricValue"
        },
        "named_document_recall": {
          "$ref": "#/$defs/MetricValue"
        },
        "ndcg_at_context_k": {
          "$ref": "#/$defs/MetricValue"
        },
        "near_miss_leakage": {
          "$ref": "#/$defs/MetricValue"
        },
        "quantity_match_rate": {
          "$ref": "#/$defs/MetricValue"
        },
        "recall_at_10": {
          "$ref": "#/$defs/MetricValue"
        },
        "recall_at_5": {
          "$ref": "#/$defs/MetricValue"
        },
        "topk_redundancy": {
          "$ref": "#/$defs/MetricValue"
        },
        "variant_accuracy": {
          "$ref": "#/$defs/MetricValue"
        },
        "wrong_document_at_1": {
          "$ref": "#/$defs/MetricValue"
        }
      },
      "required": [
        "recall_at_5",
        "recall_at_10",
        "mrr",
        "correct_refusal_rate",
        "false_refusal_rate"
      ],
      "title": "SliceMetrics",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "active_profile": {
      "title": "Active Profile",
      "type": "string"
    },
    "backfill_run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Backfill Run Id"
    },
    "baseline_profile": {
      "title": "Baseline Profile",
      "type": "string"
    },
    "gate_passed": {
      "title": "Gate Passed",
      "type": "boolean"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "pre_migration": {
      "$ref": "#/$defs/PreMigrationSlice"
    },
    "profiles": {
      "items": {
        "$ref": "#/$defs/ProfileComparisonEntry"
      },
      "title": "Profiles",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "baseline_profile",
    "active_profile",
    "profiles",
    "pre_migration",
    "gate_passed"
  ],
  "title": "EmbeddingProfileComparison",
  "type": "object"
}
