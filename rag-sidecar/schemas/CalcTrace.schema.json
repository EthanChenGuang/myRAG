{
  "$defs": {
    "CalcOperand": {
      "additionalProperties": false,
      "description": "One sourced input: a single decimal or ISO date (`value`) or a list of decimals (`values`).",
      "properties": {
        "name": {
          "pattern": "^(?!(?:constructor|prototype|valueof|tostring|hasownproperty)$)[a-z][a-z0-9_]{0,31}$",
          "title": "Name",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/CalcSource"
        },
        "unit": {
          "pattern": "^[A-Za-z0-9\\u00C0-\\u024F\\u0370-\\u03FF\\u0400-\\u04FF\\u3040-\\u30FF\\u3400-\\u4DBF\\u4E00-\\u9FFF\\uAC00-\\uD7AF$\\u00A2-\\u00A5\\u20A0-\\u20CF %/._\\u00B0\\-]{1,32}$",
          "title": "Unit",
          "type": "string"
        },
        "unit_from": {
          "pattern": "^[A-Za-z0-9\\u00C0-\\u024F\\u0370-\\u03FF\\u0400-\\u04FF\\u3040-\\u30FF\\u3400-\\u4DBF\\u4E00-\\u9FFF\\uAC00-\\uD7AF$\\u00A2-\\u00A5\\u20A0-\\u20CF %/._\\u00B0\\-]{1,32}$",
          "title": "Unit From",
          "type": "string"
        },
        "unit_to": {
          "pattern": "^[A-Za-z0-9\\u00C0-\\u024F\\u0370-\\u03FF\\u0400-\\u04FF\\u3040-\\u30FF\\u3400-\\u4DBF\\u4E00-\\u9FFF\\uAC00-\\uD7AF$\\u00A2-\\u00A5\\u20A0-\\u20CF %/._\\u00B0\\-]{1,32}$",
          "title": "Unit To",
          "type": "string"
        },
        "value": {
          "pattern": "^(-?[0-9]{1,30}(\\.[0-9]{1,30})?|[0-9]{4}-[0-9]{2}-[0-9]{2})$",
          "title": "Value",
          "type": "string"
        },
        "values": {
          "items": {
            "pattern": "^-?[0-9]{1,30}(\\.[0-9]{1,30})?$",
            "type": "string"
          },
          "maxItems": 200,
          "minItems": 1,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "name",
        "source"
      ],
      "title": "CalcOperand",
      "type": "object"
    },
    "CalcRequest": {
      "additionalProperties": false,
      "description": "A structured calculation; each step argument names an operand or an earlier step, never a literal.",
      "properties": {
        "operands": {
          "items": {
            "$ref": "#/$defs/CalcOperand"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Operands",
          "type": "array"
        },
        "result": {
          "pattern": "^(?!(?:constructor|prototype|valueof|tostring|hasownproperty)$)[a-z][a-z0-9_]{0,31}$",
          "title": "Result",
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/CalcStep"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        }
      },
      "required": [
        "operands",
        "steps",
        "result"
      ],
      "title": "CalcRequest",
      "type": "object"
    },
    "CalcResult": {
      "additionalProperties": false,
      "properties": {
        "reject_reason": {
          "anyOf": [
            {
              "enum": [
                "invalid_request",
                "unsourced_operand",
                "unknown_source",
                "unknown_argument",
                "mixed_units",
                "limit_exceeded",
                "division_by_zero",
                "invalid_value",
                "invalid_date",
                "unsupported_source"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reject Reason"
        },
        "status": {
          "enum": [
            "ok",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/CalcStepResult"
          },
          "title": "Steps",
          "type": "array"
        },
        "unit": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9\\u00C0-\\u024F\\u0370-\\u03FF\\u0400-\\u04FF\\u3040-\\u30FF\\u3400-\\u4DBF\\u4E00-\\u9FFF\\uAC00-\\uD7AF$\\u00A2-\\u00A5\\u20A0-\\u20CF %/._\\u00B0\\-]{1,32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "value": {
          "anyOf": [
            {
              "pattern": "^-?[0-9]{1,30}(\\.[0-9]{1,30})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "status"
      ],
      "title": "CalcResult",
      "type": "object"
    },
    "CalcRounding": {
      "additionalProperties": false,
      "description": "Rounding to `places` decimal places, applied only where a step states it.\n\nModes: `half_up` rounds ties away from zero; `half_even` (the default rule) rounds ties to even; `up` rounds\naway from zero; `down` rounds toward zero.",
      "properties": {
        "mode": {
          "default": "half_even",
          "enum": [
            "half_up",
            "half_even",
            "up",
            "down"
          ],
          "title": "Mode",
          "type": "string"
        },
        "places": {
          "maximum": 20,
          "minimum": 0,
          "title": "Places",
          "type": "integer"
        }
      },
      "required": [
        "places"
      ],
      "title": "CalcRounding",
      "type": "object"
    },
    "CalcSource": {
      "additionalProperties": false,
      "description": "Where an operand comes from: the question, a cited context block (by alias) or a fact tool (reserved, SEC-05).",
      "properties": {
        "alias": {
          "pattern": "^[A-Z][0-9]{1,3}$",
          "title": "Alias",
          "type": "string"
        },
        "key": {
          "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "enum": [
            "question",
            "chunk",
            "fact_tool"
          ],
          "title": "Kind",
          "type": "string"
        },
        "tool": {
          "pattern": "^(?!(?:constructor|prototype|valueof|tostring|hasownproperty)$)[a-z][a-z0-9_]{0,31}$",
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "CalcSource",
      "type": "object"
    },
    "CalcStep": {
      "additionalProperties": false,
      "properties": {
        "args": {
          "items": {
            "pattern": "^(?!(?:constructor|prototype|valueof|tostring|hasownproperty)$)[a-z][a-z0-9_]{0,31}$",
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Args",
          "type": "array"
        },
        "date_unit": {
          "enum": [
            "days",
            "months",
            "years"
          ],
          "title": "Date Unit",
          "type": "string"
        },
        "id": {
          "pattern": "^(?!(?:constructor|prototype|valueof|tostring|hasownproperty)$)[a-z][a-z0-9_]{0,31}$",
          "title": "Id",
          "type": "string"
        },
        "inclusive": {
          "title": "Inclusive",
          "type": "boolean"
        },
        "label": {
          "pattern": "^[A-Za-z0-9\\u00C0-\\u024F\\u0370-\\u03FF\\u0400-\\u04FF\\u3040-\\u30FF\\u3400-\\u4DBF\\u4E00-\\u9FFF\\uAC00-\\uD7AF$\\u00A2-\\u00A5\\u20A0-\\u20CF %/._\\u00B0\\-,:]{1,80}$",
          "title": "Label",
          "type": "string"
        },
        "op": {
          "enum": [
            "add",
            "subtract",
            "multiply",
            "divide",
            "min",
            "max",
            "sum",
            "cap_each",
            "percentage",
            "round",
            "date_diff"
          ],
          "title": "Op",
          "type": "string"
        },
        "rounding": {
          "$ref": "#/$defs/CalcRounding"
        }
      },
      "required": [
        "id",
        "op",
        "args"
      ],
      "title": "CalcStep",
      "type": "object"
    },
    "CalcStepResult": {
      "additionalProperties": false,
      "properties": {
        "display": {
          "pattern": "^-?[0-9]{1,30}(\\.[0-9]{1,30})?$",
          "title": "Display",
          "type": "string"
        },
        "display_rounded": {
          "default": false,
          "title": "Display Rounded",
          "type": "boolean"
        },
        "exact": {
          "pattern": "^-?[0-9]+/[0-9]+$",
          "title": "Exact",
          "type": "string"
        },
        "id": {
          "pattern": "^(?!(?:constructor|prototype|valueof|tostring|hasownproperty)$)[a-z][a-z0-9_]{0,31}$",
          "title": "Id",
          "type": "string"
        },
        "inputs": {
          "items": {
            "pattern": "^(-?[0-9]{1,30}(\\.[0-9]{1,30})?|[0-9]{4}-[0-9]{2}-[0-9]{2}|-?[0-9]+/[0-9]+)$",
            "type": "string"
          },
          "title": "Inputs",
          "type": "array"
        },
        "op": {
          "enum": [
            "add",
            "subtract",
            "multiply",
            "divide",
            "min",
            "max",
            "sum",
            "cap_each",
            "percentage",
            "round",
            "date_diff"
          ],
          "title": "Op",
          "type": "string"
        }
      },
      "required": [
        "id",
        "op",
        "exact",
        "display"
      ],
      "title": "CalcStepResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "anchor_offset": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Anchor Offset"
    },
    "origin": {
      "enum": [
        "tool",
        "trailing_block"
      ],
      "title": "Origin",
      "type": "string"
    },
    "request": {
      "$ref": "#/$defs/CalcRequest"
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/CalcResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "origin",
    "request"
  ],
  "title": "CalcTrace",
  "type": "object"
}
