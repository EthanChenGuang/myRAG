{
  "$defs": {
    "BlockedRange": {
      "additionalProperties": false,
      "description": "Offsets are UTF-16 code units into text part `part`, valid only while its hash matches.",
      "properties": {
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "part": {
          "minimum": 0,
          "title": "Part",
          "type": "integer"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "text_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Text Hash",
          "type": "string"
        }
      },
      "required": [
        "part",
        "start",
        "end",
        "text_hash"
      ],
      "title": "BlockedRange",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "blocked_ranges": {
      "items": {
        "$ref": "#/$defs/BlockedRange"
      },
      "title": "Blocked Ranges",
      "type": "array"
    },
    "credential_blocked": {
      "default": 0,
      "minimum": 0,
      "title": "Credential Blocked",
      "type": "integer"
    },
    "credential_warned": {
      "default": 0,
      "minimum": 0,
      "title": "Credential Warned",
      "type": "integer"
    },
    "event_ids": {
      "items": {
        "type": "string"
      },
      "title": "Event Ids",
      "type": "array"
    },
    "links_checked": {
      "default": 0,
      "minimum": 0,
      "title": "Links Checked",
      "type": "integer"
    },
    "links_removed": {
      "default": 0,
      "minimum": 0,
      "title": "Links Removed",
      "type": "integer"
    },
    "mode": {
      "enum": [
        "flag",
        "enforce"
      ],
      "title": "Mode",
      "type": "string"
    },
    "rule_ids": {
      "items": {
        "type": "string"
      },
      "title": "Rule Ids",
      "type": "array"
    },
    "rules_version": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Rules Version",
      "type": "string"
    },
    "source_chunk_ids": {
      "items": {
        "type": "string"
      },
      "title": "Source Chunk Ids",
      "type": "array"
    }
  },
  "required": [
    "mode",
    "rules_version"
  ],
  "title": "OutputGuardSummary",
  "type": "object"
}
