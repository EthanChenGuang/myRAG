{
  "$defs": {
    "BaselineMetricStat": {
      "additionalProperties": false,
      "properties": {
        "mean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mean"
        },
        "n": {
          "minimum": 0,
          "title": "N",
          "type": "integer"
        },
        "runs": {
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Runs",
          "type": "array"
        },
        "spread": {
          "minimum": 0,
          "title": "Spread",
          "type": "number"
        }
      },
      "required": [
        "mean",
        "spread",
        "runs",
        "n"
      ],
      "title": "BaselineMetricStat",
      "type": "object"
    },
    "BaselineRun": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "git_sha": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Git Sha"
        },
        "run_config_hash": {
          "title": "Run Config Hash",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "run_config_hash",
        "created_at"
      ],
      "title": "BaselineRun",
      "type": "object"
    },
    "GoldenFilter": {
      "additionalProperties": false,
      "properties": {
        "gate_split": {
          "const": "dev",
          "title": "Gate Split",
          "type": "string"
        },
        "review_statuses": {
          "items": {
            "enum": [
              "approved",
              "draft"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Review Statuses",
          "type": "array"
        }
      },
      "required": [
        "review_statuses",
        "gate_split"
      ],
      "title": "GoldenFilter",
      "type": "object"
    },
    "RagRunOptions": {
      "additionalProperties": false,
      "properties": {
        "generator_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generator Model"
        },
        "max_results": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Results"
        },
        "organization_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Organization Id"
        },
        "user_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User Id"
        }
      },
      "title": "RagRunOptions",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "corpus_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Corpus Sha256"
    },
    "deployment_mode": {
      "title": "Deployment Mode",
      "type": "string"
    },
    "embedder_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Embedder Id"
    },
    "embedder_source_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Embedder Source Sha256"
    },
    "embedder_version": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Embedder Version"
    },
    "golden_filter": {
      "$ref": "#/$defs/GoldenFilter"
    },
    "golden_sha256": {
      "title": "Golden Sha256",
      "type": "string"
    },
    "items": {
      "anyOf": [
        {
          "additionalProperties": {
            "additionalProperties": {
              "items": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "array"
            },
            "type": "object"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Items"
    },
    "request_options": {
      "$ref": "#/$defs/RagRunOptions"
    },
    "run_config_hash": {
      "title": "Run Config Hash",
      "type": "string"
    },
    "runs": {
      "items": {
        "$ref": "#/$defs/BaselineRun"
      },
      "minItems": 3,
      "title": "Runs",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "slices": {
      "additionalProperties": {
        "additionalProperties": {
          "$ref": "#/$defs/BaselineMetricStat"
        },
        "type": "object"
      },
      "title": "Slices",
      "type": "object"
    },
    "spread_kind": {
      "const": "stdev_ddof1",
      "title": "Spread Kind",
      "type": "string"
    },
    "tier": {
      "enum": [
        "smoke",
        "nightly",
        "live"
      ],
      "title": "Tier",
      "type": "string"
    }
  },
  "required": [
    "spread_kind",
    "tier",
    "deployment_mode",
    "request_options",
    "golden_sha256",
    "golden_filter",
    "run_config_hash",
    "runs",
    "slices"
  ],
  "title": "Baseline",
  "type": "object"
}
