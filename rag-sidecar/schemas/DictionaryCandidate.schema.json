{
  "additionalProperties": false,
  "description": "D-17 hand-off to Phase 4.1.1 (TERM-12): canonical_language is the target language of a translation.",
  "properties": {
    "canonical_language": {
      "anyOf": [
        {
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Target language of canonical_term; required when relation is translation.",
      "title": "Canonical Language"
    },
    "canonical_term": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Canonical Term",
      "type": "string"
    },
    "example_review_item_ids": {
      "items": {
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Example Review Item Ids",
      "type": "array",
      "uniqueItems": true
    },
    "language": {
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})?$",
      "title": "Language",
      "type": "string"
    },
    "observed_term": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Observed Term",
      "type": "string"
    },
    "occurrences": {
      "minimum": 1,
      "title": "Occurrences",
      "type": "integer"
    },
    "relation": {
      "enum": [
        "synonym",
        "abbreviation",
        "translation",
        "misspelling"
      ],
      "title": "Relation",
      "type": "string"
    },
    "tenant_key": {
      "pattern": "^(s:default|[uo]:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$",
      "title": "Tenant Key",
      "type": "string"
    }
  },
  "required": [
    "tenant_key",
    "language",
    "observed_term",
    "canonical_term",
    "relation",
    "example_review_item_ids",
    "occurrences"
  ],
  "title": "DictionaryCandidate",
  "type": "object"
}
