{
  "$defs": {
    "BoilerplateRule": {
      "additionalProperties": false,
      "description": "Kind `line` removes lines a pattern matches; kind `fragment` removes short fragments repeated across pages.",
      "properties": {
        "doc_type": {
          "enum": [
            "general",
            "financial_report",
            "contract_legal",
            "invoice_receipt",
            "product_technical",
            "scanned_image"
          ],
          "title": "Doc Type",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "flags": {
          "enum": [
            "u",
            "iu"
          ],
          "title": "Flags",
          "type": "string"
        },
        "kind": {
          "enum": [
            "line",
            "fragment"
          ],
          "title": "Kind",
          "type": "string"
        },
        "max_length": {
          "maximum": 200,
          "minimum": 1,
          "title": "Max Length",
          "type": "integer"
        },
        "min_page_share": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Min Page Share",
          "type": "number"
        },
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "pattern": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Pattern",
          "type": "string"
        },
        "source": {
          "pattern": "^[a-z0-9][a-z0-9_.:-]{0,63}$",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "name",
        "kind"
      ],
      "title": "BoilerplateRule",
      "type": "object"
    },
    "HeadingPattern": {
      "additionalProperties": false,
      "properties": {
        "flags": {
          "default": "u",
          "enum": [
            "u",
            "iu"
          ],
          "title": "Flags",
          "type": "string"
        },
        "level": {
          "maximum": 6,
          "minimum": 1,
          "title": "Level",
          "type": "integer"
        },
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "pattern": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Pattern",
          "type": "string"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "restart": {
          "default": false,
          "title": "Restart",
          "type": "boolean"
        }
      },
      "required": [
        "pattern",
        "name",
        "level"
      ],
      "title": "HeadingPattern",
      "type": "object"
    },
    "SectionRuleSet": {
      "additionalProperties": false,
      "description": "Tenant rule set body; the binding `(doc_type | null, source | null)` follows D-18.",
      "properties": {
        "doc_type": {
          "enum": [
            "general",
            "financial_report",
            "contract_legal",
            "invoice_receipt",
            "product_technical",
            "scanned_image"
          ],
          "title": "Doc Type",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "headings": {
          "items": {
            "$ref": "#/$defs/HeadingPattern"
          },
          "maxItems": 60,
          "minItems": 1,
          "title": "Headings",
          "type": "array"
        },
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "require_increasing_numbers": {
          "default": false,
          "title": "Require Increasing Numbers",
          "type": "boolean"
        },
        "skip_toc": {
          "default": true,
          "title": "Skip Toc",
          "type": "boolean"
        },
        "source": {
          "pattern": "^[a-z0-9][a-z0-9_.:-]{0,63}$",
          "title": "Source",
          "type": "string"
        },
        "toc_min_run": {
          "default": 3,
          "maximum": 20,
          "minimum": 2,
          "title": "Toc Min Run",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "headings"
      ],
      "title": "SectionRuleSet",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "boilerplate_rules": {
      "items": {
        "$ref": "#/$defs/BoilerplateRule"
      },
      "maxItems": 40,
      "title": "Boilerplate Rules",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "section_rule_sets": {
      "items": {
        "$ref": "#/$defs/SectionRuleSet"
      },
      "maxItems": 10,
      "title": "Section Rule Sets",
      "type": "array"
    }
  },
  "title": "TenantRulesFile",
  "type": "object"
}
