{
  "$defs": {
    "UploadApproval": {
      "additionalProperties": false,
      "description": "Decision of the upload approval gate in `submitIngest()` (D-36, D-37).",
      "properties": {
        "decided_at": {
          "format": "date-time",
          "title": "Decided At",
          "type": "string"
        },
        "mode": {
          "enum": [
            "off",
            "members",
            "all"
          ],
          "title": "Mode",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "member_upload",
                "all_uploads",
                "admin_upload",
                "personal_workspace",
                "exempt_connector",
                "exempt_uploader",
                "unknown_uploader"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "uploader_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uploader Id"
        }
      },
      "required": [
        "mode",
        "required",
        "decided_at"
      ],
      "title": "UploadApproval",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Settings frozen on a ledger job at enqueue.\n\nThe Phase 3.2 fields default to today's behaviour and are written only when they differ from it. The model\nkeeps extra=\"forbid\", so an older sidecar rejects a snapshot carrying them: deploy the sidecar first.",
  "properties": {
    "approval": {
      "anyOf": [
        {
          "$ref": "#/$defs/UploadApproval"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "carry_table_header": {
      "default": false,
