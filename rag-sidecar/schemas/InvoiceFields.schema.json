    "net_total": {
      "anyOf": [
        {
          "pattern": "^-?\\d+(\\.\\d{1,4})?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Net Total"
    },
    "supplier": {
