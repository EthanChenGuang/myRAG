            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quantity"
        },
        "tax_rate": {
          "anyOf": [
            {
              "pattern": "^-?\\d+(\\.\\d{1,4})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tax Rate"
        },
        "unit_price": {
          "anyOf": [
            {
              "pattern": "^-?\\d+(\\.\\d{1,4})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit Price"
        }
      },
      "required": [
        "description"
      ],
      "title": "InvoiceLineItem",
      "type": "object"
    },
    "InvoiceParty": {
      "additionalProperties": false,
