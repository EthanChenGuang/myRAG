          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "tax_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tax Id"
        },
        "tax_id_scheme": {
          "default": "unknown",
          "enum": [
            "it_iva",
            "cn_uscc",
            "eu_vat",
            "unknown"
          ],
          "title": "Tax Id Scheme",
          "type": "string"
        }
      },
      "title": "InvoiceParty",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
