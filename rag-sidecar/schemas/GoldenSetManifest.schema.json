{
  "$defs": {
    "GoldenSetChangelogEntry": {
      "additionalProperties": false,
      "properties": {
        "added": {
          "items": {
            "type": "string"
          },
          "title": "Added",
          "type": "array"
        },
        "changed": {
          "items": {
            "type": "string"
          },
          "title": "Changed",
          "type": "array"
        },
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "retired": {
          "items": {
            "type": "string"
          },
          "title": "Retired",
          "type": "array"
        },
        "stale": {
          "items": {
            "type": "string"
          },
          "title": "Stale",
          "type": "array"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "version",
        "date"
      ],
      "title": "GoldenSetChangelogEntry",
      "type": "object"
    },
    "GoldenSetManifestItem": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "title": "Id",
          "type": "string"
        },
        "item_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Item Sha256",
          "type": "string"
        },
        "last_reviewed_at": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Reviewed At"
        },
        "retire_reason": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9_]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retire Reason"
        },
        "stale_reason": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9_]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stale Reason"
        },
        "stale_since": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stale Since"
        },
        "status": {
          "default": "active",
          "enum": [
            "active",
            "stale",
            "retired"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "item_sha256"
      ],
      "title": "GoldenSetManifestItem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "changelog": {
      "items": {
        "$ref": "#/$defs/GoldenSetChangelogEntry"
      },
      "minItems": 1,
      "title": "Changelog",
      "type": "array"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/GoldenSetManifestItem"
      },
      "title": "Items",
      "type": "array"
    },
    "manifest_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "set_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Set Id",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "set_id",
    "version",
    "items",
    "changelog",
    "manifest_sha256"
  ],
  "title": "GoldenSetManifest",
  "type": "object"
}
