{
  "additionalProperties": false,
  "description": "One rule of eval/config/monitor-alerts.json. Which band fields a rule needs depends on its kind (D-24, D-44).",
  "properties": {
    "alert": {
      "minimum": 0,
      "title": "Alert",
      "type": "number"
    },
    "baseline_min_sample": {
      "minimum": 1,
      "title": "Baseline Min Sample",
      "type": "integer"
    },
    "budget_ratio": {
      "exclusiveMinimum": 0,
      "title": "Budget Ratio",
      "type": "number"
    },
    "drop": {
      "exclusiveMinimum": 0,
      "maximum": 1,
      "title": "Drop",
      "type": "number"
    },
    "enabled": {
      "default": true,
      "title": "Enabled",
      "type": "boolean"
    },
    "id": {
      "enum": [
        "refusal_rate",
        "zero_result_rate",
        "below_threshold_rate",
        "not_helpful_rate",
        "groundedness_flagged_rate",
        "kb_error_rate",
        "kb_degraded_rate",
        "kb_unavailable_rate",
        "top_score_psi",
        "latency_p95",
        "online_judge_mean",
        "test_set_not_representative",
        "offline_online_gap",
        "language_drop"
      ],
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "rate",
        "distribution",
        "latency",
        "judge_mean",
        "drift",
        "offline_online_gap",
        "language_drop"
      ],
      "title": "Kind",
      "type": "string"
    },
    "metric": {
      "pattern": "^[a-z0-9_]+$",
      "title": "Metric",
      "type": "string"
    },
    "min_abs_delta": {
      "maximum": 1,
      "minimum": 0,
      "title": "Min Abs Delta",
      "type": "number"
    },
    "min_sample": {
      "minimum": 1,
      "title": "Min Sample",
      "type": "integer"
    },
    "min_z": {
      "minimum": 0,
      "title": "Min Z",
      "type": "number"
    },
    "params": {
      "patternProperties": {
        "^[a-z0-9_]+$": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "pattern": "^[a-z0-9_]+$",
              "type": "string"
            },
            {
              "items": {
                "pattern": "^[a-z0-9_]+$",
                "type": "string"
              },
              "type": "array"
            }
          ]
        }
      },
      "title": "Params",
      "type": "object"
    },
    "ratio": {
      "exclusiveMinimum": 0,
      "title": "Ratio",
      "type": "number"
    },
    "warn": {
      "minimum": 0,
      "title": "Warn",
      "type": "number"
    }
  },
  "required": [
    "id",
    "kind",
    "min_sample"
  ],
  "title": "MonitorRule",
  "type": "object"
}
