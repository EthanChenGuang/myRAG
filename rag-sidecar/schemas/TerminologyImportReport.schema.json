{
  "$defs": {
    "TerminologyValidationIssue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "conflict",
            "chain",
            "cycle",
            "invalid_variant",
            "invalid_language",
            "invalid_translation",
            "limit",
            "duplicate",
            "override"
          ],
          "title": "Code",
          "type": "string"
        },
        "entry_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Entry Ids",
          "type": "array"
        },
        "message": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "row": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row"
        },
        "severity": {
          "enum": [
            "error",
            "warning"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "title": "TerminologyValidationIssue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "applied": {
      "title": "Applied",
      "type": "boolean"
    },
    "create": {
      "minimum": 0,
      "title": "Create",
      "type": "integer"
    },
    "delete": {
      "minimum": 0,
      "title": "Delete",
      "type": "integer"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/TerminologyValidationIssue"
      },
      "title": "Issues",
      "type": "array"
    },
    "layer_version_seen": {
      "minimum": 0,
      "title": "Layer Version Seen",
      "type": "integer"
    },
    "unchanged": {
      "minimum": 0,
      "title": "Unchanged",
      "type": "integer"
    },
    "update": {
      "minimum": 0,
      "title": "Update",
      "type": "integer"
    }
  },
  "required": [
    "create",
    "update",
    "unchanged",
    "delete",
    "issues",
    "layer_version_seen",
    "applied"
  ],
  "title": "TerminologyImportReport",
  "type": "object"
}
